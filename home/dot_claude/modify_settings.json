{{- /* chezmoi:modify-template */ -}}

{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "claude-code") .) | fromJson -}}

{{- $env := dict
  "CLAUDE_CODE_ATTRIBUTION_HEADER" "0"
  "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS" "1"
  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" "1"
-}}

{{- /* CC has one active endpoint, not a provider registry. A qualified
       model selects it. A bare model uses iv-cc when that alias resolved,
       and native login otherwise. Never choose an endpoint by map order. */ -}}
{{- $provider := $cfg.model_provider -}}
{{- if and (not $provider) (hasKey $cfg.providers "iv-cc") -}}
  {{- $provider = "iv-cc" -}}
{{- end -}}
{{- if $provider -}}
  {{- $ep := index $cfg.providers $provider -}}
  {{- if ne $ep.type "anthropic-messages" -}}{{- fail "claude-code requires an Anthropic Messages provider" -}}{{- end -}}
  {{- if $ep.base_url -}}{{- $_ := set $env "ANTHROPIC_BASE_URL" $ep.base_url -}}{{- end -}}
  {{- if $ep.auth_key -}}{{- $_ := set $env "ANTHROPIC_AUTH_TOKEN" $ep.auth_key -}}{{- end -}}
{{- end -}}

{{- /* Map each default_models alias → ANTHROPIC_DEFAULT_<ALIAS>_MODEL.
       These name the opus/sonnet/haiku ids. The selected provider does
       not decide whether they are set. */ -}}
{{- if hasKey $cfg "default_models" -}}
  {{- range $alias, $model := $cfg.default_models -}}
    {{- $_ := set $env (printf "ANTHROPIC_DEFAULT_%s_MODEL" (upper $alias)) $model -}}
  {{- end -}}
{{- end -}}

{{- $enabledPlugins := includeTemplate "plugins/enabled-map" (merge (dict "tool" "claude-code") .) | fromJson -}}

{{- $githubMarketplaces := dict
  "anthropic-agent-skills" "anthropics/skills"
  "mattpocock" "mattpocock/skills"
  "openai-codex" "openai/codex-plugin-cc"
-}}
{{- $extraKnownMarketplaces := dict -}}
{{- range $name, $repo := $githubMarketplaces -}}
  {{- $_ := set $extraKnownMarketplaces $name (dict
    "source" (dict "source" "github" "repo" $repo)
  ) -}}
{{- end -}}

{{- $permissions := dict
    "defaultMode" "auto"
-}}

{{- $rtk := includeTemplate "tool/enabled" (merge (dict "tool" "rtk") .) | fromJson -}}
{{- $hooks := dict
  "PreToolUse" (list (dict
    "matcher" "Bash"
    "hooks" (list (dict
      "type" "command"
      "command" "rtk hook claude"
    ))
  ))
-}}

{{- $statusLine := dict
    "type" "command"
	"command" (joinPath .chezmoi.homeDir ".claude" "statusline.sh")
-}}

{{- /* opusplan is Claude Code's client switch when the alias defaults
       exist: plan reads ANTHROPIC_DEFAULT_OPUS_MODEL, execution reads the
       sonnet default. It is not an upstream model id. */ -}}
{{- $model := $cfg.model_id -}}
{{- if hasKey $cfg "default_models" -}}{{- $model = "opusplan" -}}{{- end -}}
{{- $managed := dict
  "effortLevel" "medium"
  "enabledPlugins" $enabledPlugins
  "env" $env
  "extraKnownMarketplaces" $extraKnownMarketplaces
  "model" $model
  "permissions" $permissions
  "skipAutoPermissionPrompt" true
  "statusLine" $statusLine
-}}
{{- $remove := list -}}
{{- /* Drop stale routing keys when returning to native login. Keep unrelated
       user environment values in the modify file. */ -}}
{{- range $key := list "ANTHROPIC_BASE_URL" "ANTHROPIC_AUTH_TOKEN" "ANTHROPIC_DEFAULT_OPUS_MODEL" "ANTHROPIC_DEFAULT_SONNET_MODEL" "ANTHROPIC_DEFAULT_HAIKU_MODEL" "ANTHROPIC_DEFAULT_FABLE_MODEL" -}}
  {{- if not (hasKey $env $key) -}}{{- $remove = append $remove (printf "env.%s" $key) -}}{{- end -}}
{{- end -}}
{{- if $rtk -}}
  {{- $_ := set $managed "hooks" $hooks -}}
{{- else -}}
  {{- $remove = append $remove "hooks" -}}
{{- end -}}
{{- includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" $managed
  "remove" $remove
) -}}
