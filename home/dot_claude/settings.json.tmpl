{{- $pass := ternary "Work/IV/LLM" "" (eq .host_env "iv") -}}
{{- $fields := passFields $pass -}}

{{- $env := dict
  "CLAUDE_CODE_ATTRIBUTION_HEADER" "0"
  "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS" "1"
  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" "1"
-}}

{{- if eq .host_env "iv" -}}
  {{- $_ := set $env "ANTHROPIC_DEFAULT_OPUS_MODEL" "claude-opus-4-6" -}}
  {{- $_ := set $env "ANTHROPIC_DEFAULT_SONNET_MODEL" "claude-sonnet-4-6" -}}
  {{- $_ := set $env "ANTHROPIC_DEFAULT_HAIKU_MODEL" "claude-haiku-4-5-20251001" -}}
{{- end -}}

{{- range $k, $v := dict
  "ANTHROPIC_AUTH_TOKEN" (index $fields "cc-auth-token")
  "ANTHROPIC_BASE_URL" (index $fields "url")
-}}
  {{- if $v }}
    {{- $_ := set $env $k $v -}}
  {{ end -}}
{{- end -}}

{{- $enabledPlugins := dict
  "kotlin-lsp@claude-plugins-official" true
  "skill-creator@claude-plugins-official" true
  "superpowers@claude-plugins-official" true
-}}

{{- $extraKnownMarketplaces := dict
  "anthropic-agent-skills" (dict
    "source" (dict
      "source" "github"
      "repo" "anthropics/skills"
    )
  )
-}}

{{- $statusLine := dict
    "type" "command"
	"command" (joinPath .chezmoi.homeDir ".claude" "statusline.sh")
-}}

{{- dict
  "enabledPlugins" $enabledPlugins
  "env" $env
  "extraKnownMarketplaces" $extraKnownMarketplaces
  "model" "opusplan"
  "statusLine" $statusLine
  | toPrettyJson
-}}
