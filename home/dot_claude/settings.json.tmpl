{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "claude-code") .) | fromJson -}}

{{- $env := dict
  "CLAUDE_CODE_ATTRIBUTION_HEADER" "0"
  "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS" "1"
  "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" "1"
-}}

{{- $anthropicResolved := false -}}
{{- range $_, $ep := $cfg.providers }}
  {{- if eq $ep.type "anthropic" }}{{- $anthropicResolved = true -}}{{- end }}
  {{- if $ep.base_url }}
    {{- $_ := set $env "ANTHROPIC_BASE_URL" (printf "%s/v1" $ep.base_url) -}}
  {{- end }}
  {{- if $ep.auth_key }}
    {{- $_ := set $env "ANTHROPIC_AUTH_TOKEN" $ep.auth_key -}}
  {{- end }}
{{- end -}}

{{- /* Map each default_models alias → ANTHROPIC_DEFAULT_<ALIAS>_MODEL
       (opus, sonnet, haiku, fable, …). Only when an anthropic provider resolved. */ -}}
{{- if and $anthropicResolved (hasKey $cfg "default_models") -}}
  {{- range $alias, $model := $cfg.default_models -}}
    {{- $_ := set $env (printf "ANTHROPIC_DEFAULT_%s_MODEL" (upper $alias)) $model -}}
  {{- end -}}
{{- end -}}

{{- $enabledPlugins := dict
  "chrome-devtools-mcp@claude-plugins-official" true
  "codex@openai-codex" true
  "kotlin-lsp@claude-plugins-official" true
  "mattpocock-skills@mattpocock" true
  "skill-creator@claude-plugins-official" true
  "superpowers@claude-plugins-official" false
-}}

{{- $githubMarketplaces := dict
  "anthropic-agent-skills" "anthropics/skills"
  "mattpocock" "mattpocock/skills"
  "openai-codex" "openai/codex-plugin-cc"
-}}
{{- $extraKnownMarketplaces := dict -}}
{{- range $name, $repo := $githubMarketplaces -}}
  {{- $_ := set $extraKnownMarketplaces $name (dict
    "source" (dict "source" "github" "repo" $repo)
  ) -}}
{{- end -}}

{{- $permissions := dict
    "defaultMode" "auto"
-}}

{{- $statusLine := dict
    "type" "command"
	"command" (joinPath .chezmoi.homeDir ".claude" "statusline.sh")
-}}

{{- dict
  "effortLevel" "medium"
  "enabledPlugins" $enabledPlugins
  "env" $env
  "extraKnownMarketplaces" $extraKnownMarketplaces
  "model" $cfg.model
  "permissions" $permissions
  "skipAutoPermissionPrompt" true
  "statusLine" $statusLine
  | toPrettyJson
-}}
