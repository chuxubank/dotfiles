{{- /* chezmoi:modify-template */ -}}

{{- /* https://luvus.dev/docs/reference/cli/
       Luvus rewrites config.json itself: `theme use`, `ui sidebar/dock`, and
       `bar move` persist live UI state (sidebars, docks, bars, version) here.
       A modify-template so that state survives apply and only the choices
       this repo owns are pinned.

       `theme_follow` switches packed themes with the host appearance, the
       Luvus form of Herdr's auto_switch. `theme` stays `terminal`: that is
       the manual theme, and the fallback when follow is off or the packed
       theme is missing, so chrome uses the host palette instead of a packed
       default.
       `layout.file_open` is the FILES tab editor, aligned with EDITOR.
       check_updates is off because the fork release in
       home/bin/.chezmoiexternal.toml.tmpl owns the binary.

       Worktree operations use the production asahiart.worktrunk provider.
       Its module policy settings remain unmanaged until an authoritative
       production settings file exists.

       direct_keybindings mirrors Herdr's `alt+1..9` workspace switching
       (dot_config/herdr/config.toml) because Herdr, Zellij, and Luvus are one
       mux layer and never run together. Luvus's own default for these is
       `Prefix+Shift+1..9`; the direct form drops the prefix to match Herdr. */ -}}

{{- includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" (dict
    "theme" "terminal"
    "theme_follow" (dict
      "auto_switch" true
      "dark" "gruvbox"
      "light" "gruvbox-light"
    )
    "prefix" "ctrl+;"
    "check_updates" false
    "worktree" (dict
      "provider" "asahiart.worktrunk"
    )
    "direct_keybindings" (dict
      "jump_workspace_1" "alt+1"
      "jump_workspace_2" "alt+2"
      "jump_workspace_3" "alt+3"
      "jump_workspace_4" "alt+4"
      "jump_workspace_5" "alt+5"
      "jump_workspace_6" "alt+6"
      "jump_workspace_7" "alt+7"
      "jump_workspace_8" "alt+8"
      "jump_workspace_9" "alt+9"
    )
    "layout" (dict
      "agent_title" true
      "diff_provider" "difftastic"
      "files_show_hidden" true
      "file_open" "emacsclient -a=\"\""
      "workspace_paths" false
    )
    "notifications" (dict
      "sound_on_blocked" true
    )
    "sidebars" (dict
      "left" (dict
        "docks" (list "workspaces" "agents")
      )
      "right" (dict
        "docks" (list "files")
        "visible" true
      )
    )
  )
) -}}
