{{- /* chezmoi:modify-template */ -}}

{{- /* https://luvus.dev/docs/reference/cli/
       Luvus rewrites config.json itself: `theme use`, `ui sidebar/dock`, and
       `bar move` persist live UI state (sidebars, docks, bars, version) here.
       A modify-template so that state survives apply and only the choices
       this repo owns are pinned.

       Luvus has no theme auto_switch (unlike Herdr). Pin `terminal` so
       chrome follows the host terminal palette instead of a packed theme.
       check_updates is off because Homebrew owns the binary
       (RizRiyz/luvus/luvus in packages/brew/brews.toml). */ -}}

{{- includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" (dict
    "theme" "terminal"
    "prefix" "ctrl+;"
    "check_updates" false
    "layout" (dict
      "agent_title" true
      "files_show_hidden" true
    )
    "notifications" (dict
      "sound_on_blocked" true
    )
    "sidebars" (dict
      "left" (dict
        "docks" (list "workspaces" "agents")
      )
      "right" (dict
        "docks" (list "files")
        "visible" true
      )
    )
  )
) -}}
