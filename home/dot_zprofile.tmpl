export LC_ALL=en_US.UTF-8

{{- $brewBin := lookPath "brew" }}

{{- if eq .chezmoi.os "darwin" }}
# Kiro CLI pre block. Keep at the top of this file.
source_if -n -t 0.02 "${HOME}/Library/Application Support/kiro-cli/shell/zprofile.pre.zsh"

{{ if lookPath "orb" -}}
# Added by OrbStack: command-line tools and integration
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
{{- end }}

{{- end }}

{{- if $brewBin }}

# Set PATH, MANPATH, etc., for Homebrew.
eval "$({{ $brewBin }} shellenv)"
{{- if has .host_env (list "personal" "iv") }}
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.ustc.edu.cn/homebrew-core.git"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
export HOMEBREW_NO_REQUIRE_TAP_TRUST=1
{{- end }}

export LIBRARY_PATH=$LIBRARY_PATH:{{ joinPath .path.usr "lib" }}

# ssh
export SSH_ASKPASS="$(brew --prefix ssh-askpass)/bin/ssh-askpass"
export SSH_AUTH_SOCK="$HOME/.gnupg/S.gpg-agent.ssh"
{{- end }}

{{- if eq .chezmoi.os "darwin" }}

# Kiro CLI post block. Keep at the bottom of this file.
source_if -n -t 0.02 "${HOME}/Library/Application Support/kiro-cli/shell/zprofile.post.zsh"
{{- end }}

export SUDO_ASKPASS="$SSH_ASKPASS"

# PATH
{{- if eq .chezmoi.os "darwin" }}
export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
{{- end }}

if [ -d "$ANDROID_HOME/build-tools" ]; then
  export ANDROID_BUILD_TOOLS_VERSION=$(ls -1 "$ANDROID_HOME/build-tools" | sort -V | tail -n 1)
  export PATH="$ANDROID_HOME/build-tools/$ANDROID_BUILD_TOOLS_VERSION:$PATH"
fi
if [ -d "$ANDROID_HOME/platform-tools" ]; then
  export PATH="$ANDROID_HOME/platform-tools:$PATH"
fi
if [ -d "$ANDROID_HOME/cmdline-tools/latest" ]; then
  export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"
fi

export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="$GOBIN:$PATH"
export PATH="$plum_dir:$PATH"
export PATH="$HOME/{{ .path.tool.raycast }}/scripts:$PATH"
export PATH="$CARGO_HOME/bin:$PATH"
export PATH="$VCPKG_ROOT:$PATH"

{{- if $brewBin }}
export PATH="$(brew --prefix awk)/bin:$PATH"
export PATH="$(brew --prefix bind)/bin:$PATH"
export PATH="$(brew --prefix bison)/bin:$PATH"
export PATH="$(brew --prefix curl)/bin:$PATH"
export PATH="$(brew --prefix grep)/libexec/gunbin:$PATH"
export PATH="$(brew --prefix python)/libexec/bin:$PATH"
export PATH="$(brew --prefix ruby)/bin:$PATH"
export PATH="$(gem env gemdir)/bin:$PATH"
export PATH="$(brew --prefix rustup)/bin:$PATH"
export PATH="$(brew --prefix sqlite)/bin:$PATH"
{{- end }}

source_if "$SDKMAN_DIR/bin/sdkman-init.sh"

# Prefer user-managed executables over package-manager versions.
export PATH="$HOME/bin:${XDG_BIN_HOME:-$HOME/.local/bin}:$PATH"
typeset -U path PATH
