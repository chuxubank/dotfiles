# Unified source helper. Composes existence check, session guard, and timeout.
# Usage: source_if [-n] [-t seconds] <file>
#   -n          skip in Emacs / SSH sessions
#   -t seconds  hard timeout: interrupt and print if sourcing takes too long
function source_if {
    local _n_flag=() _t_opt=()
    zparseopts -D -E n=_n_flag t:=_t_opt

    local _file="$1"
    [[ -f "$_file" ]] || return 0
    (( ${#_n_flag} )) && { [[ -z "$INSIDE_EMACS" ]] && [[ -z "$SSH_CONNECTION" ]] || return 0 }

    if (( ${#_t_opt} )); then
        local _threshold=${_t_opt[-1]}
        local _timed_out=0 _ppid=$$
        local _orig_trap
        _orig_trap=$(trap -p INT 2>/dev/null)
        trap '(( _timed_out = 1 ))' INT
        ( sleep "$_threshold" && kill -INT "$_ppid" ) &
        local _timer_pid=$!
        builtin source "$_file"
        kill "$_timer_pid" 2>/dev/null
        wait "$_timer_pid" 2>/dev/null
        if [[ -n "$_orig_trap" ]]; then eval "$_orig_trap"; else trap - INT; fi
        (( _timed_out )) && print -P "%F{yellow}[zsh] source timed out: $_file (>${_threshold}s), skipped%f" >&2
    else
        builtin source "$_file"
    fi
}

export EMAIL={{ .email | quote }}
export DEVICE_TYPE={{ .device_type | quote }}
export HOST_ENV={{ .host_env | quote }}
export HOST_ROLES=({{ join " " .roles }})

# XDG
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

# Bin
export PATH=$HOME/bin:$PATH
export PATH=$HOME/.local/bin:$PATH
export PATH={{ joinPath .path.usr "bin" }}:$PATH

# Android
export ANDROID_HOME=$HOME/Library/Android/sdk
export ANDROID_SDK_ROOT=$ANDROID_HOME
if [ -d "$ANDROID_HOME/build-tools" ]; then
  export ANDROID_BUILD_TOOLS_VERSION=$(ls -1 "$ANDROID_HOME/build-tools" | sort -V | tail -n 1)
  export PATH="$ANDROID_HOME/build-tools/$ANDROID_BUILD_TOOLS_VERSION:$PATH"
fi
if [ -d "$ANDROID_HOME/platform-tools" ]; then
  export PATH="$ANDROID_HOME/platform-tools:$PATH"
fi
if [ -d "$ANDROID_HOME/cmdline-tools/latest" ]; then
  export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"
fi

{{- if ne .host_env "ci" }}
