# Unified source helper. Composes existence check, session guard, and timeout.
# Usage: source_if [-n] [-t seconds] <file>
#   -n          skip in Emacs / SSH sessions
#   -t seconds  warn if sourcing exceeds threshold in seconds
function source_if {
    local _n_flag=() _t_opt=()
    zparseopts -D -E n=_n_flag t:=_t_opt

    local _file="$1"
    [[ -f "$_file" ]] || return 0
    (( ${#_n_flag} )) && { [[ -z "$INSIDE_EMACS" ]] && [[ -z "$SSH_CONNECTION" ]] || return 0 }

    if (( ${#_t_opt} )); then
        local _threshold=${_t_opt[-1]}
        local _t0=$EPOCHREALTIME
        builtin source "$_file"
        local _elapsed=$(( EPOCHREALTIME - _t0 ))
        (( _elapsed > _threshold )) && \
            printf '\033[33m[source_if] slow: %s (%.2fs > %ss)\033[0m\n' "$_file" "$_elapsed" "$_threshold" >&2
    else
        builtin source "$_file"
    fi
}

