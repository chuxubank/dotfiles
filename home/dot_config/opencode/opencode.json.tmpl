{{- /* https://opencode.ai/docs/config/ */ -}}

{{- $mcpServers := includeTemplate "mcp/opencode" (merge (dict "tool" "opencode") .) | fromJson -}}
{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "opencode") .) | fromJson -}}

{{- $provider := dict -}}
{{- range $alias, $ep := $cfg.providers }}
  {{- $provDict := dict -}}
  {{- if $ep.base_url }}
    {{- $_ := set $provDict "options" (dict "baseURL" (printf "%s/v1" $ep.base_url)) -}}
  {{- end }}

  {{- /* Static models → use as-is; models: false → skip; otherwise fetch */ -}}
  {{- $models := dict -}}
  {{- if hasKey $ep "models" }}
    {{- if ne (kindOf $ep.models) "bool" }}
      {{- range $id, $name := $ep.models }}
        {{- $_ := set $models $id (dict "name" $name) -}}
      {{- end }}
    {{- end }}
  {{- else }}
    {{- $fetched := includeTemplate "llm/fetch-models" $ep | fromJson -}}
    {{- range $id, $name := $fetched }}
      {{- $_ := set $models $id (dict "name" $name) -}}
    {{- end }}
  {{- end }}
  {{- if gt (len $models) 0 }}
    {{- $_ := set $provDict "models" $models -}}
  {{- end }}

  {{- $_ := set $provider $alias $provDict -}}
{{- end }}

{{- /* Auto-discover free providers from models.dev */ -}}
{{- $md := output "sh" "-c" "curl -sfL --max-time 3 'https://models.dev/api.json' 2>/dev/null || echo '{}'" | trim | fromJson -}}
{{- range $pid, $p := $md -}}
  {{- if and (not (hasKey $provider $pid)) (hasKey $p "api") -}}
    {{- $api := $p.api -}}
    {{- if $api -}}
      {{- $dProv := dict "options" (dict "baseURL" $api) -}}
      {{- $dModels := dict -}}
      {{- range $mid, $m := $p.models -}}
        {{- $costOut := true -}}
        {{- if hasKey $m "cost" -}}
          {{- $cost := $m.cost -}}
          {{- if hasKey $cost "output" -}}
            {{- $costOut = $cost.output -}}
          {{- end -}}
        {{- end -}}
        {{- if not $costOut -}}
          {{- $_ := set $dModels $mid (dict "name" $mid) -}}
        {{- end -}}
      {{- end -}}
      {{- if gt (len $dModels) 0 -}}
        {{- $_ := set $dProv "models" $dModels -}}
        {{- $_ := set $provider $pid $dProv -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $config := dict
  "$schema" "https://opencode.ai/config.json"
  "autoupdate" true
  "formatter" true
  "lsp" true
  "mcp" $mcpServers
  "model" $cfg.model
  "provider" $provider
  "server" (dict "port" 4096)
  "small_model" $cfg.small_model
-}}
{{ $config | toPrettyJson }}
