{{- /* https://opencode.ai/docs/config/ */ -}}

{{- $mcpServers := includeTemplate "mcp/opencode" (merge (dict "tool" "opencode") .) | fromJson -}}
{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "opencode") .) | fromJson -}}

{{- $provider := dict -}}
{{- range $alias, $ep := $cfg.providers }}
  {{- $provDict := dict -}}
  {{- if $ep.base_url }}
    {{- $_ := set $provDict "options" (dict "baseURL" (printf "%s/v1" $ep.base_url)) -}}
  {{- end }}

  {{- /* Static models → use as-is; models: false → skip; otherwise fetch */ -}}
  {{- $models := dict -}}
  {{- $modelMetadata := dict -}}
  {{- if hasKey $ep "model_metadata" }}
    {{- $modelMetadata = $ep.model_metadata -}}
  {{- end }}
  {{- $modelFilter := dict -}}
  {{- if hasKey $ep "model_filter" }}
    {{- $modelFilter = $ep.model_filter -}}
  {{- end }}
  {{- if hasKey $ep "models" }}
    {{- if ne (kindOf $ep.models) "bool" }}
      {{- range $id, $name := $ep.models }}
        {{- $model := dict "name" $name -}}
        {{- if hasKey $modelMetadata $id -}}
          {{- $model = mergeOverwrite (deepCopy (index $modelMetadata $id)) $model -}}
        {{- end -}}
        {{- $model = includeTemplate "model-config/opencode" $model | fromJson -}}
        {{- $_ := set $models $id $model -}}
      {{- end }}
    {{- end }}
  {{- else }}
    {{- $fetched := includeTemplate "llm/fetch-models" $ep | fromJson -}}
    {{- range $id, $name := $fetched }}
      {{- $model := dict "name" $name -}}
      {{- if hasKey $modelMetadata $id -}}
        {{- $model = mergeOverwrite (deepCopy (index $modelMetadata $id)) $model -}}
      {{- end -}}
      {{- $model = includeTemplate "model-config/opencode" $model | fromJson -}}
      {{- $_ := set $models $id $model -}}
    {{- end }}
  {{- end }}
  {{- if and (gt (len $modelFilter) 0) (gt (len $modelMetadata) 0) -}}
    {{- $filteredMetadata := includeTemplate "llm/filter-models" (dict "models" $modelMetadata "filter" $modelFilter) | fromJson -}}
    {{- range $id, $_ := $models -}}
      {{- if not (hasKey $filteredMetadata $id) -}}
        {{- $_ := unset $models $id -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if gt (len $models) 0 }}
    {{- $_ := set $provDict "models" $models -}}
  {{- end }}

  {{- $_ := set $provider $alias $provDict -}}
{{- end }}

{{- $plugins := (list
  "superpowers@git+https://github.com/obra/superpowers.git"
) -}}

{{- $references := dict -}}
{{- range $name, $path := .path.personal }}
  {{- $_ := set $references $name (dict "path" (printf "~/%s" $path)) -}}
{{- end }}

{{- $config := dict
  "$schema" "https://opencode.ai/config.json"
  "autoupdate" true
  "formatter" true
  "lsp" true
  "mcp" $mcpServers
  "model" $cfg.model
  "plugin" $plugins
  "provider" $provider
  "references" $references
  "server" (dict "port" 4096)
  "small_model" $cfg.small_model
-}}
{{ $config | toPrettyJson }}
