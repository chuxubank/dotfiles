{{- /* chezmoi:modify-template */ -}}

{{- /* https://opencode.ai/docs/config/ */ -}}

{{- $mcpServers := includeTemplate "mcp/opencode" (merge (dict "tool" "opencode") .) | fromJson -}}
{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "opencode") .) | fromJson -}}

{{- $provider := dict -}}
{{- range $alias, $ep := $cfg.providers }}
  {{- $provDict := dict -}}
  {{- if $ep.base_url }}
    {{- $_ := set $provDict "options" (dict "baseURL" (printf "%s/v1" $ep.base_url)) -}}
  {{- end }}

  {{- /* Static models → use as-is; models: false → skip; otherwise fetch. */ -}}
  {{- $models := dict -}}
  {{- $modelMetadata := default dict (index $ep "model_metadata") -}}
  {{- $modelFilter := default dict (index $ep "model_filter") -}}
  {{- $source := dict -}}
  {{- if hasKey $ep "models" -}}
    {{- if ne (kindOf $ep.models) "bool" -}}{{- $source = $ep.models -}}{{- end -}}
  {{- else -}}
    {{- $source = includeTemplate "llm/fetch-models" $ep | fromJson -}}
  {{- end -}}
  {{- range $id, $name := $source -}}
    {{- $model := dict "name" $name -}}
    {{- if hasKey $modelMetadata $id -}}{{- $model = mergeOverwrite (deepCopy (index $modelMetadata $id)) $model -}}{{- end -}}
    {{- /* Inline OpenCode's single-consumer schema allowlist projection. */ -}}
    {{- $projected := dict -}}
    {{- range $key := list "id" "name" "family" "release_date" "attachment" "reasoning" "temperature" "tool_call" "interleaved" "cost" "limit" "modalities" "status" "provider" "options" "headers" "variants" -}}
      {{- if hasKey $model $key -}}{{- $_ := set $projected $key (index $model $key) -}}{{- end -}}
    {{- end -}}
    {{- if and (hasKey $model "experimental") (eq (kindOf $model.experimental) "bool") -}}
      {{- $_ := set $projected "experimental" $model.experimental -}}
    {{- end -}}
    {{- $_ := set $models $id $projected -}}
  {{- end -}}
  {{- if and (gt (len $modelFilter) 0) (gt (len $modelMetadata) 0) -}}
    {{- $filteredMetadata := includeTemplate "llm/filter-models" (dict "models" $modelMetadata "filter" $modelFilter) | fromJson -}}
    {{- range $id, $_ := $models -}}
      {{- if not (hasKey $filteredMetadata $id) -}}
        {{- $_ := unset $models $id -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if gt (len $models) 0 }}
    {{- $_ := set $provDict "models" $models -}}
  {{- end }}

  {{- $_ := set $provider $alias $provDict -}}
{{- end }}

{{- $plugins := includeTemplate "plugins/opencode" (merge (dict "tool" "opencode") .) | fromJson -}}

{{- $references := dict -}}
{{- range $name, $path := .path.personal }}
  {{- $_ := set $references $name (dict "path" (printf "~/%s" $path)) -}}
{{- end }}

{{- $managed := dict
  "$schema" "https://opencode.ai/config.json"
  "autoupdate" true
  "formatter" true
  "lsp" true
  "mcp" $mcpServers
  "model" $cfg.model
  "plugin" $plugins
  "provider" $provider
  "references" $references
  "server" (dict "port" 4096)
  "small_model" $cfg.small_model
-}}
{{- $replace := dict
  "mcp" $mcpServers
  "plugin" $plugins
  "provider" $provider
  "references" $references
-}}
{{ includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" $managed
  "replace" $replace
) }}
