{{- /* chezmoi:modify-template */ -}}

{{- /* https://opencode.ai/docs/config/ */ -}}

{{- $mcpServers := includeTemplate "mcp/opencode" (merge (dict "tool" "opencode") .) | fromJson -}}
{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "opencode") .) | fromJson -}}

{{- $provider := dict -}}
{{- $metadataMemo := dict -}}
{{- range $alias, $ep := $cfg.providers }}
  {{- $provDict := dict -}}
  {{- if $ep.base_url }}
    {{- $_ := set $provDict "options" (dict "baseURL" (printf "%s/v1" $ep.base_url)) -}}
  {{- end }}

  {{- /* Static models → use as-is; models: false → skip; otherwise fetch. */ -}}
  {{- $models := dict -}}
  {{- $modelMetadata := dict -}}
  {{- $reasoningMeta := dict -}}
  {{- if hasKey $ep "model_metadata_args" -}}
    {{- $metadataArgs := index $ep "model_metadata_args" -}}
    {{- if hasKey $metadataMemo $metadataArgs -}}
      {{- $modelMetadata = index $metadataMemo $metadataArgs -}}
    {{- else -}}
      {{- $modelMetadata = includeTemplate "llm/fetch-data-set" ($metadataArgs | fromJson) | fromJson -}}
      {{- $_ := set $metadataMemo $metadataArgs $modelMetadata -}}
    {{- end -}}
  {{- end -}}
  {{- $modelFilter := default dict (index $ep "model_filter") -}}
  {{- $source := dict -}}
  {{- if hasKey $ep "models" -}}
    {{- if ne (kindOf $ep.models) "bool" -}}{{- $source = $ep.models -}}{{- end -}}
  {{- else -}}
    {{- /* Metadata carries reasoning_options. small_model cannot include a
           #variant: OpenCode drops that string. The title agent then uses the
           first of none, minimal, and low from the variants written below. */ -}}
    {{- $detailed := includeTemplate "llm/fetch-models" (merge (dict "metadata" true) $ep) | fromJson -}}
    {{- if gt (len $detailed) 0 -}}
      {{- $reasoningMeta = $detailed -}}
      {{- $named := dict -}}
      {{- range $id, $meta := $detailed -}}
        {{- $display := $id -}}
        {{- if and (eq (kindOf $meta) "map") (hasKey $meta "name") -}}
          {{- $display = index $meta "name" | toString -}}
        {{- end -}}
        {{- $_ := set $named $id $display -}}
      {{- end -}}
      {{- $source = $named -}}
    {{- else -}}
      {{- $source = includeTemplate "llm/fetch-models" $ep | fromJson -}}
    {{- end -}}
  {{- end -}}
  {{- /* Declared models are an id list. fetch-models returns id → name.
         Dict keys must be strings, so a list index cannot be the id. */ -}}
  {{- if eq (kindOf $source) "slice" -}}
    {{- $mapped := dict -}}
    {{- range $item := $source -}}
      {{- if eq (kindOf $item) "string" -}}
        {{- $_ := set $mapped $item $item -}}
      {{- else if and (eq (kindOf $item) "map") (hasKey $item "id") -}}
        {{- $mid := index $item "id" | toString -}}
        {{- $mname := $mid -}}
        {{- if hasKey $item "name" -}}{{- $mname = index $item "name" | toString -}}{{- end -}}
        {{- $_ := set $mapped $mid $mname -}}
      {{- end -}}
    {{- end -}}
    {{- $source = $mapped -}}
  {{- end -}}
  {{- range $id, $name := $source -}}
    {{- $model := dict "name" $name -}}
    {{- if hasKey $modelMetadata $id -}}{{- $model = mergeOverwrite (deepCopy (index $modelMetadata $id)) $model -}}{{- end -}}
    {{- if not (hasKey $model "variants") -}}
      {{- $meta := $model -}}
      {{- if hasKey $reasoningMeta $id -}}{{- $meta = index $reasoningMeta $id -}}{{- end -}}
      {{- if eq (kindOf $meta) "map" -}}
        {{- $variants := dict -}}
        {{- range $option := default (list) (index $meta "reasoning_options") -}}
          {{- if and (eq (kindOf $option) "map") (eq (index $option "type") "effort") -}}
            {{- range $level := default (list) (index $option "values") -}}
              {{- if $level -}}
                {{- $_ := set $variants ($level | toString) (dict "reasoningEffort" ($level | toString)) -}}
              {{- end -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
        {{- if gt (len $variants) 0 -}}{{- $_ := set $model "variants" $variants -}}{{- end -}}
      {{- end -}}
    {{- end -}}
    {{- /* Inline OpenCode's single-consumer schema allowlist projection. */ -}}
    {{- $projected := dict -}}
    {{- range $key := list "id" "name" "family" "release_date" "attachment" "reasoning" "temperature" "tool_call" "interleaved" "cost" "limit" "modalities" "status" "provider" "options" "headers" "variants" -}}
      {{- if hasKey $model $key -}}{{- $_ := set $projected $key (index $model $key) -}}{{- end -}}
    {{- end -}}
    {{- if and (hasKey $model "experimental") (eq (kindOf $model.experimental) "bool") -}}
      {{- $_ := set $projected "experimental" $model.experimental -}}
    {{- end -}}
    {{- $_ := set $models $id $projected -}}
  {{- end -}}
  {{- if and (gt (len $modelFilter) 0) (gt (len $modelMetadata) 0) -}}
    {{- $filteredMetadata := includeTemplate "llm/filter-models" (dict "models" $modelMetadata "filter" $modelFilter) | fromJson -}}
    {{- range $id, $_ := $models -}}
      {{- if not (hasKey $filteredMetadata $id) -}}
        {{- $_ := unset $models $id -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if gt (len $models) 0 }}
    {{- $_ := set $provDict "models" $models -}}
  {{- end }}

  {{- $_ := set $provider $alias $provDict -}}
{{- end }}

{{- $plugins := includeTemplate "plugins/opencode" (merge (dict "tool" "opencode") .) | fromJson -}}

{{- $references := dict -}}
{{- range $name, $path := .path.personal }}
  {{- $_ := set $references $name (dict "path" (printf "~/%s" $path)) -}}
{{- end }}

{{- $managed := dict
  "$schema" "https://opencode.ai/config.json"
  "autoupdate" true
  "formatter" true
  "lsp" true
  "mcp" $mcpServers
  "model" $cfg.model
  "plugin" $plugins
  "provider" $provider
  "references" $references
  "server" (dict "port" 4096)
  "small_model" $cfg.small_model
-}}
{{- $replace := dict
  "mcp" $mcpServers
  "plugin" $plugins
  "provider" $provider
  "references" $references
-}}
{{ includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" $managed
  "replace" $replace
) }}
