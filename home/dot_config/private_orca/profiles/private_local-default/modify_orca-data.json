{{- /* chezmoi:modify-template */ -}}
{{- /* Merge portable settings/ui into Orca's live profile JSON.
       Repos, worktrees, sessions, and Orca-owned keys survive an apply. */ -}}
{{- $settings := dict
  "defaultTuiAgent" "pi"
  "agentDefaultArgs" (dict
    "aider" "--yes-always"
    "amp" "--dangerously-allow-all"
    "ante" "--yolo"
    "antigravity" "--dangerously-skip-permissions"
    "autohand" "--unrestricted"
    "claude" "--dangerously-skip-permissions"
    "claude-agent-teams" "--dangerously-skip-permissions"
    "cline" "--auto-approve true"
    "codex" "--yolo"
    "command-code" "--yolo"
    "continue" "--allow \"*\""
    "copilot" "--yolo"
    "crush" "--yolo"
    "cursor" "--yolo"
    "devin" "--permission-mode bypass"
    "gemini" "--yolo"
    "grok" "--permission-mode bypassPermissions"
    "hermes" "--yolo"
    "kimi" "--yolo"
    "kiro" "--trust-all-tools"
    "mistral-vibe" "--agent auto-approve"
    "openclaude" "--dangerously-skip-permissions"
    "qwen-code" "--approval-mode yolo"
    "rovo" "--yolo"
    "trae" "--yolo"
  )
  "agentDefaultEnv" (dict
    "goose" (dict "GOOSE_MODE" "auto")
  )
  "workspaceDir" (joinPath .chezmoi.homeDir "orca" "workspaces")
  "theme" "system"
  "nestWorkspaces" true
  "autoRenameBranchFromWork" true
  "branchPrefix" "git-username"
  "agentStatusHooksEnabled" true
  "keepComputerAwakeWhileAgentsRun" true
  "computerAwakeMode" "on"
  "showGitIgnoredFiles" true
  "showMenuBarIcon" true
  "showTitlebarAppName" true
  "openLinksInApp" false
  "rightSidebarOpenByDefault" true
  "setupScriptLaunchMode" "new-tab"
  "skipCloseTerminalWithRunningProcessConfirm" true
  "skipDeleteWorktreeConfirm" false
  "skipDeleteAutomationConfirm" false
  "skipDeleteArtifactConfirm" false
  "confirmClosePinnedTab" true
  "ctrlTabOrderMode" "mru"
  "tabAutoGenerateTitle" true
  "artifactsEnabled" true
  "artifactSharingEnabled" false
  "agentSkillSharingEnabled" false
  "floatingTerminalEnabled" true
  "floatingTerminalCwd" "~"
  "floatingTerminalTriggerLocation" "floating-button"
  "sourceControlCompareAgainstUpstream" false
  "sourceControlGroupOrder" "changes-first"
  "sourceControlViewMode" "list"
  "sourceControlAi" (dict "enabled" true)
  "commitMessageAi" (dict "enabled" true)
  "defaultTaskSource" "github"
  "defaultTaskViewPreset" "all"
  "visibleTaskProviders" (list "github" "gitlab" "linear" "jira")
  "worktreeVisibilityDefaults" (dict "external" "hide")
  "terminalThemeDark" "Gruvbox Dark"
  "terminalThemeLight" "Gruvbox Light"
  "terminalUseSeparateLightTheme" true
  "terminalFontFamily" "SF Mono"
  "terminalFontSize" 14
  "terminalFontWeight" 500
  "terminalFontWeightBold" 700
  "terminalLineHeight" 1
  "terminalScrollSensitivity" 1.15
  "terminalFastScrollSensitivity" 5
  "terminalTuiScrollSensitivity" 1
  "terminalInactivePaneOpacity" 0.9
  "terminalActivePaneOpacity" 1
  "terminalPaneOpacityTransitionMs" 140
  "terminalDividerThicknessPx" 3
  "terminalDividerColorDark" "#3f3f46"
  "terminalDividerColorLight" "#d4d4d8"
  "terminalCursorStyle" "block"
  "terminalCursorBlink" true
  "terminalLigatures" "auto"
  "terminalMacOptionAsAlt" "auto"
  "terminalScrollbackRows" 5000
  "terminalGpuAcceleration" "auto"
  "terminalAllowOsc52Clipboard" true
  "terminalScopeHistoryByWorktree" true
  "terminalShortcutPolicy" "orca-first"
  "terminalClipboardOnSelect" false
  "terminalRightClickToPaste" false
  "terminalLinkActionPopoverEnabled" true
  "notifications" (dict
    "enabled" true
    "agentTaskComplete" true
    "terminalBell" true
    "suppressWhenFocused" true
    "customSoundId" "system"
    "customSoundVolume" 100
  )
  "openInApplications" (list (dict
    "id" "vscode"
    "label" "VS Code"
    "command" "code"
  ))
-}}
{{- $ui := dict
  "groupBy" "repo"
  "sortBy" "smart"
  "projectOrderBy" "manual"
  "sidebarWidth" 280
  "rightSidebarWidth" 350
  "statusBarVisible" true
  "statusBarUsageMode" "verbose"
  "agentActivityDisplayMode" "compact"
  "alwaysShowDefaultBranchWorkspace" true
  "hideAutomationGeneratedWorkspaces" false
  "hideCliCreatedWorkspaces" false
  "hideDefaultBranchWorkspace" false
  "hideDetachedHeadWorkspaces" false
  "hideSleepingWorkspaces" false
  "hideWorkspacesFromOtherDevices" false
  "showSleepingWorkspaces" true
  "showActiveOnly" false
-}}
{{- includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" (dict "settings" $settings "ui" $ui)
) -}}
