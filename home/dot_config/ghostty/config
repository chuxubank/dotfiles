macos-option-as-alt = true
mouse-hide-while-typing = true
shell-integration-features = ssh-terminfo,ssh-env
theme = light:Gruvbox Light,dark:Gruvbox Dark
window-padding-balance = true

# Terminal layer: OS windows only. Mux owns tabs/panes; pass those chords through.
keybind = super+w=close_window
keybind = ctrl+shift+w=close_window

keybind = super+t=unbind
keybind = super+shift+t=unbind
keybind = ctrl+shift+t=unbind
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+left_bracket=unbind
keybind = super+right_bracket=unbind
keybind = super+shift+left_bracket=unbind
keybind = super+shift+right_bracket=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
