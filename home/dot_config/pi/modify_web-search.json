{{- /* chezmoi:modify-template */ -}}

{{- /* pi-web-access — schema: npm:pi-web-access README Configuration
       Dest is ~/.config/pi/web-search.json because this repo exports
       XDG_CONFIG_HOME and getWebSearchConfigDir() prefers it over ~/.pi.
       A modify-template so API keys and /curator runtime writes survive. */ -}}
{{- includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" (dict
    "summaryModel" (includeTemplate "llm/resolve-model-alias" (dict
      "model" "xai/${grok_primary}"
      "aliases" (default dict .llm.models)))
    "workflow" "auto-summary"
    "autoOpenBrowser" false)
) -}}
