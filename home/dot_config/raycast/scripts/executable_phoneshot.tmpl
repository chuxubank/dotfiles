#!/bin/zsh

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Phoneshot
# @raycast.mode compact

# Optional parameters:
# @raycast.icon 📱
# @raycast.packageName Android
{{ includeTemplate "raycast/adb-device-argument" (dict "argument" 1) -}}
# @raycast.argument2 { "type": "text", "placeholder": "Filename (optional)", "optional": true }

# Documentation:
# @raycast.author Misaka
# @raycast.authorURL https://github.com/chuxubank

save_dir="${PHONESHOT_DIR:-$HOME/Downloads}"
copy_to_clipboard="${PHONESHOT_COPY:-true}"
serial="${1:-}"
filename="${2:-phoneshot}"
out_file="${save_dir}/${filename}.png"

if ! command -v adb >/dev/null 2>&1; then
    echo "❌ adb is not installed or not in PATH."
    exit 1
fi

if [[ -z "$serial" ]]; then
    lines=()
    while IFS= read -r line; do
        [[ "$(echo "$line" | awk '{print $2}')" == "device" ]] && lines+=("$line")
    done < <(adb devices -l | tail -n +2)

    if [[ ${#lines[@]} -eq 0 ]]; then
        echo "❌ No Android device found. Please connect your phone and enable USB debugging."
        exit 1
    elif [[ ${#lines[@]} -eq 1 ]]; then
        serial=$(echo "${lines[1]}" | awk '{print $1}')
    elif [[ -t 0 ]]; then
        echo "Available devices:"
        select line in "${lines[@]}"; do
            [[ -n "$line" ]] && break
            echo "Invalid selection, try again."
        done
        serial=$(echo "$line" | awk '{print $1}')
    else
        serial=$(echo "${lines[1]}" | awk '{print $1}')
    fi
fi

if [[ "$(adb -s "$serial" get-state 2>/dev/null)" != "device" ]]; then
    echo "❌ Android device $serial is not available."
    exit 1
fi

remote_file="/sdcard/${filename}.png"

if ! adb -s "$serial" shell screencap -p "$remote_file"; then
    echo "❌ Failed to capture screenshot from $serial."
    exit 1
fi

if ! adb -s "$serial" pull "$remote_file" "$out_file"; then
    adb -s "$serial" shell rm "$remote_file" >/dev/null 2>&1
    echo "❌ Failed to save screenshot from $serial."
    exit 1
fi

adb -s "$serial" shell rm "$remote_file"
echo "Saved phone screenshot to $out_file"

if [[ $copy_to_clipboard == true ]]; then
    clip-image "$out_file"
    echo "Copied screenshot to clipboard"
fi
