#!/bin/zsh
{{- $deviceTypes := list "simulator" "usb" "wifi" }}

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title Phoneshot
# @raycast.mode compact

# Optional parameters:
# @raycast.icon 📱
# @raycast.packageName Mobile Development
{{ includeTemplate "raycast/mobile-device-argument" (dict
      "argument" 1
      "platforms" (list "android" "ios")
      "types" $deviceTypes
      "chezmoi" .chezmoi
    ) -}}
# @raycast.argument2 { "type": "text", "placeholder": "Filename (optional)", "optional": true }

# Documentation:
# @raycast.description Capture an Android or iOS device and copy it to the clipboard
# @raycast.author Misaka
# @raycast.authorURL https://github.com/chuxubank

save_dir="${PHONESHOT_DIR:-$HOME/Downloads}"
copy_to_clipboard="${PHONESHOT_COPY:-true}"
selection="${1:-}"
filename="${2:-phoneshot}"
out_file="${save_dir}/${filename}.png"
capture_file="$out_file"
temporary_file=""
temporary_dir=""
device_types={{ join "," $deviceTypes | quote }}

if ! mkdir -p "$save_dir" 2>/dev/null || [[ ! -w "$save_dir" ]]; then
    temporary_dir=$(mktemp -d "${TMPDIR:-/tmp}/phoneshot.XXXXXX") || {
        echo "❌ Cannot write screenshot to $out_file or create a temporary file."
        exit 1
    }
    temporary_file="$temporary_dir/phoneshot.png"
    capture_file="$temporary_file"
fi
trap '[[ -n "$temporary_file" ]] && rm -f "$temporary_file"; [[ -n "$temporary_dir" ]] && rmdir "$temporary_dir" 2>/dev/null' EXIT

if ! command -v mobile-device-list >/dev/null 2>&1; then
    echo "❌ mobile-device-list is not installed. Run chezmoi apply."
    exit 1
fi

if [[ -z "$selection" ]]; then
    entries=("${(@f)$(mobile-device-list --types "$device_types" --format tsv)}")
    entries=("${(@)entries:#}")

    if [[ ${#entries[@]} -eq 0 ]]; then
        echo "❌ No available Android or iOS device found."
        exit 1
    elif [[ ${#entries[@]} -eq 1 ]]; then
        entry="${entries[1]}"
    elif [[ -t 0 ]]; then
        echo "Available devices:"
        select entry in "${entries[@]}"; do
            [[ -n "$entry" ]] && break
            echo "Invalid selection, try again."
        done
    else
        entry="${entries[1]}"
    fi

    selection="${entry%%$'\t'*}"
    remainder="${entry#*$'\t'}"
    selection+=":${remainder%%$'\t'*}"
fi

kind="${selection%%:*}"
device_id="${selection#*:}"
if [[ -z "$device_id" || "$device_id" == "$selection" ]]; then
    echo "❌ Invalid device selection: $selection"
    exit 1
fi

case "$kind" in
    android)
        if ! command -v adb >/dev/null 2>&1; then
            echo "❌ adb is not installed or not in PATH."
            exit 1
        fi
        if [[ "$(adb -s "$device_id" get-state 2>/dev/null)" != "device" ]]; then
            echo "❌ Android device $device_id is not available."
            exit 1
        fi

        if ! adb -s "$device_id" exec-out screencap -p > "$capture_file"; then
            echo "❌ Failed to capture Android device $device_id."
            exit 1
        fi
        ;;
    simulator)
        if ! xcrun simctl io "$device_id" screenshot "$capture_file"; then
            echo "❌ Failed to capture Simulator $device_id."
            exit 1
        fi
        ;;
    device-usb|device-network)
        if ! command -v pymobiledevice3 >/dev/null 2>&1; then
            echo "❌ pymobiledevice3 is required for physical iOS devices. Run chezmoi apply to install Python tools."
            exit 1
        fi

        device_options=(--userspace --udid "$device_id")
        if [[ "$kind" == "device-network" ]]; then
            device_options+=(--mobdev2)
        fi

        if ! pymobiledevice3 developer dvt screenshot "${device_options[@]}" "$capture_file"; then
            echo "❌ Failed to capture iOS device $device_id."
            exit 1
        fi
        ;;
    *)
        echo "❌ Unsupported device type: $kind"
        exit 1
        ;;
esac

if [[ ! -s "$capture_file" ]]; then
    echo "❌ Screenshot was not created."
    exit 1
fi

if [[ $copy_to_clipboard == true ]]; then
    if ! clip-image "$capture_file"; then
        echo "❌ Screenshot was captured, but it could not be copied to the clipboard."
        exit 1
    fi
    echo "Copied screenshot to clipboard"
fi

if [[ -n "$temporary_file" ]]; then
    echo "⚠️ Cannot save screenshot to $out_file; check Raycast Files and Folders permission."
elif [[ "$capture_file" == "$out_file" ]]; then
    echo "Saved screenshot to $out_file"
fi
