#!/bin/zsh
{{- $deviceTypes := list "simulator" "usb" }}

# Required parameters:
# @raycast.schemaVersion 1
# @raycast.title ADB Wi-Fi
# @raycast.mode compact

# Optional parameters:
# @raycast.icon 📡
# @raycast.packageName Android
{{ includeTemplate "raycast/adb-device-argument" (merge (dict "argument" 1 "types" $deviceTypes) .) -}}

# Documentation:
# @raycast.description Connect an ADB device wirelessly via tcpip 5555
# @raycast.author Misaka
# @raycast.authorURL https://github.com/chuxubank

serial="${1:-}"
device_types={{ join "," $deviceTypes | quote }}

if ! command -v mobile-device-list >/dev/null 2>&1; then
    echo "❌ mobile-device-list is not installed. Run chezmoi apply."
    exit 1
fi

if [[ -z "$serial" ]]; then
    entries=("${(@f)$(mobile-device-list --platforms android --types "$device_types" --format tsv)}")
    entries=("${(@)entries:#}")

    if [[ ${#entries[@]} -eq 0 ]]; then
        echo "❌ No USB-connected ADB device found."
        exit 1
    elif [[ ${#entries[@]} -eq 1 ]]; then
        entry="${entries[1]}"
    elif [[ -t 0 ]]; then
        echo "Available devices:"
        select entry in "${entries[@]}"; do
            [[ -n "$entry" ]] && break
            echo "Invalid selection, try again."
        done
    else
        entry="${entries[1]}"
    fi

    remainder="${entry#*$'\t'}"
    serial="${remainder%%$'\t'*}"
fi

if mobile-device-list --platforms android --types wifi --format tsv \
    | awk -F '\t' -v serial="$serial" '$2 == serial { found = 1 } END { exit !found }'; then
    echo "✅ $serial is already wireless"
    exit 0
fi

ip=$(adb -s "$serial" shell ip -4 addr show dev wlan0 2>/dev/null \
    | grep -oE 'inet [0-9.]+' | awk '{print $2}')

if [[ -z "$ip" ]]; then
    echo "❌ Cannot get Wi-Fi IP from $serial"
    exit 1
fi

adb -s "$serial" tcpip 5555 >/dev/null 2>&1
sleep 2
result=$(adb connect "${ip}:5555" 2>&1)

if [[ "$result" == *"connected"* ]]; then
    echo "✅ Connected to ${ip}:5555"
else
    echo "❌ $result"
    exit 1
fi
