layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab_template name="opencode" {
        pane split_direction="vertical" {
            pane command="opencode" size="70%"
            children
        }
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }

    {{- if eq .host_env "iv" }}
    opencode name="ivc" cwd="{{- joinPath .chezmoi.homeDir .path.workspace.iv "ivc" -}}" {
        pane
    }
    {{- end }}

    {{- if ne .host_env "cloud" }}
    tab name="proxy" cwd="{{- joinPath .chezmoi.homeDir .path.personal.proxy -}}" {
        pane split_direction="vertical" {
            pane command="tail" {
                {{- $log := includeTemplate "service/log-path" (dict "path" .path "parts" (list "sing-box") "file" "sing-box.log") -}}
                {{- /* path.log is absolute on darwin/linux and relative on windows. */ -}}
                {{- if and (not (osIsAbs $log)) (not (regexMatch "^[A-Za-z]:" $log)) -}}
                  {{- $log = joinPath .chezmoi.homeDir $log -}}
                {{- end }}
                args "-f" {{ $log | quote }}
            }
            pane
        }
    }
    {{- end }}
}
