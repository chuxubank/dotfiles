{{- /* herdr-spreader layout. Source of truth: .chezmoidata/workspaces.yaml */ -}}
workspaces:
{{- range .workspaces }}
  - name: {{ .name | quote }}
{{- if and (hasKey . "focus") .focus }}
    focus: true
{{- end }}
{{- if hasKey . "root" }}
    root: {{ .root | quote }}
{{- end }}
{{- if hasKey . "env" }}
    env:
{{- range $k, $v := .env }}
      {{ $k }}: {{ $v | quote }}
{{- end }}
{{- end }}
    tabs:
{{- range .tabs }}
      - label: {{ .label | quote }}
{{- if hasKey . "cwd" }}
        cwd: {{ .cwd | quote }}
{{- end }}
        panes:
{{- range .panes }}
          -
{{- if hasKey . "split" }}
            split: {{ .split }}
{{- end }}
{{- if hasKey . "cwd" }}
            cwd: {{ .cwd | quote }}
{{- end }}
{{- if hasKey . "command" }}
            command: {{ .command | quote }}
{{- else if hasKey . "kind" }}
            command: {{ .kind | quote }}
{{- end }}
{{- if and (hasKey . "focus") .focus }}
            focus: true
{{- end }}
{{- end }}
{{- end }}
{{- end }}
