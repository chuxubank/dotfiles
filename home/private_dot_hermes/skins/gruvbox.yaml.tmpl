{{- /* Select the classic CLI's base palette exclusively from .isDarkMode.
       Keep paired palettes for other Hermes surfaces; no OS appearance probe. */ -}}
{{- $dark := dict
  "bg" "#282828" "surface" "#3c3836" "selection" "#504945"
  "fg" "#ebdbb2" "strong" "#fbf1c7" "muted" "#a89984" "border" "#665c54"
  "red" "#fb4934" "green" "#b8bb26" "yellow" "#fabd2f"
  "blue" "#83a598" "purple" "#d3869b" "aqua" "#8ec07c" "orange" "#fe8019"
-}}
{{- $light := dict
  "bg" "#fbf1c7" "surface" "#ebdbb2" "selection" "#d5c4a1"
  "fg" "#3c3836" "strong" "#282828" "muted" "#7c6f64" "border" "#bdae93"
  "red" "#9d0006" "green" "#79740e" "yellow" "#b57614"
  "blue" "#076678" "purple" "#8f3f71" "aqua" "#427b58" "orange" "#af3a03"
-}}
{{- $roles := dict
  "background" "bg"
  "banner_title" "strong" "banner_text" "fg" "banner_dim" "muted"
  "banner_accent" "blue" "banner_border" "border"
  "ui_primary" "strong" "ui_text" "fg" "ui_label" "aqua"
  "ui_accent" "blue" "ui_border" "border" "ui_tool" "aqua" "ui_thinking" "muted"
  "ui_ok" "green" "ui_warn" "yellow" "ui_error" "red"
  "prompt" "aqua" "input_rule" "border" "response_border" "border"
  "status_bar_bg" "surface" "status_bar_text" "fg"
  "status_bar_strong" "strong" "status_bar_dim" "muted"
  "status_bar_good" "green" "status_bar_warn" "yellow"
  "status_bar_bad" "orange" "status_bar_critical" "red"
  "session_label" "blue" "session_border" "border"
  "completion_menu_bg" "surface" "completion_menu_current_bg" "selection"
  "completion_menu_meta_bg" "surface" "completion_menu_meta_current_bg" "selection"
  "selection_bg" "selection" "shell_dollar" "blue" "voice_status_bg" "surface"
  "diff_added" "green" "diff_removed" "red"
  "diff_added_word" "aqua" "diff_removed_word" "orange"
  "syntax_string" "green" "syntax_number" "purple"
  "syntax_keyword" "red" "syntax_comment" "muted"
-}}
name: gruvbox
description: Gruvbox — warm neutral surfaces with restrained blue and aqua accents
{{ range $section := list "colors" "dark_colors" "light_colors" }}
{{ $section }}:
{{- $palette := ternary $dark $light $.isDarkMode -}}
{{- if eq $section "dark_colors" -}}
  {{- $palette = $dark -}}
{{- else if eq $section "light_colors" -}}
  {{- $palette = $light -}}
{{- end -}}
{{ range $key, $role := $roles }}
  {{ $key }}: {{ index $palette $role | quote }}
{{- end }}
{{ end }}
