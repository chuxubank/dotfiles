{{- /* Cursor MCP config generated from .chezmoidata/mcp.yaml */ -}}

{{- $servers := dict -}}
{{- range $provider := .mcp.providers }}
  {{- if not $provider.enabled }}{{ continue }}{{ end -}}
  {{- $exec := $provider.execution -}}
  {{- $server := dict -}}

  {{- if eq $exec.type "stdio" }}
    {{- $_ := set $server "type" "stdio" -}}
    {{- $_ := set $server "command" $exec.cmd -}}
    {{- if hasKey $exec "args" }}
      {{- $_ := set $server "args" $exec.args -}}
    {{- end }}
  {{- else if or (eq $exec.type "http") (eq $exec.type "sse") }}
    {{- $_ := set $server "url" $exec.url -}}
    {{- $headers := dict -}}
    {{- if hasKey $exec "http_headers" }}
      {{- range $k, $v := $exec.http_headers }}
        {{- $_ := set $headers $k $v -}}
      {{- end }}
    {{- end }}
    {{- if hasKey $exec "env_http_headers" }}
      {{- range $k := sortAlpha (keys $exec.env_http_headers) }}
        {{- $v := index $exec.env_http_headers $k -}}
        {{- if eq (kindOf $v) "map" }}
          {{- $secret := "" -}}
          {{- if or (not (hasKey $v "type")) (eq $v.type "pass") }}
            {{- if (hasKey $v "field") }}
              {{- $secret = (index (passFields $v.path) $v.field) -}}
            {{- else }}
              {{- $secret = (pass $v.path) -}}
            {{- end }}
          {{- else if eq $v.type "output" }}
            {{- $secret = (outputList $v.cmd $v.args) -}}
          {{- end }}
          {{- if and (hasKey $v "trim") $v.trim }}
            {{- $secret = ($secret | trim) -}}
          {{- end }}
          {{- $_ := set $headers $k $secret -}}
        {{- else }}
          {{- $_ := set $headers $k $v -}}
        {{- end }}
      {{- end }}
    {{- end }}
    {{- if hasKey $exec "bearer_token_env_var" }}
      {{- $_ := set $headers "Authorization" (printf "Bearer ${env:%s}" $exec.bearer_token_env_var) -}}
    {{- end }}
    {{- if gt (len $headers) 0 }}
      {{- $_ := set $server "headers" $headers -}}
    {{- end }}
  {{- else }}
    {{- /* Skip unsupported execution type */ -}}
    {{- continue -}}
  {{- end }}

  {{- if hasKey $exec "envs" }}
    {{- $envs := dict -}}
    {{- range $envKey := sortAlpha (keys $exec.envs) }}
      {{- $envValue := index $exec.envs $envKey -}}
      {{- if eq (kindOf $envValue) "map" }}
        {{- $secret := "" -}}
        {{- if or (not (hasKey $envValue "type")) (eq $envValue.type "pass") }}
          {{- if (hasKey $envValue "field") }}
            {{- $secret = (index (passFields $envValue.path) $envValue.field) -}}
          {{- else }}
            {{- $secret = (pass $envValue.path) -}}
          {{- end }}
        {{- else if eq $envValue.type "output" }}
          {{- $secret = (outputList $envValue.cmd $envValue.args) -}}
        {{- end }}
        {{- if and (hasKey $envValue "trim") $envValue.trim }}
          {{- $secret = ($secret | trim) -}}
        {{- end }}
        {{- $_ := set $envs $envKey $secret -}}
      {{- else }}
        {{- $_ := set $envs $envKey $envValue -}}
      {{- end }}
    {{- end }}
    {{- if gt (len $envs) 0 }}
      {{- $_ := set $server "env" $envs -}}
    {{- end }}
  {{- end }}

  {{- $serverName := regexReplaceAll "[^A-Za-z0-9_-]+" ($provider.name | lower) "_" -}}
  {{- $_ := set $servers $serverName $server -}}
{{- end }}

{{ $servers | dict "mcpServers" | toPrettyJson }}
