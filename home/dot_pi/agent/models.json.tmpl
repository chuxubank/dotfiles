{{- /* pi custom models — generated from llm.yaml (llm.tools.pi).
       Schema: @earendil-works/pi-coding-agent/docs/models.md

       Secrets stay out of this file: apiKey uses pi's `!command` form to shell
       out to bin/pass-field at request time, the same helper codex's config
       uses. Nothing here is sensitive, so no private_ attribute.

       Merge semantics do the heavy lifting. For a provider pi already bundles
       (anthropic, openai), built-in models are kept and ours are upserted by
       id — so the bundled catalog's rich metadata survives while the IV proxy's
       extra ids (claude-opus-5, the -thinking variants) get added on top. */ -}}
{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "pi") .) | fromJson -}}
{{- $passField := joinPath .chezmoi.homeDir "bin" "pass-field" -}}

{{- $providers := dict -}}
{{- range $alias, $ep := $cfg.providers -}}
  {{- /* Map our provider type onto a pi api id and normalize the base URL. pi
         passes baseUrl to the SDK as-is, so the version suffix has to match
         what each api expects. */ -}}
  {{- $api := "openai-completions" -}}
  {{- $baseURL := trimSuffix "/" $ep.base_url -}}
  {{- if eq $ep.type "anthropic" -}}
    {{- $api = "anthropic-messages" -}}
  {{- else if eq $ep.type "gemini" -}}
    {{- $api = "google-generative-ai" -}}
    {{- if and $baseURL (not (hasSuffix "/v1beta" $baseURL)) -}}
      {{- $baseURL = printf "%s/v1beta" $baseURL -}}
    {{- end -}}
  {{- else if and $baseURL (not (hasSuffix "/v1" $baseURL)) -}}
    {{- $baseURL = printf "%s/v1" $baseURL -}}
  {{- end -}}

  {{- /* models: false → endpoint override only, keep pi's catalog untouched. */ -}}
  {{- $models := list -}}
  {{- $declaresModels := true -}}
  {{- if and (hasKey $ep "models") (eq (kindOf $ep.models) "bool") -}}
    {{- $declaresModels = false -}}
  {{- else -}}
    {{- $source := dict -}}
    {{- if hasKey $ep "models" -}}
      {{- $source = $ep.models -}}
    {{- else -}}
      {{- $source = includeTemplate "llm/fetch-models" $ep | fromJson -}}
    {{- end -}}
    {{- $metadata := default dict (index $ep "model_metadata") -}}
    {{- $filter := default dict (index $ep "model_filter") -}}
    {{- if and (gt (len $filter) 0) (gt (len $metadata) 0) -}}
      {{- $allowed := includeTemplate "llm/filter-models" (dict "models" $metadata "filter" $filter) | fromJson -}}
      {{- $kept := dict -}}
      {{- range $id, $name := $source -}}
        {{- if hasKey $allowed $id -}}{{- $_ := set $kept $id $name -}}{{- end -}}
      {{- end -}}
      {{- $source = $kept -}}
    {{- end -}}
    {{- range $id, $name := $source -}}
      {{- $model := dict "id" $id "name" $name "api" $api -}}
      {{- if hasKey $metadata $id -}}
        {{- $model = mergeOverwrite (deepCopy (index $metadata $id)) $model -}}
      {{- end -}}
      {{- $models = append $models (includeTemplate "model-config/pi" $model | fromJson) -}}
    {{- end -}}
  {{- end -}}

  {{- /* Emit only when the alias contributes something: a model list, or an
         endpoint we can authenticate against. A bare baseUrl with no key
         (provider gated off, or its pass entry absent here) would just restate
         pi's own default. */ -}}
  {{- if or (gt (len $models) 0) (and $baseURL $ep.auth_path) -}}
    {{- $p := dict -}}
    {{- if $baseURL -}}{{- $_ := set $p "baseUrl" $baseURL -}}{{- end -}}
    {{- if $ep.auth_path -}}
      {{- $args := $ep.auth_path -}}
      {{- if $ep.auth_field -}}
        {{- $args = printf "%s %s" $ep.auth_path $ep.auth_field -}}
      {{- end -}}
      {{- $_ := set $p "apiKey" (printf "!%s %s" $passField $args) -}}
    {{- else if $declaresModels -}}
      {{- /* Keyless local servers (ollama, mlx) still need the field present or
             their models never become selectable; the server ignores it. */ -}}
      {{- $_ := set $p "apiKey" "unused" -}}
    {{- end -}}
    {{- if $declaresModels -}}
      {{- $_ := set $p "api" $api -}}
      {{- $_ := set $p "models" $models -}}
    {{- end -}}
    {{- $_ := set $providers $alias $p -}}
  {{- end -}}
{{- end -}}

{{ dict "providers" $providers | toPrettyJson }}
