{{- /* chezmoi:modify-template */ -}}

{{- /* pi project trust — schema: @earendil-works/pi-coding-agent/docs/security.md
       Flat map of canonical absolute directory → bool. Trust gates loading
       .pi/settings.json, project extensions/skills/prompts/themes, and project
       package installs — i.e. arbitrary code from the repo you are sitting in.

       A modify-template, not a plain template, so decisions saved by /trust
       survive an apply.

       Path set comes from trust/paths (cascade-safe: no $HOME, workspace
       roots not expanded). Paths are written whether or not they exist
       yet, keeping output identical across hosts and pre-approving a
       repo for whenever it gets cloned. */ -}}

{{- $trusted := includeTemplate "trust/paths" . | fromJson -}}

{{- $in := trim .chezmoi.stdin -}}
{{- $decisions := dict -}}
{{- if gt (len $in) 0 -}}
  {{- $decisions = fromJson $in -}}
{{- end -}}

{{- /* Only add. An explicit `false` saved by /trust stays untouched: revoking
       trust is a decision worth keeping. */ -}}
{{- range $path := sortAlpha (uniq $trusted) -}}
  {{- if not (hasKey $decisions $path) -}}
    {{- $_ := set $decisions $path true -}}
  {{- end -}}
{{- end -}}
{{- $decisions | toPrettyJson -}}
