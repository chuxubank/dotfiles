{{- /* chezmoi:modify-template */ -}}

{{- /* pi settings — schema: @earendil-works/pi-coding-agent/docs/settings.md
       A modify-template, not a plain template, so keys pi owns at runtime
       (lastChangelogVersion, whatever /settings writes) survive an apply. */ -}}

{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "pi") .) | fromJson -}}
{{- $packages := includeTemplate "plugins/pi" . | fromJson -}}

{{- /* "<light>/<dark>" is pi's auto form: exactly one slash, light theme first.
       It re-detects the terminal background on every start
       (resolveThemeSetting + detectTerminalThemeForAuto), so it tracks the
       terminal live. Deliberately not `ternary ... .isDarkMode` — that is
       captured once when chezmoi init runs the AppleInterfaceStyle probe, so it
       would freeze the theme and not even follow a later apply. */ -}}
{{- $theme := "light/dark" -}}

{{- /* llm.yaml states models as "<alias>/<id>"; pi splits them across
       defaultProvider and defaultModel. */ -}}
{{- $provider := $cfg.model_provider -}}
{{- $model := $cfg.model_id -}}

{{- /* enabledModels is the Ctrl+P cycling pool. Patterns come from
       llm.yaml; unused provider/* aliases warn, so keep globs. */ -}}
{{- $remove := list -}}
{{- if not (hasKey $cfg "enabled_models") -}}
  {{- $remove = list "enabledModels" -}}
{{- end -}}

{{- /* omp-inspired portable knobs (oh-my-pi is a fork; these are the
       official-pi equivalents that do not require switching binaries):
       - defaultTools adds grep/find/ls so the model stops shelling out to
         rg/find/ls. Pi's stock set is only read/bash/edit/write.
       - retry is closer to omp (10 / 500ms): Codex + high thinking hits
         transient 429s; keep provider retries at 0 so quota walls surface.
       - httpIdleTimeoutMs 30m, because default 5m kills long thinking. */ -}}
{{- $managed := dict
  "defaultModel" $model
  "defaultThinkingLevel" (default "medium" (index $cfg "reasoning_effort"))
  "defaultTools" (list "read" "bash" "edit" "write" "grep" "find" "ls")
  "httpIdleTimeoutMs" 1800000
  "npmCommand" (list "bun")
  "packages" $packages
  "retry" (dict
    "enabled" true
    "maxRetries" 8
    "baseDelayMs" 500
    "provider" (dict
      "timeoutMs" 3600000
      "maxRetries" 0
      "maxRetryDelayMs" 60000
    )
  )
  "theme" $theme
  "tuiMode" "fullscreen"
-}}
{{- if $provider -}}
  {{- $_ := set $managed "defaultProvider" $provider -}}
{{- end -}}
{{- /* subagents.defaultModel comes from llm/pi.yaml subagent_model. */ -}}
{{- $subagentCandidates := default (list "xai/grok-4.6") (index (index .llm.tools "pi") "subagent_model") -}}
{{- $subagentModel := includeTemplate "llm/pick-model" (dict "models" $subagentCandidates "providers" $cfg.providers) -}}
{{- $_ := set $managed "subagents" (dict "defaultModel" $subagentModel) -}}
{{- if hasKey $cfg "enabled_models" -}}
  {{- $_ := set $managed "enabledModels" $cfg.enabled_models -}}
{{- end -}}
{{- includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" $managed
  "remove" $remove
) -}}
