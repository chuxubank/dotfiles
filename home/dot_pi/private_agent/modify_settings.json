{{- /* chezmoi:modify-template */ -}}

{{- /* pi settings — schema: @earendil-works/pi-coding-agent/docs/settings.md
       A modify-template, not a plain template, so keys pi owns at runtime
       (lastChangelogVersion, whatever /settings writes) survive an apply. */ -}}

{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "pi") .) | fromJson -}}
{{- $packages := includeTemplate "plugins/pi" . | fromJson -}}

{{- /* "<light>/<dark>" is pi's auto form: exactly one slash, light theme first.
       It re-detects the terminal background on every start
       (resolveThemeSetting + detectTerminalThemeForAuto), so it tracks the
       terminal live. Deliberately not `ternary ... .isDarkMode` — that is
       captured once when chezmoi init runs the AppleInterfaceStyle probe, so it
       would freeze the theme and not even follow a later apply. */ -}}
{{- $theme := "light/dark" -}}

{{- /* llm.yaml states models as "<alias>/<id>"; pi splits them across
       defaultProvider and defaultModel. An unresolved last candidate still
       splits on the slash. */ -}}
{{- $aliases := default dict .llm.models -}}
{{- $provider := $cfg.model_provider -}}
{{- $model := $cfg.model_id -}}
{{- if not $provider -}}
  {{- $parts := splitList "/" $model -}}
  {{- if gt (len $parts) 1 -}}
    {{- $provider = index $parts 0 -}}
    {{- $model = join "/" (slice $parts 1) -}}
  {{- end -}}
{{- end -}}

{{- /* enabledModels is the Ctrl+P cycling pool. Patterns come from
       llm.yaml; unused provider/* aliases warn, so keep globs. */ -}}
{{- $remove := list -}}
{{- if not (hasKey $cfg "enabled_models") -}}
  {{- $remove = list "enabledModels" -}}
{{- end -}}
{{- if not $provider -}}
  {{- $remove = append $remove "defaultProvider" -}}
{{- end -}}

{{- /* omp-inspired portable knobs (oh-my-pi is a fork; these are the
       official-pi equivalents that do not require switching binaries):
       - defaultTools adds grep/find/ls so the model stops shelling out to
         rg/find/ls. Pi's stock set is only read/bash/edit/write.
       - retry is closer to omp (10 / 500ms): Codex + high thinking hits
         transient 429s; keep provider retries at 0 so quota walls surface.
       - httpIdleTimeoutMs 30m, because default 5m kills long thinking. */ -}}
{{- $managed := dict
  "defaultModel" $model
  "defaultThinkingLevel" (default "medium" (index $cfg "reasoning_effort"))
  "defaultTools" (list "read" "bash" "edit" "write" "grep" "find" "ls")
  "httpIdleTimeoutMs" 1800000
  "npmCommand" (list "bun")
  "packages" $packages
  "retry" (dict
    "enabled" true
    "maxRetries" 8
    "baseDelayMs" 500
    "provider" (dict
      "timeoutMs" 3600000
      "maxRetries" 0
      "maxRetryDelayMs" 60000
    )
  )
  "theme" $theme
  "tuiMode" "fullscreen"
-}}
{{- if $provider -}}
  {{- $_ := set $managed "defaultProvider" $provider -}}
{{- end -}}
{{- /* pick-model only tests alias membership; skip the catalog payload. */ -}}
{{- $aliasSet := dict -}}
{{- range $alias, $_ := $cfg.providers -}}{{- $_ := set $aliasSet $alias true -}}{{- end -}}
{{- /* subagents.defaultModel comes from llm/pi.yaml subagent_model. */ -}}
{{- $subagentCandidates := list -}}
{{- range $candidate := default (list "xai/${grok_primary}") (index (index .llm.tools "pi") "subagent_model") -}}
  {{- $subagentCandidates = append $subagentCandidates (includeTemplate "llm/resolve-model-alias" (dict "model" $candidate "aliases" $aliases)) -}}
{{- end -}}
{{- $subagentModel := includeTemplate "llm/pick-model" (dict "models" $subagentCandidates "providers" $aliasSet) -}}
{{- $_ := set $managed "subagents" (dict "defaultModel" $subagentModel) -}}
{{- /* session.titleGeneration is @furbyhaxx/pi-session-naming. useTags
       false is a plain description, not feat(scope): …. Model comes from
       llm/pi.yaml session_title_model and already carries :thinking. */ -}}
{{- $titleCandidates := list -}}
{{- range $candidate := default (list "xai/${grok_primary}:low") (index (index .llm.tools "pi") "session_title_model") -}}
  {{- $titleCandidates = append $titleCandidates (includeTemplate "llm/resolve-model-alias" (dict "model" $candidate "aliases" $aliases)) -}}
{{- end -}}
{{- $titleModel := includeTemplate "llm/pick-model" (dict "models" $titleCandidates "providers" $aliasSet) -}}
{{- $_ := set $managed "session" (dict
  "titleGeneration" (dict
    "useTags" false
    "model" $titleModel)
) -}}
{{- if hasKey $cfg "enabled_models" -}}
  {{- $_ := set $managed "enabledModels" $cfg.enabled_models -}}
{{- end -}}
{{- /* Pi stores a fixed reserveTokens. llm.compaction.thresholds says
       when, as a percent of the window; the reserve is the rest.
       Windows come from the catalogs this apply already writes: declared
       Pi models, a Cursor @256k/@500k id, and the xAI models.dev card.
       The next apply picks up a window or threshold change. Cards under
       128k are image or video, not a chat window. */ -}}
{{- $rules := includeTemplate "llm/compaction-thresholds" . | fromJson -}}
{{- $windows := dict -}}
{{- $catalog := includeTemplate "llm/custom-providers" (merge (dict "tool" "pi") .) | fromJson -}}
{{- range $alias, $provider := $catalog -}}
  {{- range $model := default (list) (index $provider "models") -}}
    {{- $id := printf "%v" (index $model "id") -}}
    {{- $window := int (default 0 (index $model "contextWindow")) -}}
    {{- if ge $window 128000 -}}
      {{- $_ := set $windows (printf "%s/%s" $alias $id) $window -}}
    {{- end -}}
  {{- end -}}
  {{- range $id, $_ := default (dict) (index $provider "modelOverrides") -}}
    {{- $key := printf "%s/%s" $alias $id -}}
    {{- if not (hasKey $windows $key) -}}
      {{- $mark := regexFind "@[0-9]+[kKmM]" $id -}}
      {{- if $mark -}}
        {{- $n := int (regexFind "[0-9]+" $mark) -}}
        {{- $window := mul $n 1000 -}}
        {{- if or (hasSuffix "m" $mark) (hasSuffix "M" $mark) -}}{{- $window = mul $n 1000000 -}}{{- end -}}
        {{- if ge $window 128000 -}}{{- $_ := set $windows $key $window -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- if hasKey $cfg.providers "xai" -}}
  {{- $ds := index .llm.data_sets "models-dev" -}}
  {{- $dsFile := index .path.cache $ds.file_path -}}
  {{- if not (hasPrefix "/" $dsFile) -}}{{- $dsFile = joinPath .chezmoi.homeDir $dsFile -}}{{- end -}}
  {{- $xai := includeTemplate "llm/fetch-data-set" (dict "type" "models-dev" "file" $dsFile "provider" "xai") | fromJson -}}
  {{- range $id, $card := $xai -}}
    {{- $key := printf "xai/%s" $id -}}
    {{- if not (hasKey $windows $key) -}}
      {{- $window := int (dig "limit" "context" 0 $card) -}}
      {{- if ge $window 128000 -}}{{- $_ := set $windows $key $window -}}{{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $modelOverrides := dict -}}
{{- range $key, $window := $windows -}}
  {{- $percent := 0 -}}
  {{- $best := 0 -}}
  {{- range $rule := $rules -}}
    {{- if and (regexMatch $rule.regex $key) (gt (len $rule.match) $best) -}}
      {{- $best = len $rule.match -}}
      {{- $percent = int $rule.percent -}}
    {{- end -}}
  {{- end -}}
  {{- if gt $percent 0 -}}
    {{- $_ := set $modelOverrides $key (dict "reserveTokens" (div (mul (int $window) (sub 100 $percent)) 100)) -}}
  {{- end -}}
{{- end -}}
{{- /* Not a window percent: this model compacts far earlier than the default reserve. */ -}}
{{- $_ := set $modelOverrides "iv-codex/gpt-6.1-sol" (dict "reserveTokens" 650000) -}}
{{- $_ := set $managed "compaction" (dict "modelOverrides" $modelOverrides) -}}
{{- $in := trim (dig "stdin" "" .chezmoi) -}}
{{- $prior := dict -}}
{{- if gt (len $in) 0 -}}
  {{- $prior = default dict ($in | fromJson) -}}
{{- end -}}
{{- /* Drop the unused percent table and any earlier Grok reserve, then
       let the computed overrides replace them. Other models stay. */ -}}
{{- $compaction := dig "compaction" (dict) $prior -}}
{{- $_ := unset $compaction "modelThresholds" -}}
{{- $priorOverrides := dig "modelOverrides" (dict) $compaction -}}
{{- $drop := list -}}
{{- range $key, $_ := $priorOverrides -}}
  {{- range $rule := $rules -}}
    {{- if regexMatch $rule.regex $key -}}{{- $drop = append $drop $key -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- range $key := $drop -}}{{- $_ := unset $priorOverrides $key -}}{{- end -}}
{{- includeTemplate "config/merge" (dict
  "format" "json"
  "input" ($prior | toJson)
  "managed" $managed
  "remove" $remove
) -}}
