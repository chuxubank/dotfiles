{{- /* chezmoi:modify-template */ -}}
{{- /* pi keybindings — schema: @earendil-works/pi-coding-agent/docs/keybindings.md
       Emacs editor chords. Model cycle is M-n / M-p, the Emacs next/previous
       pair, and NOT C-S-p / C-S-n: those stay WezTerm's command palette and
       new window — a key-ownership choice, not an encoding limit.

       The action IDs are alt+n/alt+p, the same as OMP. pi-tui's
       LEGACY_SEQUENCE_KEY_IDS aliases ESC n to alt+down and ESC p to alt+up
       (keys.js), so the arrow ids match M-n/M-p under legacy encoding only —
       under kitty or modifyOtherKeys they match nothing. The letter ids match
       all three encodings.

       That takes alt+up from app.message.dequeue, which moves to alt+q — Pi's
       own Windows fallback for that action, unused on macOS. It does not move
       back: legacy ESC p carries both alt+up and alt+p.

       Session rename is C-M-r so Ctrl+R stays reverse search
       (pi-input-history).

       omit() drops leftover Enter/follow-up overrides as literal dotted keys.
       config/merge remove treats dots as nested paths, so it cannot. */ -}}
{{- $merged := includeTemplate "config/merge" (dict
  "format" "json"
  "input" (dig "stdin" "" .chezmoi)
  "managed" (dict
    "tui.editor.historyPrevious" "ctrl+p"
    "tui.editor.historyNext" "ctrl+n"
    "tui.editor.cursorLeft" (list "left" "ctrl+b")
    "tui.editor.cursorRight" (list "right" "ctrl+f")
    "tui.editor.cursorWordLeft" (list "alt+left" "alt+b")
    "tui.editor.cursorWordRight" (list "alt+right" "alt+f")
    "tui.editor.deleteCharForward" (list "delete" "ctrl+d")
    "tui.editor.deleteCharBackward" (list "backspace" "ctrl+h")
    "tui.input.newLine" (list "shift+enter" "ctrl+j")
    "app.model.cycleForward" "alt+n"
    "app.model.cycleBackward" "alt+p"
    "app.message.dequeue" "alt+q"
    "app.session.rename" "ctrl+alt+r"
  )
) | fromJson -}}
{{- omit $merged "tui.input.submit" "app.message.followUp" | toPrettyJson -}}
