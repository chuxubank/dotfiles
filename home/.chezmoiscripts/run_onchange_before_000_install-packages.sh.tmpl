#!/bin/sh

echo "󰯁 Install packages"

had_errors=false

{{- if or (eq .chezmoi.os "android") (eq .chezmoi.os "linux") (eq .chezmoi.os "windows") }}
{{ includeTemplate "script/reconcile-sh" }}

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/chezmoi"

sync_open_packages() {
	_state=$1
	_label=$2
	_remove=$3
	_tombstones=$(printf '%s\n' "$_all" | not_in_list "$_desired")
	_stale=$(printf '%s\n' "$_desired" | stale_managed "$_state")
	_drop=$(printf '%s\n%s\n' "$_stale" "$_tombstones" | grep -v '^$' | sort -u)
	if [ -n "$_drop" ]; then
		while IFS= read -r _pkg || [ -n "$_pkg" ]; do
			[ -z "$_pkg" ] && continue
			echo "Removing undeclared $_label: $_pkg"
			if ! $_remove "$_pkg"; then
				echo "Could not remove $_label $_pkg" >&2
				had_errors=true
			fi
		done <<DROP
$_drop
DROP
	fi
	if [ "$had_errors" = false ]; then
		printf '%s\n' "$_desired" | write_managed_state "$_state"
	fi
}
{{- end }}

{{ if eq .chezmoi.os "android" -}}
_desired='{{ template "package/lines" (dict "ctx" . "path" (list "termux" "repo")) }}
{{ template "package/lines" (dict "ctx" . "path" (list "termux" "pkg")) }}'
_all='{{ template "package/lines-all" (dict "ctx" . "path" (list "termux" "repo")) }}
{{ template "package/lines-all" (dict "ctx" . "path" (list "termux" "pkg")) }}'
if ! pkg install -y \
    {{ template "package/args" (dict "ctx" . "path" (list "termux" "repo")) }}
then
	echo "Could not install termux repositories" >&2
	had_errors=true
fi
if ! pkg install -y \
    {{ template "package/args" (dict "ctx" . "path" (list "termux" "pkg")) }}
then
	echo "Could not install termux packages" >&2
	had_errors=true
fi
termux_remove() {
	dpkg-query -W "$1" >/dev/null 2>&1 || return 0
	pkg uninstall -y "$1"
}
sync_open_packages "$STATE_DIR/packages.termux" "termux package" termux_remove

{{ else if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
	for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do
		if [ -x "$brew_path" ]; then
			eval "$("$brew_path" shellenv)"
			break
		fi
	done
fi
if ! command -v brew >/dev/null 2>&1; then
	echo "Homebrew is required for package installation" >&2
	had_errors=true
elif ! brew bundle --quiet --force-cleanup --no-upgrade --file=- <<EOF
{{ template "Brewfile" . -}}
EOF
then
	echo "Could not install Homebrew packages" >&2
	had_errors=true
fi

{{ else if eq .chezmoi.os "linux" }}
{{ if lookPath "apt-get" }}
_desired='{{ template "package/lines" (dict "ctx" . "path" (list "apt" "pkg")) }}'
_all='{{ template "package/lines-all" (dict "ctx" . "path" (list "apt" "pkg")) }}'
if ! sudo apt-get update -y; then
	echo "Could not update apt package metadata" >&2
	had_errors=true
fi
if ! sudo apt-get install -y \
    {{ template "package/args" (dict "ctx" . "path" (list "apt" "pkg")) }}
then
	echo "Could not install apt packages" >&2
	had_errors=true
fi
apt_remove() {
	dpkg-query -W "$1" >/dev/null 2>&1 || return 0
	sudo apt-get remove -y "$1"
}
sync_open_packages "$STATE_DIR/packages.apt" "apt package" apt_remove

{{ else if lookPath "pacman" }}
_desired='{{ template "package/lines" (dict "ctx" . "path" (list "pacman" "core")) }}
{{ template "package/lines" (dict "ctx" . "path" (list "pacman" "extra")) }}'
_all='{{ template "package/lines-all" (dict "ctx" . "path" (list "pacman" "core")) }}
{{ template "package/lines-all" (dict "ctx" . "path" (list "pacman" "extra")) }}'
if ! sudo pacman -Sy --needed --noconfirm \
    {{ template "package/args" (dict "ctx" . "path" (list "pacman" "core")) }} \
    {{ template "package/args" (dict "ctx" . "path" (list "pacman" "extra")) }}
then
	echo "Could not install pacman packages" >&2
	had_errors=true
fi
pacman_remove() {
	pacman -Q "$1" >/dev/null 2>&1 || return 0
	sudo pacman -Rns --noconfirm "$1"
}
sync_open_packages "$STATE_DIR/packages.pacman" "pacman package" pacman_remove
{{ end -}}

{{ else if eq .chezmoi.os "windows" }}
{{- $msysPkgs := dict "ctx" . "path" (list "msys2" "msys") -}}
{{- $ucrt64Pkgs := dict "ctx" . "path" (list "msys2" "ucrt64") "prefix" "mingw-w64-ucrt-x86_64-" -}}
{{- $scoopBuckets := dict "ctx" . "path" (list "scoop" "buckets") -}}
{{- $scoopApps := dict "ctx" . "path" (list "scoop" "apps") -}}
{{- $wingetApps := dict "ctx" . "path" (list "winget" "apps") -}}
{{ includeTemplate "script/windows-path" . }}
_desired='{{ template "package/lines" $msysPkgs }}
{{ template "package/lines" $ucrt64Pkgs }}'
_all='{{ template "package/lines-all" $msysPkgs }}
{{ template "package/lines-all" $ucrt64Pkgs }}'
if ! command -v pacman >/dev/null 2>&1; then
	echo "pacman is required for Windows packages" >&2
	had_errors=true
else
	if ! pacman -Sy --needed --noconfirm --ignore zsh,msys2-runtime,bash,pacman,filesystem \
	    {{ template "package/args" $msysPkgs }}
	then
		echo "Could not install msys packages" >&2
		had_errors=true
	fi
	if ! pacman -S --needed --noconfirm \
	    {{ template "package/args" $ucrt64Pkgs }}
	then
		echo "Could not install ucrt64 packages" >&2
		had_errors=true
	fi
	if [ "$had_errors" = false ]; then
		msys2_remove() {
			pacman -Q "$1" >/dev/null 2>&1 || return 0
			pacman -Rns --noconfirm "$1"
		}
		sync_open_packages "$STATE_DIR/packages.msys2" "msys2 package" msys2_remove
	fi
fi

_desired_scoop='{{ template "package/lines" $scoopApps }}'
_all_scoop='{{ template "package/lines-all" $scoopApps }}'
_scoop_buckets='{{ template "package/lines" $scoopBuckets }}'
if [ -n "$(printf '%s\n' "$_desired_scoop" "$_scoop_buckets" | grep -v '^$')" ]; then
	if [ ! -x "$HOME/scoop/shims/scoop" ]; then
		echo "Installing scoop"
		if ! powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Invoke-RestMethod -Uri https://get.scoop.sh -OutFile ([System.IO.Path]::GetTempPath() + 'install-scoop.ps1'); & ([System.IO.Path]::GetTempPath() + 'install-scoop.ps1') -RunAsAdmin"; then
			echo "Could not install scoop" >&2
			had_errors=true
		fi
	fi
	if [ ! -x "$HOME/scoop/shims/scoop" ]; then
		echo "Could not install scoop" >&2
		had_errors=true
	else
		export PATH="$HOME/scoop/shims:$PATH"
	fi
fi
if [ "$had_errors" = false ] && [ -n "$(printf '%s\n' "$_scoop_buckets" | grep -v '^$')" ]; then
	printf '%s\n' "$_scoop_buckets" | while IFS= read -r _bucket || [ -n "$_bucket" ]; do
		[ -z "$_bucket" ] && continue
		scoop bucket list 2>/dev/null | grep -q "$_bucket" && continue
		echo "Add scoop bucket: $_bucket"
		if ! scoop bucket add "$_bucket"; then
			echo "Could not add scoop bucket $_bucket" >&2
			exit 1
		fi
	done || had_errors=true
fi
if [ "$had_errors" = false ] && [ -n "$(printf '%s\n' "$_desired_scoop" | grep -v '^$')" ]; then
	if ! scoop install $(printf '%s\n' "$_desired_scoop" | grep -v '^$');
	then
		echo "Could not install scoop apps" >&2
		had_errors=true
	fi
	if [ "$had_errors" = false ]; then
		_desired=$_desired_scoop
		_all=$_all_scoop
		scoop_remove() {
			scoop list "$1" >/dev/null 2>&1 || return 0
			scoop uninstall "$1"
		}
		sync_open_packages "$STATE_DIR/packages.scoop" "scoop app" scoop_remove
	fi
fi

_desired_winget='{{ template "package/lines" $wingetApps }}'
_all_winget='{{ template "package/lines-all" $wingetApps }}'
winget_has() {
	_out=$(winget.exe list -e --id "$1" --disable-interactivity 2>/dev/null || true)
	case "$_out" in
	*"$1"*) return 0 ;;
	*) return 1 ;;
	esac
}
if [ -n "$(printf '%s\n' "$_desired_winget" | grep -v '^$')" ]; then
	if ! command -v winget.exe >/dev/null 2>&1; then
		echo "winget is required for Windows apps" >&2
		had_errors=true
	else
		printf '%s\n' "$_desired_winget" | while IFS= read -r _id || [ -n "$_id" ]; do
			[ -z "$_id" ] && continue
			winget_has "$_id" && continue
			echo "Install winget package: $_id"
			if ! winget.exe install --id "$_id" -e --accept-package-agreements --accept-source-agreements --disable-interactivity; then
				echo "Could not install winget package $_id" >&2
				exit 1
			fi
		done || had_errors=true
		if [ "$had_errors" = false ]; then
			_desired=$_desired_winget
			_all=$_all_winget
			winget_remove() {
				winget_has "$1" || return 0
				winget.exe uninstall --id "$1" -e --disable-interactivity --accept-source-agreements
			}
			sync_open_packages "$STATE_DIR/packages.winget" "winget package" winget_remove
		fi
	fi
fi
{{ end -}}

if [ "$had_errors" = true ]; then
	exit 1
fi

