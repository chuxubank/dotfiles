{{- if ne .chezmoi.os "windows" -}}
#!/bin/sh
set -eu

logrotate_dir={{ joinPath .path.etc "logrotate.d" | quote }}

# elevate when writing system logrotate paths
if [ ! -w "$logrotate_dir" ] 2>/dev/null; then
  SUDO="sudo"
else
  SUDO=""
fi

$SUDO mkdir -p "$logrotate_dir" \
{{- $tools := dict -}}
{{- range (includeTemplate "service/services" . | fromJson) -}}
  {{- if ne (includeTemplate "service/brew" .) "formula" -}}
  {{- $_ := set $tools .tool true -}}
  {{- end -}}
{{- end -}}
{{- range ($tools | keys | sortAlpha) }}
  {{ joinPath $.path.log . | quote }} \
{{- end }}
  {{ .path.log | quote }}

{{ range (includeTemplate "service/services" . | fromJson) -}}
{{- $logFiles := (includeTemplate "service/log-files" (dict "ctx" $ "service" .) | fromJson) -}}
{{- $stdoutOpts := dict -}}
{{- $stderrOpts := dict "rotate" "2" "interval" "weekly" -}}
{{- if hasKey . "logrotate" -}}
  {{- if hasKey .logrotate "stdout" -}}{{- $stdoutOpts = .logrotate.stdout -}}{{- end -}}
  {{- if hasKey .logrotate "stderr" -}}{{- $stderrOpts = .logrotate.stderr -}}{{- end -}}
{{- end -}}
{{ $filename := .tool -}}
{{- if not (includeTemplate "service/brew" .) -}}{{- $filename = printf "%s-%s" .tool .target -}}{{- end -}}
{{- if eq (includeTemplate "service/brew" .) "formula" }}
rm -f "$logrotate_dir/{{ $filename }}"
{{- else }}
$SUDO tee "$logrotate_dir/{{ $filename }}" >/dev/null <<'LOGROTATE'
{{ index $logFiles 0 | quote }}
{
  {{ includeTemplate "service/logrotate-directives" $stdoutOpts }}
}
{{ index $logFiles 1 | quote }}
{
  {{ includeTemplate "service/logrotate-directives" $stderrOpts }}
}
LOGROTATE
{{- end }}
{{ end -}}
{{- range (includeTemplate "service/services" (merge (dict "serviceSelect" "disabled") .) | fromJson) -}}
{{- $filename := .tool -}}
{{- if not (includeTemplate "service/brew" .) -}}{{- $filename = printf "%s-%s" .tool .target -}}{{- end }}
rm -f "$logrotate_dir/{{ $filename }}"
{{- end -}}
{{ if eq .chezmoi.os "darwin" }}
brew services restart logrotate
{{ end -}}
{{- end -}}
