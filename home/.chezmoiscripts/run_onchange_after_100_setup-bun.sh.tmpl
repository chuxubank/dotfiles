#!/bin/zsh

echo "{{ template "week" . }} 󰯁 Setup bun"

BUN_INSTALL="$HOME/{{ .path.tool.bun }}"
PATH="$BUN_INSTALL/bin:$PATH"

{{- if not (lookPath "bun") }}
curl -fsSL https://bun.sh/install | bash
{{- end }}

BUN_GLOBAL_LIST="$(bun pm ls -g 2>/dev/null || true)"
{{- $tools := includeTemplate "package/items" (dict "ctx" . "path" (list "node" "global")) | fromJson }}
DESIRED_BUN_TOOLS=(
{{- range $tool := $tools }}
  {{- if eq (kindOf $tool) "map" }}
{{ printf "  %q" $tool.name }}
  {{- else }}
{{ printf "  %q" $tool }}
  {{- end }}
{{- end }}
)

installed_bun_tools() {
    awk '
        /^[[:space:]]*[├└]── / {
            line = $0
            sub(/^[[:space:]]*[├└]── /, "", line)
            if (line ~ /^@/) {
                slash = index(line, "/")
                at = index(substr(line, slash + 1), "@")
                if (slash > 0 && at > 0) {
                    line = substr(line, 1, slash + at - 1)
                }
            } else {
                sub(/@.*$/, "", line)
            }
            print line
        }
    ' <<<"$BUN_GLOBAL_LIST"
}

bun_tool_installed() {
    local tool_name="$1"
    installed_bun_tools | grep -Fqx "$tool_name"
}

bun_tool_desired() {
    local tool_name="$1"
    local desired_tool
    for desired_tool in "${DESIRED_BUN_TOOLS[@]}"; do
        if [[ "$desired_tool" == "$tool_name" ]]; then
            return 0
        fi
    done
    return 1
}

bun upgrade

{{- range $tool := $tools }}
{{- if eq (kindOf $tool) "map" }}
{{- $install := $tool.name }}
{{- if hasKey $tool "url" }}
  {{- $install = $tool.url }}
{{- end }}
if ! bun_tool_installed {{ $tool.name | quote }}; then
echo "Install bun tool: {{ $tool.name }}"
bun add -g {{ if and (hasKey $tool "trust") $tool.trust }}--trust {{ end }}{{ $install }}
fi
{{- else }}
if ! bun_tool_installed {{ $tool | quote }}; then
echo "Install bun tool: {{ $tool }}"
bun add -g {{ $tool }}
fi
{{- end }}
{{- end }}

BUN_GLOBAL_LIST="$(bun pm ls -g 2>/dev/null || true)"

while IFS= read -r installed_tool; do
    if [[ -n "$installed_tool" ]] && ! bun_tool_desired "$installed_tool"; then
        echo "Uninstall bun tool: $installed_tool"
        bun remove -g "$installed_tool"
    fi
done < <(installed_bun_tools)

bun update -g --latest

bunx playwright install chromium

{{- if lookPath "openspec" }}
openspec completion install
{{- end }}
