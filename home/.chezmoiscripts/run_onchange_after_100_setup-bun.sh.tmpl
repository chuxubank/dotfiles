#!/bin/zsh
set -o pipefail

echo "󰯁 Setup bun"

export BUN_INSTALL="$HOME/{{ .path.tool.bun }}"
export PATH="$BUN_INSTALL/bin:$PATH"

{{- if not (lookPath "bun") }}
if ! curl -fsSL https://bun.sh/install | bash; then
    print -u2 -- "Could not install bun"
    exit 1
fi
{{- end }}

{{ includeTemplate "script/reconcile" }}

{{- $tools := includeTemplate "package/items" (dict "ctx" . "path" (list "node" "global")) | fromJson }}
declared_bun=(
{{- template "package/list" (dict "ctx" . "path" (list "node" "global")) }}
)
installed_bun=()
cleanup_enabled=true
inventory_ready=true
had_errors=false

load_installed_bun() {
    local package_json="$BUN_INSTALL/install/global/package.json"
    if [[ ! -f $package_json ]]; then
        installed_bun=()
        inventory_ready=true
        return 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
        print -u2 -- "jq is required to read installed bun tools; skipping bun reconciliation"
        cleanup_enabled=false
        had_errors=true
        inventory_ready=false
        installed_bun=()
        return 1
    fi

    if ! jq -e '(.dependencies // {}) | type == "object"' >/dev/null < "$package_json"; then
        print -u2 -- "Could not parse installed bun tools; skipping bun reconciliation"
        cleanup_enabled=false
        had_errors=true
        inventory_ready=false
        installed_bun=()
        return 1
    fi

    installed_bun=()
    local line
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -n $line ]] && installed_bun+=("$line")
    done < <(jq -r '.dependencies // {} | keys[]' "$package_json")
    inventory_ready=true
}

bun_tool_installed() {
    local tool_name="$1"
    (( ${installed_bun[(Ie)$tool_name]} ))
}

# bun remove -g rewrites package.json/lockfile but leaves optional native
# packages in the shared global node_modules. That tree is not tool-owned,
# so it cannot go on tools.yaml purge; drop names absent from the lockfile.
prune_bun_global_leftovers() {
    setopt local_options null_glob
    local global_dir="$BUN_INSTALL/install/global"
    local nm="$global_dir/node_modules"
    local lock="$global_dir/bun.lock"
    local name child scope
    local -a keep

    $cleanup_enabled || return 0
    [[ -d $nm && -f $lock ]] || return 0

    keep=()
    while IFS= read -r name; do
        [[ -n $name ]] && keep+=("$name")
    done < <(awk '
      /^    "[^"]+": \[/ {
        n = $0
        sub(/^    "/, "", n)
        sub(/": \[.*/, "", n)
        if (n ~ /^@/) {
          rest = n
          sub(/^@[^\/]+\//, "", rest)
          if (rest == n || rest ~ /\//) next
        } else if (n ~ /\//) next
        print n
      }
    ' "$lock")

    if (( ${#keep[@]} == 0 )); then
        print -u2 -- "Could not parse bun lockfile packages; skipping leftover prune"
        had_errors=true
        return 1
    fi

    for child in "$nm"/*; do
        [[ -e $child ]] || continue
        name="${child##*/}"
        [[ $name == .* || $name == @* ]] && continue
        if (( ! ${keep[(Ie)$name]} )); then
            echo "Removing leftover bun package: $name"
            rm -rf "$child" || had_errors=true
        fi
    done
    for scope in "$nm"/@*; do
        [[ -d $scope ]] || continue
        for child in "$scope"/*; do
            [[ -e $child ]] || continue
            name="${scope##*/}/${child##*/}"
            if (( ! ${keep[(Ie)$name]} )); then
                echo "Removing leftover bun package: $name"
                rm -rf "$child" || had_errors=true
            fi
        done
        rmdir "$scope" 2>/dev/null || true
    done
}

load_installed_bun || true

if $inventory_ready; then
{{- range $tool := $tools }}
{{- if eq (kindOf $tool) "map" }}
{{- $install := $tool.name }}
{{- if hasKey $tool "url" }}
  {{- $install = $tool.url }}
{{- end }}
if ! bun_tool_installed {{ $tool.name | quote }}; then
echo "Install bun tool: {{ $tool.name }}"
if ! bun add -g {{ if and (hasKey $tool "trust") $tool.trust }}--trust {{ end }}{{ $install }}; then
  had_errors=true
fi
fi
{{- else }}
if ! bun_tool_installed {{ $tool | quote }}; then
echo "Install bun tool: {{ $tool }}"
if ! bun add -g {{ $tool }}; then
  had_errors=true
fi
fi
{{- end }}
{{- end }}
fi

load_installed_bun || true
if $inventory_ready; then
  remove_undeclared cleanup_enabled installed_bun declared_bun \
    'bun tool' bun remove -g
  prune_bun_global_leftovers
fi

{{- if lookPath "openspec" }}
openspec completion install
{{- end }}

if $had_errors; then
  exit 1
fi
