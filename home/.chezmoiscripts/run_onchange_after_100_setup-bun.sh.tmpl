#!/bin/zsh

echo "{{ template "week" . }} 󰯁 Setup bun"

BUN_INSTALL="$HOME/{{ .path.tool.bun }}"
PATH="$BUN_INSTALL/bin:$PATH"

{{- if not (lookPath "bun") }}
curl -fsSL https://bun.sh/install | bash
{{- end }}

{{ includeTemplate "script/reconcile" }}

{{- $tools := includeTemplate "package/items" (dict "ctx" . "path" (list "node" "global")) | fromJson }}
declared_bun=(
{{- template "package/list" (dict "ctx" . "path" (list "node" "global")) }}
)
installed_bun=()
cleanup_enabled=true
had_errors=false

parse_bun_globals() {
    awk '
        /^[[:space:]]*[├└]── / {
            line = $0
            sub(/^[[:space:]]*[├└]── /, "", line)
            if (line ~ /^@/) {
                slash = index(line, "/")
                at = index(substr(line, slash + 1), "@")
                if (slash > 0 && at > 0) {
                    line = substr(line, 1, slash + at - 1)
                }
            } else {
                sub(/@.*$/, "", line)
            }
            print line
        }
    '
}

load_installed_bun() {
    local listing
    if [[ ! -f $BUN_INSTALL/install/global/package.json ]]; then
        installed_bun=()
        return 0
    fi
    if ! listing=$(bun pm ls -g); then
        print -u2 -- "Could not list installed bun tools; skipping undeclared cleanup"
        cleanup_enabled=false
        had_errors=true
        installed_bun=()
        return 1
    fi
    installed_bun=(${(f)$(parse_bun_globals <<<"$listing")})
    installed_bun=(${installed_bun:#})
}

bun_tool_installed() {
    local tool_name="$1"
    (( ${installed_bun[(Ie)$tool_name]} ))
}

load_installed_bun || true

bun upgrade

{{- range $tool := $tools }}
{{- if eq (kindOf $tool) "map" }}
{{- $install := $tool.name }}
{{- if hasKey $tool "url" }}
  {{- $install = $tool.url }}
{{- end }}
if ! bun_tool_installed {{ $tool.name | quote }}; then
echo "Install bun tool: {{ $tool.name }}"
bun add -g {{ if and (hasKey $tool "trust") $tool.trust }}--trust {{ end }}{{ $install }}
fi
{{- else }}
if ! bun_tool_installed {{ $tool | quote }}; then
echo "Install bun tool: {{ $tool }}"
bun add -g {{ $tool }}
fi
{{- end }}
{{- end }}

load_installed_bun || true
remove_undeclared cleanup_enabled installed_bun declared_bun \
  'bun tool' bun remove -g

bun update -g --latest

bunx playwright install chromium

{{- if lookPath "openspec" }}
openspec completion install
{{- end }}

if $had_errors; then
  exit 1
fi
