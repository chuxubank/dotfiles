#!/bin/zsh

echo "󰯁 Setup bun"

export BUN_INSTALL="$HOME/{{ .path.tool.bun }}"
export PATH="$BUN_INSTALL/bin:$PATH"

{{- if not (lookPath "bun") }}
curl -fsSL https://bun.sh/install | bash
{{- end }}

{{ includeTemplate "script/reconcile" }}

{{- $tools := includeTemplate "package/items" (dict "ctx" . "path" (list "node" "global")) | fromJson }}
declared_bun=(
{{- template "package/list" (dict "ctx" . "path" (list "node" "global")) }}
)
installed_bun=()
cleanup_enabled=true
inventory_ready=true
had_errors=false

load_installed_bun() {
    local package_json="$BUN_INSTALL/install/global/package.json"
    if [[ ! -f $package_json ]]; then
        installed_bun=()
        inventory_ready=true
        return 0
    fi

    if ! command -v jq >/dev/null 2>&1; then
        print -u2 -- "jq is required to read installed bun tools; skipping bun reconciliation"
        cleanup_enabled=false
        had_errors=true
        inventory_ready=false
        installed_bun=()
        return 1
    fi

    if ! jq -e '(.dependencies // {}) | type == "object"' >/dev/null < "$package_json"; then
        print -u2 -- "Could not parse installed bun tools; skipping bun reconciliation"
        cleanup_enabled=false
        had_errors=true
        inventory_ready=false
        installed_bun=()
        return 1
    fi

    installed_bun=()
    local line
    while IFS= read -r line || [[ -n $line ]]; do
        [[ -n $line ]] && installed_bun+=("$line")
    done < <(jq -r '.dependencies // {} | keys[]' "$package_json")
    inventory_ready=true
}

bun_tool_installed() {
    local tool_name="$1"
    (( ${installed_bun[(Ie)$tool_name]} ))
}

load_installed_bun || true

if $inventory_ready; then
{{- range $tool := $tools }}
{{- if eq (kindOf $tool) "map" }}
{{- $install := $tool.name }}
{{- if hasKey $tool "url" }}
  {{- $install = $tool.url }}
{{- end }}
if ! bun_tool_installed {{ $tool.name | quote }}; then
echo "Install bun tool: {{ $tool.name }}"
bun add -g {{ if and (hasKey $tool "trust") $tool.trust }}--trust {{ end }}{{ $install }}
fi
{{- else }}
if ! bun_tool_installed {{ $tool | quote }}; then
echo "Install bun tool: {{ $tool }}"
bun add -g {{ $tool }}
fi
{{- end }}
{{- end }}
fi

load_installed_bun || true
if $inventory_ready; then
  remove_undeclared cleanup_enabled installed_bun declared_bun \
    'bun tool' bun remove -g
fi

{{- if lookPath "openspec" }}
openspec completion install
{{- end }}

if $had_errors; then
  exit 1
fi
