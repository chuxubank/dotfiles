{{ if and (ne .host_env "ci") (ne .chezmoi.os "windows") -}}
#!/usr/bin/env zsh

echo "{{ template "time/week" . }} 󰯁 Upgrade Go binaries"

source "$HOME/.zshenv"
export PATH="${GOBIN:+$GOBIN:}$HOME/.local/bin:$PATH"

if command -v gup >/dev/null; then
  gup update || print -u2 -- "Could not upgrade Go binaries"
fi
{{ end -}}
