{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env zsh
set -o pipefail

echo "󰯁 Setup sdkman"

if [[ -e $HOME/.zshenv ]] && ! source "$HOME/.zshenv"; then
  print -u2 -- "Could not source $HOME/.zshenv"
  exit 1
fi
export SDKMAN_DIR="${SDKMAN_DIR:-$HOME/{{ .path.tool.sdkman }}}"

case "$SDKMAN_DIR" in
    "$HOME"|/|""|.|..|*/../*|*/..|~*|[^/]*)
        print -u2 -- "Refusing to remove unsafe SDKMAN_DIR: ${SDKMAN_DIR:-<empty>}"
        exit 1
        ;;
esac

{{ includeTemplate "script/reconcile" }}

SDKMAN_INIT="$SDKMAN_DIR/bin/sdkman-init.sh"

if [ ! -s "$SDKMAN_INIT" ]; then
    if ! rm -rf -- "$SDKMAN_DIR"; then
        print -u2 -- "Could not remove incomplete sdkman directory: $SDKMAN_DIR"
        exit 1
    fi
    if ! curl -fsSL "https://get.sdkman.io?rcupdate=false" | bash; then
        print -u2 -- "Could not install sdkman"
        exit 1
    fi
fi

if [[ ! -s $SDKMAN_INIT ]]; then
    print -u2 -- "sdkman init script is missing after installation"
    exit 1
fi
if ! source "$SDKMAN_INIT"; then
  print -u2 -- "Could not source sdkman init script"
  exit 1
fi

{{- $items := includeTemplate "package/items" (dict "ctx" . "path" (list "sdkman")) | fromJson }}
declared_sdk=(
{{- template "package/list" (dict "ctx" . "path" (list "sdkman")) }}
)
installed_sdk=()
cleanup_enabled=true
had_errors=false

{{- range $sdk := $items }}
{{- if eq (kindOf $sdk) "map" }}
if ! sdk install {{ $sdk.name }}{{- with index $sdk "version" }} {{ . }}{{ end }}; then
  had_errors=true
fi
{{- else }}
if ! sdk install {{ $sdk }}; then
  had_errors=true
fi
{{- end }}
{{- end }}

sdk_uninstall_candidate() {
  local cand=$1
  local dir="$SDKMAN_DIR/candidates/$cand"
  local ver
  if [[ ! -d $dir ]]; then
    return 0
  fi
  for ver in "$dir"/*(N); do
    [[ ${ver:t} == current ]] && continue
    [[ -d $ver ]] || continue
    echo "Uninstall sdk $cand ${ver:t}"
    sdk uninstall "$cand" "${ver:t}" || return 1
  done
}

if [[ -d $SDKMAN_DIR/candidates ]]; then
  installed_sdk=("$SDKMAN_DIR"/candidates/*(N:t))
else
  print -u2 -- "Could not list installed sdkman candidates; skipping undeclared cleanup"
  cleanup_enabled=false
  had_errors=true
fi

remove_undeclared cleanup_enabled installed_sdk declared_sdk \
  'sdkman candidate' sdk_uninstall_candidate

if $cleanup_enabled; then
  for cand in "${declared_sdk[@]}"; do
    current=$(readlink "$SDKMAN_DIR/candidates/$cand/current" 2>/dev/null) || continue
    for ver in "$SDKMAN_DIR/candidates/$cand"/*(N); do
      [[ ${ver:t} == current || ${ver:t} == $current ]] && continue
      [[ -d $ver ]] || continue
      echo "Uninstall extra sdk $cand ${ver:t}"
      if ! sdk uninstall "$cand" "${ver:t}"; then
        had_errors=true
      fi
    done
  done
fi

if ! sdk flush; then
  had_errors=true
fi

if $had_errors; then
  exit 1
fi
{{- end -}}
