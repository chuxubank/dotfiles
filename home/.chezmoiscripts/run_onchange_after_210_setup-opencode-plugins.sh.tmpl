#!/usr/bin/env zsh

echo "{{ template "week" . }} 󰯁 Setup opencode plugins"

export BUN_INSTALL="$HOME/{{ .path.tool.bun }}"
export PATH="$BUN_INSTALL/bin:$PATH"

if ! command -v ocx >/dev/null 2>&1; then
    echo "ocx is not installed; skipping opencode plugin setup."
    exit 0
fi

ocx init --global >/dev/null
ocx add kdco/notify --from https://registry.kdco.dev --global
