{{ if eq .chezmoi.os "darwin" -}}
#!/bin/zsh

# Symlink stdc++.h from Homebrew GCC into Clang include paths.
STDCXX_SRC=$(find "$(brew --prefix gcc)/include" -name "stdc++.h" 2>/dev/null | head -1)
if [[ -z "$STDCXX_SRC" ]]; then
  echo "stdc++.h not found in Homebrew GCC, skipping"
  exit 0
fi

for dir in \
  "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/include/c++/v1/bits" \
  "{{ .path.usr }}/opt/llvm/include/c++/v1/bits"; do
  [[ -d "$dir" ]] && sudo ln -sf "$STDCXX_SRC" "$dir/stdc++.h"
done
{{ end -}}
