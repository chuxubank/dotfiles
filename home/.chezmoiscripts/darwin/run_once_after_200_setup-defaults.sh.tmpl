{{ if eq .chezmoi.os "darwin" -}}
#!/bin/zsh
defaults write com.apple.Maps AppleLanguages '("zh_CN")'
defaults write com.apple.finder RelativeDates -bool false
defaults write com.mowglii.ItsycalApp ShowDayOfWeekInIcon -bool YES
