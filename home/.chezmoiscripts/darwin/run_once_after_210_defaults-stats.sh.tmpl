{{ if eq .chezmoi.os "darwin" -}}
#!/bin/zsh
# ~/Library/Preferences/eu.exelban.Stats.plist
defaults write eu.exelban.Stats.plist Battery_state -bool NO
defaults write eu.exelban.Stats.plist CPU_line_chart_label -bool YES
defaults write eu.exelban.Stats.plist CPU_widget -string "line_chart"
defaults write eu.exelban.Stats.plist Disk_removable -bool YES
defaults write eu.exelban.Stats.plist Disk_widget -string "bar_chart"
defaults write eu.exelban.Stats.plist GPU_line_chart_label -bool YES
{{- if has "llm" .roles }}
defaults write eu.exelban.Stats.plist GPU_state -bool YES
{{- end}}
defaults write eu.exelban.Stats.plist GPU_widget -string "line_chart"
defaults write eu.exelban.Stats.plist LaunchAtLoginNext -bool YES
defaults write eu.exelban.Stats.plist Network_widget -string "speed"
defaults write eu.exelban.Stats.plist RAM_bar_chart_label -bool YES
defaults write eu.exelban.Stats.plist RAM_combinedProcesses -bool YES
defaults write eu.exelban.Stats.plist RAM_processes -int 15
defaults write eu.exelban.Stats.plist RAM_splitValue -bool YES
defaults write eu.exelban.Stats.plist RAM_widget -string "bar_chart"
defaults write eu.exelban.Stats.plist SSD_bar_chart_label -bool YES
{{ end -}}
