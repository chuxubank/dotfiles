{{ if eq .chezmoi.os "darwin" -}}
#!/bin/zsh

{{ if includeTemplate "tool/enabled" (merge (dict "tool" "kiro-cli") .) | fromJson -}}
if ! kiro-cli integrations install input-method; then
    print -u2 -- "Could not install Kiro input-method integration"
    exit 1
fi
{{ else -}}
# Shared-tree leftovers brew uninstall does not remove. Exclusive trees
# are in tools.yaml purge.
if ! rm -f "${HOME}/Library/Input Methods/CodeWhispererInputMethod.app"; then
    print -u2 -- "Could not remove CodeWhisperer input method"
    exit 1
fi
if ! rm -f "${HOME}/.local/bin/kiro-cli" "${HOME}/.local/bin/kiro-cli-chat"; then
    print -u2 -- "Could not remove Kiro CLI links"
    exit 1
fi
{{- end }}
{{ end -}}
