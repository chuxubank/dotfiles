#!/usr/bin/env zsh

echo "{{ template "week" . }} 󰯁 Setup skills"

export BUN_INSTALL="$HOME/{{ .path.tool.bun }}"
export PATH="$BUN_INSTALL/bin:$PATH"

{{ includeTemplate "script/reconcile" }}

declared=()
updateable=()
installed=()
cleanup_enabled=true
had_errors=false

json_names_load installed \
  'skills list -g --json' \
  'type == "array"' \
  '.[].path | split("/")[-1]' \
  cleanup_enabled \
  'skills'

skills_state_dir=$(mktemp -d) || exit 1
trap 'rm -rf "$skills_state_dir"' EXIT

skill_name_is_pattern() {
  [[ "$1" == *[\*\?\[]* ]]
}

skill_name_matches() {
  local skill_name="$1"
  local pattern="$2"

  [[ "$skill_name" = ${~pattern} ]]
}

list_source_skills() {
  local source="$1"
  local full_depth="$2"
  local -a depth_args=()
  local output clean_output listing

  if [[ "$full_depth" == true ]]; then
    depth_args+=(--full-depth)
  fi

  if ! output=$(NO_COLOR=1 skills add "$source" --list "${depth_args[@]}" 2>&1); then
    print -u2 -r -- "$output"
    return 1
  fi

  # `skills add --list` emits ANSI color codes even when NO_COLOR is set.
  # Strip all CSI escape sequences before parsing the indented skill names.
  clean_output=$(print -r -- "$output" | sed $'s/\033\\[[0-9;?]*[ -\\/]*[@-~]//g')
  listing=$(print -r -- "$clean_output" | sed -n 's/^│    \([^ ].*\)$/\1/p')
  if [[ -z "$listing" ]]; then
    print -u2 -r -- "$output"
    print -u2 -- "Could not parse the skill list for $source"
    return 1
  fi

  print -r -- "$listing"
}

resolve_skill_names() {
  local source="$1"
  local full_depth="$2"
  shift 2
  local -a patterns=("$@")
  local -a available=()
  local -a resolved=()
  local pattern skill_name listing

  for pattern in "${patterns[@]}"; do
    if skill_name_is_pattern "$pattern"; then
      if (( ! ${#available[@]} )); then
        listing=$(list_source_skills "$source" "$full_depth") || return 1
        available=("${(@f)listing}")
      fi
      for skill_name in "${available[@]}"; do
        if skill_name_matches "$skill_name" "$pattern" && (( ! ${resolved[(Ie)$skill_name]} )); then
          resolved+=("$skill_name")
        fi
      done
    elif (( ! ${resolved[(Ie)$pattern]} )); then
      resolved+=("$pattern")
    fi
  done

  print -rl -- "${resolved[@]}"
}

skill_has_agent() {
  local skill_name="$1"
  local agent_slug="$2"
  local agent_state="$skills_state_dir/$agent_slug.json"
  local agent_state_tmp="$agent_state.tmp"

  if [[ ! -f "$agent_state" ]]; then
    if ! skills list -g --json --agent "$agent_slug" > "$agent_state_tmp"; then
      print -u2 -- "Could not list skills for agent $agent_slug"
      return 2
    fi
    if ! jq -e 'type == "array"' >/dev/null < "$agent_state_tmp"; then
      print -u2 -- "skills list returned invalid JSON for agent $agent_slug"
      return 2
    fi
    if ! mv "$agent_state_tmp" "$agent_state"; then
      print -u2 -- "Could not cache skills for agent $agent_slug"
      return 2
    fi
  fi

  jq -e --arg skill_name "$skill_name" \
    'any(.[]; ((.path // "") | split("/")[-1]) == $skill_name)' \
    >/dev/null < "$agent_state"
}

{{- range $skill := includeTemplate "skills/providers" . | fromJson }}
  {{- $agents := includeTemplate "skills/when" (merge (dict "skill" $skill) $) | fromJson }}
  {{- if gt (len $agents) 0 }}
  {{- /* `skills update` loses repository subpaths and can report nested skills as deleted. */ -}}
  {{- $directSource := eq (len (splitList "/" $skill.source)) 2 }}

# {{ $skill.source }}
patterns=({{- if kindIs "slice" $skill.name }}{{ range $i, $name := $skill.name }}{{ if $i }} {{ end }}{{ $name | quote }}{{ end }}{{ else }}{{ $skill.name | quote }}{{ end }})
full_depth={{ if and (hasKey $skill "full_depth") $skill.full_depth }}true{{ else }}false{{ end }}
if ! resolved_output=$(resolve_skill_names {{ $skill.source | quote }} "$full_depth" "${patterns[@]}"); then
  cleanup_enabled=false
  had_errors=true
  print -u2 -- "Could not resolve ${patterns[*]} in {{ $skill.source }}; skipping undeclared-skill cleanup"
else
  resolved=(${(f)resolved_output})
  for name in "${resolved[@]}"; do
    if (( ! ${declared[(Ie)$name]} )); then
      declared+=("$name")
    fi
    {{- if $directSource }}
    if (( ! ${updateable[(Ie)$name]} )); then
      updateable+=("$name")
    fi
    {{- end }}
  done

  if (( ! ${#resolved[@]} )); then
    print -u2 -- "No skills matched ${patterns[*]} in {{ $skill.source }}"
    cleanup_enabled=false
    had_errors=true
  else
    needs_install=false
    state_ok=true
    skill_args=()
    if $full_depth; then
      skill_args+=(--full-depth)
    fi
    if (( ${#patterns[@]} == 1 )) && [[ ${patterns[1]} == '*' ]]; then
      skill_args+=(--skill '*')
    else
      for name in "${resolved[@]}"; do
        skill_args+=(--skill "$name")
      done
    fi

    for name in "${resolved[@]}"; do
      for agent in {{ range $i, $agent := $agents }}{{ if $i }} {{ end }}{{ $agent | quote }}{{ end }}; do
        skill_has_agent "$name" "$agent"
        skill_status=$?
        if (( skill_status == 0 )); then
          continue
        fi

        if (( skill_status == 1 )); then
          needs_install=true
        else
          state_ok=false
          cleanup_enabled=false
          had_errors=true
        fi
        break 2
      done
    done

    if $state_ok && $needs_install; then
      if ! skills add {{ $skill.source }} \
        --global --yes \
        "${skill_args[@]}" \
        --agent {{ join " " $agents }}; then
        cleanup_enabled=false
        had_errors=true
      fi
    fi
  fi
fi
  {{ end }}
{{- end }}

remove_undeclared cleanup_enabled installed declared \
  'skill' skills remove {} -g --yes


if (( ${#updateable[@]} )); then
  if ! skills update -g "${updateable[@]}"; then
    had_errors=true
  fi
fi

if $had_errors; then
  exit 1
fi
