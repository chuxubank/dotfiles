#!/usr/bin/env zsh

echo "{{ template "week" . }} 󰯁 Setup skills"

{{- range $skill := .skills.providers }}
  {{- $agents := includeTemplate "skills/when" (dict
    "skill" $skill
    "host_env" $.host_env
    "device_type" $.device_type
    "roles" $.roles
    "agents" $.skills.agents
  ) | fromJson }}
  {{- if gt (len $agents) 0 }}
skills add {{ $skill.source }} \
  --global --yes \
  --skill {{ $skill.name | quote }} \
  --agent {{ join " " $agents }}
  {{- end }}
{{- end }}

skills check
