#!/usr/bin/env zsh

echo "{{ template "week" . }} 󰯁 Setup skills"

{{- /* Collect all declared skill names */ -}}
{{- $declared := list -}}
{{- range $skill := .skills.providers }}
  {{- $agents := includeTemplate "skills/when" (merge (dict "skill" $skill) $) | fromJson }}
  {{- if gt (len $agents) 0 }}
    {{- if kindIs "slice" $skill.name }}
      {{- range $name := $skill.name }}
        {{- $declared = append $declared $name -}}
      {{- end }}
    {{- else }}
      {{- $declared = append $declared $skill.name -}}
    {{- end }}
  {{- end }}
{{- end }}

declared=({{ range $i, $name := $declared }}{{ if $i }} {{ end }}{{ $name | quote }}{{ end }})
installed_json=$(skills list -g --json)
skills_state_dir=$(mktemp -d)
trap 'rm -rf "$skills_state_dir"' EXIT

skill_has_agent() {
  local skill_name="$1"
  local agent_slug="$2"
  local agent_state="$skills_state_dir/$agent_slug.json"

  if [[ ! -f "$agent_state" ]]; then
    skills list -g --json --agent "$agent_slug" > "$agent_state"
  fi

  jq -e --arg skill_name "$skill_name" 'any(.[]; .name == $skill_name)' \
    >/dev/null < "$agent_state"
}

{{- range $skill := .skills.providers }}
  {{- $agents := includeTemplate "skills/when" (merge (dict "skill" $skill) $) | fromJson }}
  {{- if gt (len $agents) 0 }}

# {{ $skill.source }}
  {{- if kindIs "slice" $skill.name }}
if {{- range $nameIndex, $name := $skill.name }}{{ range $agentIndex, $agent := $agents }}{{ if or $nameIndex $agentIndex }} ||{{ end }} ! skill_has_agent {{ $name | quote }} {{ $agent | quote }}{{ end }}{{ end }}; then
  {{- else }}
if {{- range $i, $agent := $agents }}{{ if $i }} ||{{ end }} ! skill_has_agent {{ $skill.name | quote }} {{ $agent | quote }}{{ end }}; then
  {{- end }}
  skills add {{ $skill.source }} \
    --global --yes \
  {{- if kindIs "slice" $skill.name }}
    {{- range $i, $name := $skill.name }}
    --skill {{ $name | quote }} \
    {{- end -}}
  {{- else }}
    --skill {{ $skill.name | quote }} \
  {{- end }}
    --agent {{ join " " $agents }}
fi
  {{ end }}
{{- end }}

# Uninstall skills not declared in config
installed=($(jq -r '.[].name' <<<"$installed_json"))

for name in "${installed[@]}"; do
  if (( ! ${declared[(Ie)$name]} )); then
    echo "Removing undeclared skill: $name"
    skills remove "$name" -g --yes
  fi
done

skills update -g
