#!/bin/bash

echo "{{ template "week" . }} 󰯁 Setup uv"

{{- if not (lookPath "uv") }}
curl -LsSf https://astral.sh/uv/install.sh | sh
source $HOME/.local/bin/env
{{- else }}
if ! brew list uv &>/dev/null; then
    uv self update | true
fi
{{- end }}

{{ range $tool := .packages.python.tools -}}
  {{- if eq (kindOf $tool) "map" -}}
    {{- $enabled := true -}}
    {{- if hasKey $tool "when" -}}
      {{- $enabled = includeTemplate "when/context" (merge (dict "item" $tool) $) | fromJson -}}
    {{- end -}}
    {{- if $enabled }}
uv tool install{{- if (and (index $tool "force") true) }} --force{{- end }}
      {{- with index $tool "version" }} --python python{{ . }}{{ end }}
	  {{- with index $tool "with" }} --with {{.}}{{ end }}
	  {{- with index $tool "with-exec" }} --with-executables-from {{.}}{{ end }}
	  {{- if hasKey $tool "extra" -}}
	    {{- printf " %s[%s]" $tool.name $tool.extra }}
	  {{- else }}
	    {{- printf " %s" $tool.name }}
	  {{- end }} --upgrade
    {{- else }}
uv tool uninstall {{ $tool.name }}
    {{- end }}
  {{- else }}
uv tool install {{ $tool }} --upgrade
  {{- end }}
{{- end }}

uv tool upgrade --all
