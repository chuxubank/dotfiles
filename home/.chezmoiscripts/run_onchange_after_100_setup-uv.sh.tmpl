#!/bin/bash

echo "{{ template "week" . }} 󰯁 Setup uv"

{{- if not (lookPath "uv") }}
curl -LsSf https://astral.sh/uv/install.sh | sh
source $HOME/.local/bin/env
{{- else }}
if ! brew list uv &>/dev/null; then
    uv self update | true
fi
{{- end }}

UV_TOOL_LIST="$(uv tool list 2>/dev/null || true)"
{{- $tools := includeTemplate "package-items" (dict "ctx" . "path" (list "python" "tools")) | fromJson }}
DESIRED_UV_TOOLS=(
{{- template "package-list" (dict "ctx" . "path" (list "python" "tools")) }}
)

installed_uv_tools() {
    awk 'NF && $1 != "-" { print $1 }' <<<"$UV_TOOL_LIST"
}

uv_tool_installed() {
    local tool_name="$1"
    installed_uv_tools | grep -Fqx "$tool_name"
}

uv_tool_desired() {
    local tool_name="$1"
    local desired_tool
    for desired_tool in "${DESIRED_UV_TOOLS[@]}"; do
        if [[ "$desired_tool" == "$tool_name" ]]; then
            return 0
        fi
    done
    return 1
}

{{ range $tool := $tools }}
  {{ if eq (kindOf $tool) "map" -}}
if ! uv_tool_installed {{ $tool.name | quote }}; then
echo "Install uv tool: {{ $tool.name }}"
uv tool install{{- if (and (index $tool "force") true) }} --force{{- end }}
      {{- with index $tool "version" }} --python python{{ . }}{{ end }}
	  {{- with index $tool "with" }} --with {{.}}{{ end }}
	  {{- with index $tool "with-exec" }} --with-executables-from {{.}}{{ end }}
	  {{- if hasKey $tool "extra" -}}
	    {{- printf " %s[%s]" $tool.name $tool.extra }}
	  {{- else }}
	    {{- printf " %s" $tool.name }}
	  {{- end }} --upgrade
fi
  {{ else }}
if ! uv_tool_installed {{ $tool | quote }}; then
echo "Install uv tool: {{ $tool }}"
uv tool install {{ $tool }} --upgrade
fi
  {{ end }}
{{- end }}

while IFS= read -r installed_tool; do
    if [[ -n "$installed_tool" ]] && ! uv_tool_desired "$installed_tool"; then
        echo "Uninstall uv tool: $installed_tool"
        uv tool uninstall "$installed_tool"
    fi
done < <(installed_uv_tools)

uv tool upgrade --all
