#!/bin/sh

{{- $plum_dir :=  joinPath .chezmoi.homeDir .path.tool.plum }}
{{- if not (stat $plum_dir) }}

echo "󰯁 Skip rime: {{ $plum_dir }} is not installed yet"
{{- else }}

had_errors=false

{{- if eq .chezmoi.os "darwin" }}
echo "󰯁 Update librime for Emacs usage"
export rime_dir={{ joinPath .chezmoi.homeDir .path.data.rime }}
if ! bash {{ joinPath $plum_dir "rime-install" }} double-pinyin; then
	had_errors=true
fi
if ! bash {{ joinPath $plum_dir "rime-install" }} emoji:customize:schema=luna_pinyin; then
	had_errors=true
fi
if ! bash {{ joinPath $plum_dir "rime-install" }} emoji:customize:schema=double_pinyin_flypy; then
	had_errors=true
fi
{{- end }}

echo "󰯁 Update rime with {{ output "git" "-C" $plum_dir "rev-parse" "HEAD" }}"
export rime_dir=""
if ! bash {{ joinPath $plum_dir "rime-install" }} iDvel/rime-ice:others/recipes/full; then
	had_errors=true
fi
if ! bash {{ joinPath $plum_dir "rime-install" }} iDvel/rime-ice:others/recipes/config:schema=flypy; then
	had_errors=true
fi

if [ "$had_errors" = true ]; then
	exit 1
fi
{{- end }}
