#!/bin/zsh

echo "{{ template "week" . }} 󰯁 Setup rust"

rustup default stable

rustup update stable

rustup component add rust-analyzer

{{- $tools := includeTemplate "package/items" (dict "ctx" . "path" (list "rust" "cargo")) | fromJson }}
{{- range $tool := $tools }}
{{- if eq (kindOf $tool) "map" }}
cargo install{{- if (and (index $tool "force") true) }} --force{{- end }}{{- with index $tool "version" }} --version {{ . }}{{ end }}{{- with index $tool "git" }} --git {{.}}{{ end }} {{- with index $tool "rev" }} --rev {{.}}{{ end }}{{- with index $tool "features" }} --features {{.}}{{ end }} {{ $tool.name }}
{{- else }}
cargo install {{ $tool }}
{{- end }}
{{- end }}

cargo install-update -a -g
