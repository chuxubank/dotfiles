#!/usr/bin/env zsh

echo "󰯁 Setup rust"

# zsh loads ~/.zshenv, which provides Rust paths from environment.yaml.
: "${CARGO_HOME:?Rust environment missing from ~/.zshenv}"
: "${RUSTUP_HOME:?Rust environment missing from ~/.zshenv}"

{{ includeTemplate "script/reconcile" }}

had_errors=false
if ! rustup default stable; then
  had_errors=true
fi
if ! rustup component add rust-analyzer; then
  had_errors=true
fi

{{- if ne .chezmoi.os "windows" -}}
{{- $tools := includeTemplate "package/items" (dict "ctx" . "path" (list "rust" "cargo")) | fromJson }}
declared_cargo=(
{{- template "package/list" (dict "ctx" . "path" (list "rust" "cargo")) }}
)
installed_cargo=()
cleanup_enabled=true

typeset -A cargo_install_lines
if command -v cargo >/dev/null; then
  if listing=$(cargo install --list); then
    installed_cargo=()
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == [[:space:]]* || -z $line ]] && continue
      _cargo_name="${line%% *}"
      installed_cargo+=("$_cargo_name")
      cargo_install_lines[$_cargo_name]="$line"
    done <<<"$listing"
  else
    print -u2 -- "Could not list installed cargo crates; skipping undeclared cleanup"
    cleanup_enabled=false
    had_errors=true
  fi
else
  print -u2 -- "cargo is not installed; skipping undeclared cleanup"
  cleanup_enabled=false
  had_errors=true
fi

# The list entry records the git branch from the install that wrote it.
# This script re-runs when the declaration changes, but cargo keeps that
# branch until the install is forced.
cargo_source_current() {
  local name="$1" git="$2" branch="$3"
  local spec="${cargo_install_lines[$name]:-}" decoded
  [[ -n $spec ]] || return 1
  [[ -z $git ]] && return 0
  [[ $spec == *"${git%.git}"* ]] || return 1
  [[ -z $branch ]] && return 0
  decoded="${spec//\%2F//}"
  decoded="${decoded//\%2f//}"
  [[ $decoded == *"branch=${branch}#"* || $decoded == *"branch=${branch})"* ]]
}

# CI restores CARGO_HOME/bin without .crates.toml, so `cargo install --list`
# misses crates whose binaries are already on disk. Treat that as installed.
# A recorded source that differs must be forced, or cargo keeps the old branch
# and the already-exists fallback accepts it.
install_cargo_crate() {
  local crate="$1"
  shift
  local output
  local -a args=("$@")
  if [[ -n ${cargo_install_lines[$crate]:-} ]]; then
    args=(--force "${args[@]}")
  fi
  if output=$(cargo install "${args[@]}" "$crate" 2>&1); then
    print -- "$output"
    return 0
  fi
  print -- "$output"
  if [[ $output == *"already exists in destination"* ]]; then
    print -u2 -- "cargo crate $crate binaries already present; treating as installed"
    return 0
  fi
  return 1
}

{{- range $tool := $tools }}
{{- if eq (kindOf $tool) "map" }}
if ! cargo_source_current {{ $tool.name | quote }} {{ with index $tool "git" }}{{ . | quote }}{{ else }}""{{ end }} {{ with index $tool "branch" }}{{ . | quote }}{{ else }}""{{ end }}; then
echo "Install cargo crate: {{ $tool.name }}"
if ! install_cargo_crate {{ $tool.name | quote }}{{- if (and (index $tool "force") true) }} --force{{- end }}{{- if (and (index $tool "locked") true) }} --locked{{- end }}{{- with index $tool "version" }} --version {{ . }}{{ end }}{{- with index $tool "git" }} --git {{.}}{{ end }} {{- with index $tool "branch" }} --branch {{.}}{{ end }} {{- with index $tool "rev" }} --rev {{.}}{{ end }}{{- with index $tool "example" }} --example {{.}}{{ end }}{{- with index $tool "features" }} --features {{.}}{{ end }}; then
  had_errors=true
fi
fi
{{- else }}
if ! cargo_source_current {{ $tool | quote }} "" ""; then
echo "Install cargo crate: {{ $tool }}"
if ! install_cargo_crate {{ $tool | quote }}; then
  had_errors=true
fi
fi
{{- end }}
{{- end }}

remove_undeclared cleanup_enabled installed_cargo declared_cargo \
  'cargo crate' cargo uninstall
{{- end }}

if $had_errors; then
  exit 1
fi
