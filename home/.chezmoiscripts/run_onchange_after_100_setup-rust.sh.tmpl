#!/bin/zsh

echo "{{ template "week" . }} 󰯁 Setup rust"

rustup default stable

rustup update stable

rustup component add rust-analyzer

{{- range $tool := .packages.rust.cargo }}
{{- if eq (kindOf $tool) "map" }}
{{- $enabled := true -}}
{{- if hasKey $tool "when" -}}
  {{- $enabled = includeTemplate "when/check" (dict "item" $tool "key" "host_env" "value" $.host_env) | fromJson -}}
{{- end -}}
{{- if $enabled }}
cargo install{{- if (and (index $tool "force") true) }} --force{{- end }}{{- with index $tool "version" }} --version {{ . }}{{ end }}{{- with index $tool "git" }} --git {{.}}{{ end }} {{- with index $tool "rev" }} --rev {{.}}{{ end }} {{ $tool.name }}
{{- end }}
{{- else }}
cargo install {{ $tool }}
{{- end }}
{{- end }}

cargo install-update -a -g
