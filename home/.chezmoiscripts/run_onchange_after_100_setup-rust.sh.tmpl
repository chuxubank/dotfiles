#!/usr/bin/env zsh

echo "󰯁 Setup rust"

{{ includeTemplate "script/reconcile" }}

rustup default stable

rustup component add rust-analyzer

{{- $tools := includeTemplate "package/items" (dict "ctx" . "path" (list "rust" "cargo")) | fromJson }}
declared_cargo=(
{{- template "package/list" (dict "ctx" . "path" (list "rust" "cargo")) }}
)
installed_cargo=()
cleanup_enabled=true
had_errors=false

if command -v cargo >/dev/null; then
  if listing=$(cargo install --list); then
    installed_cargo=()
    while IFS= read -r line || [[ -n $line ]]; do
      [[ $line == [[:space:]]* || -z $line ]] && continue
      installed_cargo+=("${line%% *}")
    done <<<"$listing"
  else
    print -u2 -- "Could not list installed cargo crates; skipping undeclared cleanup"
    cleanup_enabled=false
    had_errors=true
  fi
else
  print -u2 -- "cargo is not installed; skipping undeclared cleanup"
  cleanup_enabled=false
  had_errors=true
fi

cargo_crate_installed() {
  local crate="$1"
  (( ${installed_cargo[(Ie)$crate]} ))
}

{{- range $tool := $tools }}
{{- if eq (kindOf $tool) "map" }}
if ! cargo_crate_installed {{ $tool.name | quote }}; then
echo "Install cargo crate: {{ $tool.name }}"
if ! cargo install{{- if (and (index $tool "force") true) }} --force{{- end }}{{- if (and (index $tool "locked") true) }} --locked{{- end }}{{- with index $tool "version" }} --version {{ . }}{{ end }}{{- with index $tool "git" }} --git {{.}}{{ end }} {{- with index $tool "rev" }} --rev {{.}}{{ end }}{{- with index $tool "features" }} --features {{.}}{{ end }} {{ $tool.name }}; then
  had_errors=true
fi
fi
{{- else }}
if ! cargo_crate_installed {{ $tool | quote }}; then
echo "Install cargo crate: {{ $tool }}"
if ! cargo install {{ $tool }}; then
  had_errors=true
fi
fi
{{- end }}
{{- end }}

remove_undeclared cleanup_enabled installed_cargo declared_cargo \
  'cargo crate' cargo uninstall

if $had_errors; then
  exit 1
fi
