{{- if and (ne .chezmoi.os "windows") (includeTemplate "tool/enabled" (merge (dict "tool" "rtk") .) | fromJson) -}}
#!/bin/sh

set -eu

if ! command -v rtk >/dev/null 2>&1; then
        echo "󰯁 Skip RTK agent integrations: rtk is not installed"
        exit 0
fi

echo "󰯁 Setup RTK agent integrations"

{{ if includeTemplate "tool/enabled" (merge (dict "tool" "claude-code") .) | fromJson -}}
rtk init --global --auto-patch
{{ end -}}
{{ if includeTemplate "tool/enabled" (merge (dict "tool" "codex") .) | fromJson -}}
rtk init --global --codex
{{ end -}}
{{ if includeTemplate "tool/enabled" (merge (dict "tool" "gemini-cli") .) | fromJson -}}
rtk init --global --gemini --auto-patch
{{ end -}}
{{ if includeTemplate "tool/enabled" (merge (dict "tool" "opencode") .) | fromJson -}}
rtk init --global --opencode
{{ end -}}
{{ if includeTemplate "tool/enabled" (merge (dict "tool" "pi") .) | fromJson -}}
rtk init --global --agent pi
{{ end -}}
{{ if includeTemplate "tool/enabled" (merge (dict "tool" "cursor") .) | fromJson -}}
rtk init --global --agent cursor
{{ end -}}
{{- end -}}
