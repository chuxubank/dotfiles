{{ if not (eq .host_env "ci") -}}
#!/bin/zsh

echo "󰯁 Setup oh-my-zsh"

if [[ -d $HOME/.oh-my-zsh ]]; then
    echo "✅ Omz is already installed."
else
    echo "🚀 Installing omz..."
    if ! installer=$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh); then
        print -u2 -- "Could not download oh-my-zsh installer"
        exit 1
    fi
    if ! RUNZSH=no sh -c "$installer"; then
        print -u2 -- "Could not install oh-my-zsh"
        exit 1
    fi
    echo "✅ omz installed!"
fi
{{ end -}}
