{{ if and (not (eq .host_env "ci")) (ne .chezmoi.os "windows") -}}
#!/bin/sh

echo "󰯁 Setup isync and mu"
had_errors=false

if ! mkdir -p {{ joinPath .chezmoi.homeDir .path.data.mail }}/qq; then
	had_errors=true
fi
if ! mkdir -p {{ joinPath .chezmoi.homeDir .path.data.mail }}/gmail; then
	had_errors=true
fi
echo "Sync all emails..."
# QQ Mail returns per-message UID FETCH errors after the rest of a channel
# has synced, and mbsync then exits non-zero. That must not set had_errors:
# a failed run_onchange script is retried on every apply and blocks every
# later script. Maildir creation and mu init/index stay fatal.
if ! mbsync -a; then
	printf 'warning: mbsync reported errors; continuing with a partial sync\n' >&2
fi
{{- if not (stat (joinPath .chezmoi.homeDir ".cache" "mu")) }}
echo "Init mu..."
if ! mu init --ignored-address=/.*no.*reply.*/ --maildir={{ joinPath .chezmoi.homeDir .path.data.mail }} --my-address={{ .email }}; then
	had_errors=true
fi
{{- end }}
echo "Call mu index..."
if ! mu index; then
	had_errors=true
fi

if [ "$had_errors" = true ]; then
	exit 1
fi

{{ end -}}
