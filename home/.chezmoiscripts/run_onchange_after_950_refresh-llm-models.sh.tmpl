#!/bin/sh
set -eu

echo "{{ template "week" . }} 󰯁 Refresh LLM models"
export PASSWORD_STORE_DIR={{ joinPath .chezmoi.homeDir .path.personal.pass | quote }}

{{ range $providerName, $provider := .llm.providers }}
{{ if and (hasKey $provider "model_caches") (includeTemplate "when/evaluate" (dict "item" $provider "values" (dict "host_env" $.host_env "roles" $.roles "os" $.chezmoi.os)) | fromJson) }}
{{ range $cacheKey, $cache := $provider.model_caches }}
{{ if ne (default "" (index $cache "managed")) "external" }}
  {{- $endpoint := includeTemplate "llm/model-endpoint" $provider | fromJson -}}
  {{- $authPath := "" -}}
  {{- if hasKey $provider "auth" -}}{{- $authPath = $provider.auth.path -}}{{- end -}}
{{ joinPath $.chezmoi.homeDir ".local" "bin" "llm-refresh-models" | quote }} \
  {{ joinPath $.chezmoi.homeDir (index $.path.cache $cacheKey) | quote }} \
  {{ $endpoint.url | quote }} \
  {{ $endpoint.auth_mode | quote }}{{ if $authPath }} "{{ $authPath }}"{{ end }}{{ if hasKey $cache "auth_field" }} "{{ $cache.auth_field }}"{{ end }}
{{ end }}
{{ end }}
{{ end }}
{{ end }}
