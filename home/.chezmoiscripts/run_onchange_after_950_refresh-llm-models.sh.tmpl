#!/bin/sh
set -eu

echo "{{ includeTemplate "time/date" . | trim }} 󰯁 Refresh LLM models"
export PASSWORD_STORE_DIR={{ joinPath .chezmoi.homeDir .path.personal.pass | quote }}
# Best effort: a failed refresh keeps the previous cache and only warns.
# The day stamp above reruns this script daily, and exiting non-zero here
# would abort the rest of chezmoi apply over a stale catalog.

fetch_model_response() {
  output_file=$1
  url=$2
  auth_mode=$3
  token=${4-}

  case "$auth_mode" in
    bearer)
      curl -sSL --fail-with-body \
        -H "Authorization: Bearer $token" \
        "$url" >"$output_file"
      ;;
    query:*)
      query_param=${auth_mode#query:}
      separator='?'
      case "$url" in
        *\?*) separator='&' ;;
      esac
      curl -sSL --fail-with-body \
        "$url${separator}${query_param}=${token}" >"$output_file"
      ;;
    none)
      curl -sSL --fail-with-body "$url" >"$output_file"
      ;;
    *)
      printf 'unknown model cache auth mode: %s\n' "$auth_mode" >&2
      return 2
      ;;
  esac
}

refresh_models() {
  cache_file=$1
  url=$2
  auth_mode=${3-none}
  pass_path=${4-}
  pass_field=${5-}

  case "$auth_mode" in
    none) ;;
    bearer|query:*)
      if ! token=$({{ joinPath .chezmoi.homeDir "bin" "pass-field" | quote }} "$pass_path" "$pass_field"); then
        return 1
      fi
      ;;
    *) return 2 ;;
  esac

  cache_dir=${cache_file%/*}
  [ "$cache_dir" = "$cache_file" ] && cache_dir=.
  if ! mkdir -p "$cache_dir"; then
    return 1
  fi
  if ! tmp_file=$(mktemp "$cache_dir/.models.XXXXXX"); then
    return 1
  fi
  trap 'rm -f "$tmp_file"' 0 HUP INT TERM

  if ! fetch_model_response "$tmp_file" "$url" "$auth_mode" "${token-}"; then
    rm -f "$tmp_file"
    trap - 0 HUP INT TERM
    return 1
  fi

  if [ ! -s "$tmp_file" ]; then
    printf 'empty model response from %s\n' "$url" >&2
    rm -f "$tmp_file"
    trap - 0 HUP INT TERM
    return 1
  fi
  if ! mv "$tmp_file" "$cache_file"; then
    rm -f "$tmp_file"
    trap - 0 HUP INT TERM
    return 1
  fi
  trap - 0 HUP INT TERM
}

{{ range $providerName, $provider := .llm.providers }}
{{- $owned := true -}}
{{- if hasKey $provider "owner" -}}
  {{- $owned = includeTemplate "tool/enabled" (merge (dict "tool" (index $provider "owner") "require" true) $) | fromJson -}}
{{- end -}}
{{ if and $owned (hasKey $provider "model_caches") (includeTemplate "when/evaluate" (dict "item" $provider "values" (dict "host_env" $.host_env "roles" $.roles "os" $.chezmoi.os)) | fromJson) }}
{{ range $cacheKey, $cache := $provider.model_caches }}
{{ if ne (default "" (index $cache "managed")) "external" }}
  {{- $endpointInput := $provider -}}
  {{- if and (not (index $provider "base_url")) (hasKey $provider "public_domain") -}}
    {{- $domainSpec := $provider.public_domain -}}
    {{- $domain := includeTemplate "safe/pass" (merge (dict "path" $domainSpec.path "field" $domainSpec.field) $) | trim -}}
    {{- if $domain -}}
      {{- $endpointInput = merge (deepCopy $provider) (dict "base_url" (printf "%s://%s.%s" (default "https" (index $provider "public_scheme")) (default "magpie" (index $provider "public_prefix")) $domain)) -}}
    {{- end -}}
  {{- end -}}
  {{- $endpoint := includeTemplate "llm/model-endpoint" $endpointInput | fromJson -}}
  {{- $authPath := "" -}}
  {{- if hasKey $provider "auth" -}}{{- $authPath = $provider.auth.path -}}{{- end -}}
{{- if hasPrefix "http" $endpoint.url }}
if ! refresh_models \
  {{ joinPath $.chezmoi.homeDir (index $.path.cache $cacheKey) | quote }} \
  {{ $endpoint.url | quote }} \
  {{ $endpoint.auth_mode | quote }}{{ if $authPath }} "{{ $authPath }}"{{ end }}{{ if hasKey $cache "auth_field" }} "{{ $cache.auth_field }}"{{ end }}; then
  printf 'warning: failed to refresh provider=%s cache=%s url=%s\n' \
    {{ $providerName | quote }} {{ $cacheKey | quote }} {{ $endpoint.url | quote }} >&2
fi
{{- end }}
{{ end }}
{{ end }}
{{ end }}
{{ end }}
