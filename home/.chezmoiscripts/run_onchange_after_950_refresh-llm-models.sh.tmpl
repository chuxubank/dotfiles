#!/bin/sh
set -eu

echo "{{ template "week" . }} 󰯁 Refresh LLM models"
export PASSWORD_STORE_DIR={{ joinPath .chezmoi.homeDir .path.personal.pass | quote }}

refresh_models() {
  cache_file=$1
  url=$2
  auth_mode=${3-none}
  pass_path=${4-}
  pass_field=${5-}

  case "$auth_mode" in
    none) ;;
    bearer|query:*)
      token=$({{ joinPath .chezmoi.homeDir "bin" "pass-field" | quote }} "$pass_path" "$pass_field")
      ;;
    *)
      printf 'unknown model cache auth mode: %s\n' "$auth_mode" >&2
      return 2
      ;;
  esac

  cache_dir=${cache_file%/*}
  [ "$cache_dir" = "$cache_file" ] && cache_dir=.
  mkdir -p "$cache_dir"
  tmp_file=$(mktemp "$cache_dir/.models.XXXXXX")
  trap 'rm -f "$tmp_file"' 0 HUP INT TERM

  if [ "$auth_mode" = bearer ]; then
    curl -sSfL --fail-with-body \
      -H "Authorization: Bearer $token" \
      "$url" >"$tmp_file"
  elif [ "${auth_mode#query:}" != "$auth_mode" ]; then
    query_param=${auth_mode#query:}
    separator='?'
    case "$url" in
      *\?*) separator='&' ;;
    esac
    curl -sSfL --fail-with-body \
      "$url${separator}${query_param}=${token}" >"$tmp_file"
  else
    curl -sSfL --fail-with-body "$url" >"$tmp_file"
  fi

  test -s "$tmp_file"
  mv "$tmp_file" "$cache_file"
  trap - 0 HUP INT TERM
}

{{ range $providerName, $provider := .llm.providers }}
{{ if and (hasKey $provider "model_caches") (includeTemplate "when/evaluate" (dict "item" $provider "values" (dict "host_env" $.host_env "roles" $.roles "os" $.chezmoi.os)) | fromJson) }}
{{ range $cacheKey, $cache := $provider.model_caches }}
{{ if ne (default "" (index $cache "managed")) "external" }}
  {{- $endpoint := includeTemplate "llm/model-endpoint" $provider | fromJson -}}
  {{- $authPath := "" -}}
  {{- if hasKey $provider "auth" -}}{{- $authPath = $provider.auth.path -}}{{- end -}}
refresh_models \
  {{ joinPath $.chezmoi.homeDir (index $.path.cache $cacheKey) | quote }} \
  {{ $endpoint.url | quote }} \
  {{ $endpoint.auth_mode | quote }}{{ if $authPath }} "{{ $authPath }}"{{ end }}{{ if hasKey $cache "auth_field" }} "{{ $cache.auth_field }}"{{ end }}
{{ end }}
{{ end }}
{{ end }}
{{ end }}
