#!/usr/bin/env zsh

echo "󰯁 Setup go"

[[ -e $HOME/.zshenv ]] && source "$HOME/.zshenv"
export PATH="$GOBIN:$PATH"

if ! command -v go >/dev/null; then
  print -u2 -- "go is not installed; skipping go package setup"
  exit 0
fi

{{ includeTemplate "script/reconcile" }}

GO_PACKAGES=(
{{- template "package/list" (dict "ctx" . "path" (list "go")) }}
)
declared_go=()
installed_go=()
gup_json='[]'
cleanup_enabled=true
had_errors=false

for pkg in "${GO_PACKAGES[@]}"; do
  declared_go+=("${pkg%%@*}")
done

gup_remove_import() {
  local import_path=$1
  local name
  name=$(jq -r --arg p "$import_path" \
    '.[] | select(.import_path == $p) | .name' <<<"$gup_json")
  if [[ -z $name ]]; then
    print -u2 -- "Could not resolve gup binary for $import_path"
    return 1
  fi
  gup remove --force "$name"
}

# sum.golang.org sometimes fails the checksum tile fetch with HTTP/2
# INTERNAL_ERROR. Retry a couple of times before treating it as fatal.
install_go_package() {
  local pkg=$1
  local attempt
  local delay=2
  local max_attempts=3

  for ((attempt = 1; attempt <= max_attempts; attempt++)); do
    if go install "$pkg"; then
      return 0
    fi
    if ((attempt < max_attempts)); then
      print -u2 -- "go install $pkg failed (attempt $attempt/$max_attempts); retrying in ${delay}s"
      sleep $delay
      delay=$((delay * 2))
    fi
  done
  return 1
}

if command -v gup >/dev/null; then
  json_names_load installed_go \
    'gup list --json' \
    'type == "array"' \
    '.[].import_path' \
    cleanup_enabled \
    'go binaries' \
    gup_json
else
  cleanup_enabled=false
fi

for pkg in "${GO_PACKAGES[@]}"; do
  import_path="${pkg%%@*}"
  if (( ! ${installed_go[(Ie)$import_path]} )); then
    echo "Install go package: $pkg"
    if ! install_go_package "$pkg"; then
      had_errors=true
    fi
  fi
done

if command -v gup >/dev/null; then
  json_names_load installed_go \
    'gup list --json' \
    'type == "array"' \
    '.[].import_path' \
    cleanup_enabled \
    'go binaries' \
    gup_json
  remove_undeclared cleanup_enabled installed_go declared_go \
    'go binary' gup_remove_import
else
  print -u2 -- "gup is not installed; skipping undeclared go cleanup"
  had_errors=true
fi

if $had_errors; then
  exit 1
fi
