{{- $shouldInstallHomebrew := or (eq .chezmoi.os "darwin") (and (eq .chezmoi.os "linux") (has .host_env (list "personal" "aa" "iv"))) -}}
{{ if and $shouldInstallHomebrew (not (lookPath "brew")) -}}
#!/bin/sh
set -eu

echo "🚀 Installing Homebrew..."
{{- if has .host_env (list "personal" "iv") }}
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.ustc.edu.cn/homebrew-core.git"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
{{- end }}

{{ includeTemplate "install/fetch-verify" }}
export NONINTERACTIVE=1
run_verified_script {{ .installers.homebrew.url | quote }} {{ .installers.homebrew.sha256 | quote }} /bin/bash

if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x "$HOME/.linuxbrew/bin/brew" ]; then
    eval "$($HOME/.linuxbrew/bin/brew shellenv)"
fi

echo "✅ Homebrew installed."
{{ end -}}
