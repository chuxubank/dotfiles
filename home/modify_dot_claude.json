{{- /* chezmoi:modify-template */ -}}

{{- $servers := includeTemplate "mcp/anthropic" (merge (dict "tool" "cc") .) | fromJson -}}
{{- $theme := ternary "dark" "light" .isDarkMode -}}

{{- $in := trim .chezmoi.stdin -}}
{{- if gt (len $in) 0 -}}
{{- fromJson $in
	| setValueAtPath "mcpServers" $servers
	| setValueAtPath "theme" $theme
	| toPrettyJson -}}
{{- else -}}

{{- end -}}
