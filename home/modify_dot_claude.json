{{- /* chezmoi:modify-template */ -}}

{{- $servers := includeTemplate "mcp/anthropic" (dict "mcp" .mcp "device_type" .device_type "host_env" .host_env "roles" .roles "tool" "cc") | fromJson -}}
{{- $theme := ternary "dark" "light" .isDarkMode -}}

{{- $in := trim .chezmoi.stdin -}}
{{- if gt (len $in) 0 -}}
{{- fromJson $in
	| setValueAtPath "mcpServers" $servers
	| setValueAtPath "theme" $theme
	| toPrettyJson -}}
{{- else -}}

{{- end -}}
