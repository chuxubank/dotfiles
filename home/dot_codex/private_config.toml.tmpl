{{- /* https://developers.openai.com/codex/mcp/ */ -}}

{{- /* Build MCP servers map */ -}}
{{- $servers := dict -}}
{{- range $provider := .mcp.providers }}
  {{- $serverName := regexReplaceAll "[^a-z0-9]+" ($provider.name | lower) "_" -}}
  {{- $exec := $provider.execution -}}
  {{- $server := dict -}}
  {{- /* Support only stdio and http */ -}}
  {{- if eq $exec.type "stdio" }}
    {{- $_ := set $server "command" $exec.cmd -}}
    {{- if hasKey $exec "args" }}
      {{- $_ := set $server "args" $exec.args -}}
    {{- end }}
  {{- else if or (eq $exec.type "http") (eq $exec.type "sse") }}
    {{- $_ := set $server "url" $exec.uri -}}
    {{- if hasKey $exec "bearer_token_env_var" }}
      {{- $_ := set $server "bearer_token_env_var" $exec.bearer_token_env_var -}}
    {{- end }}
    {{- if hasKey $exec "http_headers" }}
      {{- $_ := set $server "http_headers" $exec.http_headers -}}
    {{- end }}
    {{- if hasKey $exec "env_http_headers" }}
      {{- $_ := set $server "env_http_headers" $exec.env_http_headers -}}
    {{- end }}
  {{- else }}
    {{- /* skip unsupported execution type */ -}}
    {{- continue -}}
  {{- end }}

  {{- if hasKey $exec "startup_timeout" }}
    {{- $_ := set $server "startup_timeout_sec" $exec.startup_timeout -}}
  {{- end }}
  {{- if hasKey $exec "timeout" }}
    {{- $_ := set $server "tool_timeout_sec" $exec.timeout -}}
  {{- end }}
  {{- $_ := set $server "enabled" $provider.enabled -}}

  {{- if hasKey $exec "envs" }}
    {{- $envs := dict -}}
    {{- range $envKey := sortAlpha (keys $exec.envs) }}
      {{- $envValue := index $exec.envs $envKey -}}
      {{- if eq (kindOf $envValue) "map" }}
        {{- $secret := "" -}}
        {{- if or (not (hasKey $envValue "type")) (eq $envValue.type "pass") }}
          {{- if (hasKey $envValue "field") }}
            {{- $secret = (index (passFields $envValue.path) $envValue.field) -}}
          {{- else }}
            {{- $secret = (pass $envValue.path) -}}
          {{- end }}
        {{- else if eq $envValue.type "output" }}
          {{- $secret = (outputList $envValue.cmd $envValue.args) -}}
        {{- end }}
        {{- if and (hasKey $envValue "trim") $envValue.trim }}
          {{- $secret = ($secret | trim) -}}
        {{- end }}
        {{- $_ := set $envs $envKey $secret -}}
      {{- else }}
        {{- $_ := set $envs $envKey $envValue -}}
      {{- end }}
    {{- end }}
    {{- if gt (len $envs) 0 }}
      {{- $_ := set $server "env" $envs -}}
    {{- end }}
  {{- end }}

  {{- $_ := set $servers $serverName $server -}}
{{- end }}

{{- /* Projects trust map */ -}}
{{- $projects := dict -}}
{{- $_ := set $projects (joinPath .chezmoi.homeDir ".local" "share" "chezmoi") (dict "trust_level" "trusted") -}}
{{- $trustedKeys := list "org" "org-roam" "beancount" "blog" "proxy" "keyboard" "emacs" -}}
{{- range $k := $trustedKeys }}
  {{- $_ := set $projects (joinPath $.chezmoi.homeDir (index $.path $k)) (dict "trust_level" "trusted") -}}
{{- end }}
{{- $trustedTreeKeys := list "iv" "aa" "asahiart" -}}
{{- range $k := $trustedTreeKeys }}
  {{- $root := joinPath $.chezmoi.homeDir (index $.path $k) -}}
  {{- $dirs := output "sh" "-c" "if [ -d \"$1\" ]; then find \"$1\" -mindepth 1 -maxdepth 1 -type d -print; fi" "sh" $root -}}
  {{- range $dir := splitList "\n" ($dirs | trim) }}
    {{- if $dir }}
      {{- $_ := set $projects $dir (dict "trust_level" "trusted") -}}
    {{- end }}
  {{- end }}
{{- end }}

{{- $config := dict
  "model" "gpt-5.4"
  "model_reasoning_effort" "medium"
  "mcp_servers" $servers
  "projects" $projects
  "notice" (dict
    "hide_gpt5_1_migration_prompt" true
    "hide_gpt-5.1-codex-max_migration_prompt" true
	"model_migrations" (dict
	  "gpt-5.2-codex" "gpt-5.3-codex"
	  "gpt-5.3-codex" "gpt-5.4"
	)
  )
  "features" (dict
    "unified_exec" true
	"shell_snapshot" true
  )
-}}
{{ $config | toToml }}
