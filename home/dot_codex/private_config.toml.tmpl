{{- /* https://developers.openai.com/codex/mcp/ */ -}}

{{- /* Build MCP servers map */ -}}
{{- $servers := dict -}}
{{- $all := includeTemplate "mcp/servers" (merge (dict "tool" "codex") .) | fromJson -}}
{{- range $s := $all }}
  {{- $server := dict -}}
  {{- /* Support only stdio and http */ -}}
  {{- if eq $s.type "stdio" }}
    {{- $_ := set $server "command" $s.cmd -}}
    {{- if $s.args }}
      {{- $_ := set $server "args" $s.args -}}
    {{- end }}
  {{- else if or (eq $s.type "http") (eq $s.type "sse") }}
    {{- $_ := set $server "url" $s.uri -}}
    {{- if hasKey $s "bearer_token_env_var" }}
      {{- $_ := set $server "bearer_token_env_var" $s.bearer_token_env_var -}}
    {{- end }}
    {{- if hasKey $s "headers" }}
      {{- $_ := set $server "http_headers" $s.headers -}}
    {{- end }}
    {{- if hasKey $s "env_headers" }}
      {{- $_ := set $server "env_http_headers" $s.env_headers -}}
    {{- end }}
  {{- else }}
    {{- continue -}}
  {{- end }}

  {{- if gt $s.tool_timeout 0 }}
    {{- $_ := set $server "tool_timeout_sec" $s.tool_timeout -}}
  {{- end }}
  {{- if gt $s.timeout 0 }}
    {{- $_ := set $server "startup_timeout_sec" $s.timeout -}}
  {{- end }}
  {{- $_ := set $server "enabled" $s.enabled -}}

  {{- if gt (len $s.envs) 0 }}
    {{- $_ := set $server "env" $s.envs -}}
  {{- end }}

  {{- $_ := set $servers $s.name_snake $server -}}
{{- end }}

{{- /* Projects trust map */ -}}
{{- $projects := dict -}}
{{- $trustedLevel := dict "trust_level" "trusted" -}}
{{- $_ := set $projects "/" $trustedLevel -}}
{{- $_ := set $projects (joinPath .chezmoi.homeDir ".local" "share" "chezmoi") $trustedLevel -}}
{{- $trustedKeys := list
  "beancount"
  "blog"
  "emacs"
  "keyboard"
  "org"
  "org-roam"
  "proxy"
  "skills"
-}}
{{- range $k := $trustedKeys }}
  {{- $_ := set $projects (joinPath $.chezmoi.homeDir (index $.path $k)) $trustedLevel -}}
{{- end }}
{{- $trustedTreeKeys := list "iv" "aa" "asahiart" -}}
{{- range $k := $trustedTreeKeys }}
  {{- $root := joinPath $.chezmoi.homeDir (index $.path $k) -}}
  {{- $dirs := output "sh" "-c" "if [ -d \"$1\" ]; then find \"$1\" -mindepth 1 -maxdepth 1 -type d -print; fi" "sh" $root -}}
  {{- range $dir := splitList "\n" ($dirs | trim) }}
    {{- if $dir }}
      {{- $_ := set $projects $dir $trustedLevel -}}
    {{- end }}
  {{- end }}
{{- end }}

{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "codex") .) | fromJson -}}

{{- $codexConfigPath := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $existingCodexConfig := dict -}}
{{- if stat $codexConfigPath }}
  {{- $existingCodexConfig = output "cat" $codexConfigPath | fromToml -}}
{{- end -}}
{{- $marketplaces := dict -}}
{{- if hasKey $existingCodexConfig "marketplaces" }}
  {{- $marketplaces = $existingCodexConfig.marketplaces -}}
{{- end -}}

{{- $plugins := dict
  "browser-use@openai-bundled" (dict "enabled" true)
  "computer-use@openai-bundled" (dict "enabled" true)
  "documents@openai-primary-runtime" (dict "enabled" true)
  "presentations@openai-primary-runtime" (dict "enabled" true)
  "spreadsheets@openai-primary-runtime" (dict "enabled" true)
-}}

{{- $config := dict
  "model" $cfg.model
  "model_reasoning_effort" $cfg.reasoning_effort
  "mcp_servers" $servers
  "projects" $projects
  "marketplaces" $marketplaces
  "plugins" $plugins
  "features" (dict
    "unified_exec" true
    "shell_snapshot" true
  )
  "tui" (dict
    "model_availability_nux" (dict
      "gpt-5.5" 4
    )
  )
-}}
{{ $config | toToml }}
