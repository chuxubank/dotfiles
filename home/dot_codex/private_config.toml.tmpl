{{- $servers := includeTemplate "mcp/codex" . | fromJson -}}

{{- /* Projects trust map */ -}}
{{- $projects := dict -}}
{{- $trustedLevel := dict "trust_level" "trusted" -}}
{{- $_ := set $projects "/" $trustedLevel -}}
{{- $_ := set $projects (joinPath .chezmoi.homeDir ".local" "share" "chezmoi") $trustedLevel -}}
{{- $trustedKeys := list
  "beancount"
  "blog"
  "emacs"
  "keyboard"
  "org"
  "org-roam"
  "proxy"
  "skills"
-}}
{{- range $k := $trustedKeys }}
  {{- $_ := set $projects (joinPath $.chezmoi.homeDir (index $.path $k)) $trustedLevel -}}
{{- end }}
{{- $trustedTreeKeys := list "iv" "aa" "asahiart" "xz" -}}
{{- range $k := $trustedTreeKeys }}
  {{- $root := joinPath $.chezmoi.homeDir (index $.path $k) -}}
  {{- $dirs := output "sh" "-c" "if [ -d \"$1\" ]; then find \"$1\" -mindepth 1 -maxdepth 1 -type d -print; fi" "sh" $root -}}
  {{- range $dir := splitList "\n" ($dirs | trim) }}
    {{- if $dir }}
      {{- $_ := set $projects $dir $trustedLevel -}}
    {{- end }}
  {{- end }}
{{- end }}

{{- $cfg := includeTemplate "llm/tool-config" (merge (dict "tool" "codex") .) | fromJson -}}
{{- $model := $cfg.model -}}
{{- $modelProvider := "" -}}
{{- $modelParts := splitList "/" $model -}}
{{- if and (gt (len $modelParts) 1) (hasKey $cfg.providers (index $modelParts 0)) -}}
  {{- $modelProvider = index $modelParts 0 -}}
  {{- $model = join "/" (slice $modelParts 1) -}}
{{- end -}}
{{- if eq $modelProvider "openai" -}}{{- $modelProvider = "" -}}{{- end -}}
{{- $modelProviders := dict -}}
{{- range $alias, $ep := $cfg.providers }}
  {{- if eq $alias "openai" }}{{ continue }}{{ end -}}
  {{- $baseURL := trimSuffix "/" $ep.base_url -}}
  {{- if and $baseURL (not (hasSuffix "/v1" $baseURL)) -}}
    {{- $baseURL = printf "%s/v1" $baseURL -}}
  {{- end -}}
  {{- $provider := dict
    "name" $alias
    "base_url" $baseURL
  -}}
  {{- if $ep.auth_path }}
    {{- $args := list $ep.auth_path -}}
    {{- if $ep.auth_field }}
      {{- $args = list $ep.auth_path $ep.auth_field -}}
    {{- end }}
    {{- $_ := set $provider "auth" (dict
      "command" (joinPath $.chezmoi.homeDir "bin" "pass-field")
      "args" $args
      "timeout_ms" 5000
      "refresh_interval_ms" 300000
    ) -}}
  {{- end }}
  {{- $_ := set $modelProviders $alias $provider -}}
{{- end }}

{{- $codexConfigPath := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $existingCodexConfig := dict -}}
{{- if stat $codexConfigPath }}
  {{- $existingCodexConfig = output "cat" $codexConfigPath | fromToml -}}
{{- end -}}
{{- $preservedCodexConfigKeys := list "marketplaces" "notify" -}}

{{- $config := dict
  "model" $model
  "model_reasoning_effort" $cfg.reasoning_effort
  "mcp_servers" $servers
  "personality" "pragmatic"
  "projects" $projects
  "features" (dict
	"multi_agent" true
    "goals" true
    "shell_snapshot" true
    "unified_exec" true
  )
  "tui" (dict
    "model_availability_nux" (dict
      "gpt-5.5" 4
    )
  )
-}}
{{- range $key := $preservedCodexConfigKeys }}
  {{- if hasKey $existingCodexConfig $key }}
    {{- $_ := set $config $key (index $existingCodexConfig $key) -}}
  {{- end }}
{{- end -}}
{{- if $modelProvider -}}{{- $_ := set $config "model_provider" $modelProvider -}}{{- end -}}
{{- if gt (len $modelProviders) 0 -}}{{- $_ := set $config "model_providers" $modelProviders -}}{{- end -}}
{{ $config | toToml }}

[plugins]
  [plugins."browser-use@openai-bundled"]
    enabled = true
  [plugins."computer-use@openai-bundled"]
    enabled = true
  [plugins."documents@openai-primary-runtime"]
    enabled = true
  [plugins."presentations@openai-primary-runtime"]
    enabled = true
  [plugins."spreadsheets@openai-primary-runtime"]
    enabled = true

[plugins."test-android-apps@openai-curated"]
enabled = true

[plugins."kotlin-agent-skills@Kotlin"]
enabled = true

[plugins."github@openai-curated"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."chrome@openai-bundled"]
enabled = true

[desktop]
ambient-suggestions-enabled = true
appearanceLightCodeThemeId = "codex"
preventSleepWhileRunning = true
keepRemoteControlAwakeWhilePluggedIn = true
git-pull-request-merge-method = "merge"
git-show-sidebar-pr-icons = true
conversationDetailMode = "STEPS_COMMANDS"
