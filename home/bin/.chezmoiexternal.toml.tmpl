{{- if ne .host_env "ci" -}}
["jar/pdf-unstamper.jar"]
    type = "file"
    url = "{{ (gitHubLatestReleaseAssetURL "hwding/pdf-unstamper" "pdf-unstamper.jar") }}"
{{- end }}

{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") (eq .chezmoi.os "windows") }}
["android"]
    type = "file"
    executable = true
    url = "https://dl.google.com/android/cli/latest/{{ if eq .chezmoi.os "linux" }}linux_x86_64{{ else if eq .chezmoi.os "windows" }}windows_x86_64{{ else }}darwin_arm64{{ end }}/android{{ if eq .chezmoi.os "windows" }}.exe{{ end }}"
{{- end }}

{{- if and (eq .chezmoi.os "darwin") (ne .host_env "ci") }}
["md-babel"]
    type = "archive-file"
    url = "{{ (gitHubLatestReleaseAssetURL "md-babel/swift-markdown-babel" "md-babel_macos-universal-*.tar.bz2") }}"
    path = "md-babel"
{{- end }}

{{- /* Install the fork independently of the upstream Homebrew formula.
       Keep the release pinned: upstream and fork tags are separate catalogs. */ -}}
{{- if and (eq .chezmoi.os "darwin") (ne .host_env "ci") (includeTemplate "tool/enabled" (merge (dict "tool" "luvus" "require" true) .) | fromJson) }}
{{- $version := "0.14.4" -}}
{{- $assets := dict
    "arm64" (dict "triple" "aarch64-apple-darwin" "sha256" "6d6b2f84ebebee4432c934131fc733f9cf4aa8c80c76c700e5241980651248a0")
    "amd64" (dict "triple" "x86_64-apple-darwin" "sha256" "106dd39679f2f9ac3e44ac7c17e2ca8e844a1428cfc1a9a944a4fb3749f5e4a3") -}}
{{- with index $assets .chezmoi.arch }}
["luvus"]
    type = "archive-file"
    url = {{ gitHubReleaseAssetURL "chuxubank/luvus" (printf "v%s" $version) (printf "luvus-v%s-%s.tar.gz" $version .triple) | quote }}
    checksum.sha256 = {{ .sha256 | quote }}
    path = "luvus"
    executable = true
{{- end }}
{{- end }}

{{- if eq .host_env "aa" }}
["fly"]
    type = "file"
    url = "https://concourse-prod.aaecosystem.com/api/v1/cli?arch=amd64&platform={{ .chezmoi.os }}"
    executable = true
{{- end }}
