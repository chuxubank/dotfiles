#!/bin/sh
set -u

usage() {
	cat <<'EOF'
usage: services [list|status] [SERVICE ...]
       services <start|stop|restart> SERVICE ...
       services log SERVICE ...

SERVICE may be a tool name such as gitwatch or a full service name such
as gitwatch.org. A tool name selects all of that tool's services.
EOF
}

validate_selector() {
	case "$1" in
{{- $seen := dict -}}
{{- range (includeTemplate "service/plan" . | fromJson) }}
	{{ .name | quote }}) return 0 ;;
	{{- if not (hasKey $seen .tool) }}
	{{- if ne .name .tool }}
	{{ .tool | quote }}) return 0 ;;
	{{- end }}
	{{- $_ := set $seen .tool true -}}
	{{- end }}
{{- end }}
	esac
	return 1
}

selected() {
	service_name=$1
	tool_name=$2
	shift 2

	[ "$#" -eq 0 ] && return 0
	for selector; do
		[ "$selector" = "$service_name" ] || [ "$selector" = "$tool_name" ] || continue
		return 0
	done
	return 1
}

append_log_file() {
	if [ -n "$log_files" ]; then
		log_files="$log_files
$1"
	else
		log_files=$1
	fi
}

service_status() {
	label=$1
	scheduled=$2
	status=none

{{- if eq .chezmoi.os "darwin" }}
	if launch_data=$(launchctl print "gui/{{ .chezmoi.uid }}/$label" 2>/dev/null); then
		launch_state=$(printf '%s\n' "$launch_data" |
			awk -F '= ' '/^[[:space:]]*state = / { print $2; exit }')
		exit_code=$(printf '%s\n' "$launch_data" |
			awk -F '= ' '/^[[:space:]]*last exit code = / { print $2; exit }')

		if [ "$launch_state" = "running" ]; then
			status=started
		elif [ -n "$exit_code" ] && [ "$exit_code" != "0" ] &&
			[ "$exit_code" != "(never exited)" ]; then
			status="error $exit_code"
		elif [ "$scheduled" = true ]; then
			status=scheduled
		else
			status=stopped
		fi
	fi
{{- else if eq .chezmoi.os "linux" }}
	if systemd_data=$(systemctl --user show "$label.service" \
		--property=LoadState \
		--property=ActiveState \
		--property=ExecMainStatus 2>/dev/null); then
		load_state=$(printf '%s\n' "$systemd_data" |
			awk -F= '$1 == "LoadState" { print $2 }')
		active_state=$(printf '%s\n' "$systemd_data" |
			awk -F= '$1 == "ActiveState" { print $2 }')
		exit_code=$(printf '%s\n' "$systemd_data" |
			awk -F= '$1 == "ExecMainStatus" { print $2 }')

		if [ "$load_state" != "not-found" ]; then
			case "$active_state" in
			active) status=started ;;
			activating) status=starting ;;
			deactivating) status=stopping ;;
			failed) status="error $exit_code" ;;
			*) status=stopped ;;
			esac
		fi
	fi
{{- end }}
}

control_service() {
	action=$1
	service_name=$2
	label=$3

{{- if eq .chezmoi.os "darwin" }}
	domain="gui/{{ .chezmoi.uid }}"
	plist="$HOME/Library/LaunchAgents/$label.plist"
	if [ "$action" != stop ] && ! plutil -lint "$plist" >/dev/null; then
		printf 'services: invalid plist for %s: %s\n' "$service_name" "$plist" >&2
		failures=$((failures + 1))
		return
	fi
	case "$action" in
	start)
		if launchctl print "$domain/$label" >/dev/null 2>&1; then
			launchctl kickstart "$domain/$label"
		else
			launchctl bootstrap "$domain" "$plist" &&
				launchctl kickstart "$domain/$label"
		fi
		;;
	stop)
		if launchctl print "$domain/$label" >/dev/null 2>&1; then
			launchctl bootout "$domain/$label"
		fi
		;;
	restart)
		if launchctl print "$domain/$label" >/dev/null 2>&1; then
			launchctl kickstart -k "$domain/$label"
		else
			launchctl bootstrap "$domain" "$plist" &&
				launchctl kickstart "$domain/$label"
		fi
		;;
	esac
{{- else if eq .chezmoi.os "linux" }}
	systemctl --user "$action" "$label.service"
{{- end }}
	result=$?

	if [ "$result" -ne 0 ]; then
		printf 'services: failed to %s %s\n' "$action" "$service_name" >&2
		failures=$((failures + 1))
		return
	fi
	printf '%-26s %s\n' "$service_name" "$action"
}

handle_service() {
	action=$1
	service_name=$2
	tool_name=$3
	label=$4
	manager=$5
	file=$6
	scheduled=$7
	stdout_log=$8
	stderr_log=$9
	shift 9

	selected "$service_name" "$tool_name" "$@" || return 0

	if [ "$action" = list ]; then
		service_status "$label" "$scheduled"
		printf '%-26s %-12s %-8s %s\n' "$service_name" "$status" "$manager" "$file"
	elif [ "$action" = log ]; then
		append_log_file "$stdout_log"
		append_log_file "$stderr_log"
	else
		control_service "$action" "$service_name" "$label"
	fi
}

case "${1-}" in
-h | --help)
	usage
	exit 0
	;;
list | status)
	action=list
	shift
	;;
start | stop | restart | log)
	action=$1
	shift
	if [ "$#" -eq 0 ]; then
		usage >&2
		exit 2
	fi
	;;
*)
	action=list
	;;
esac

for selector; do
	if ! validate_selector "$selector"; then
		printf 'services: unknown service: %s\n' "$selector" >&2
		exit 1
	fi
done

failures=0
log_files=
if [ "$action" = list ]; then
	printf '%-26s %-12s %-8s %s\n' Name Status Manager File
fi
{{- range (includeTemplate "service/plan" . | fromJson) }}
{{- if or (eq $.chezmoi.os "darwin") (eq $.chezmoi.os "linux") }}
handle_service "$action" {{ .name | quote }} {{ .tool | quote }} {{ .label | quote }} \
	{{ .manager | quote }} {{ .file | quote }} \
	{{ .scheduled }} {{ .stdout_log | quote }} {{ .stderr_log | quote }} "$@"
{{- end }}
{{- end }}

if [ "$action" = log ]; then
	old_ifs=$IFS
	IFS='
'
	set -f
	# log_files is newline-delimited so paths containing spaces stay intact.
	# shellcheck disable=SC2086
	set -- $log_files
	IFS=$old_ifs
	exec tail -n 100 -F "$@"
fi

exit "$failures"
