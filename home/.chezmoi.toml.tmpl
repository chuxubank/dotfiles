{{- $interactive := stdinIsATTY }}
{{- $deviceTypeChoices := list "laptop" "desktop" "server" -}}
{{- $hostEnvChoices := list "personal" "aa" "iv" "cloud" "ci" -}}
{{- $roleChoices := list
  "automation"
  "daily"
  "game"
  "llm"
  "qmk"
  "router"
  "studio"
  "work"
-}}

{{- $email := env "EMAIL" -}}

{{- $deviceType := "server" -}}
{{- $hostEnv := "ci" -}}
{{- $roles := list "automation" -}}

{{- $passDir := ".password-store" }}
{{- $isDarkMode := false }}
{{- $os := .chezmoi.os -}}

{{- $memGb := 0 -}}
{{- $diskGb := 0 -}}
{{- if eq $os "darwin" -}}
  {{- $memGb = atoi (output "sh" "-c" "echo $(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))" | trim) -}}
{{- else if or (eq $os "linux") (eq $os "android") -}}
  {{- $memGb = atoi (output "sh" "-c" "awk '/MemTotal/{printf \"%d\", int($2/1048576)}' /proc/meminfo 2>/dev/null || echo 0" | trim) -}}
{{- end -}}
{{- if or (eq $os "darwin") (eq $os "linux") (eq $os "android") -}}
  {{- $diskGb = atoi (output "sh" "-c" "df -k / 2>/dev/null | awk 'NR==2{printf \"%d\", int($2/1048576)}' || echo 0" | trim) -}}
{{- end -}}

{{- if $interactive }}
{{- $email = promptStringOnce . "email" "Email address" -}}
{{- $deviceType = promptChoiceOnce . "device_type" "What type of device is this" $deviceTypeChoices -}}
{{- $hostEnv = promptChoiceOnce . "host_env" "What environment does this host belong to" $hostEnvChoices -}}

{{- $defaultRoles := list -}}
{{- if eq $hostEnv "personal" -}}
  {{- if eq $deviceType "server" -}}
    {{- $defaultRoles = "llm" -}}
  {{- else if eq $deviceType "desktop" -}}
    {{- if eq $os "windows" -}}
      {{- $defaultRoles = "game" -}}
	{{- else if eq $os "darwin" -}}
      {{- $defaultRoles = list "llm" "router" -}}
    {{- end -}}
  {{- else -}}
    {{- $defaultRoles = "daily" -}}
  {{- end -}}
{{- else if or (eq $hostEnv "aa") (eq $hostEnv "iv") -}}
  {{- $defaultRoles = "work" -}}
{{- end -}}

{{- $roles = promptMultichoiceOnce . "roles" "Roles" $roleChoices $defaultRoles }}
{{- $passDir = promptStringOnce . "path.pass" "Password store dir for pass cli" ".password-store" }}
{{- end }}

{{- if eq $os "darwin" }}
{{- $isDarkMode = eq "Dark" (output "sh" "-c" "defaults read -g AppleInterfaceStyle 2>/dev/null || true" | trim) }}
{{- end }}

sourceDir = {{ .chezmoi.sourceDir | quote }}
encryption = "gpg"

[gpg]
    recipient = "Misaka"
	args = ["--quiet"]

[scriptEnv]
    PASSWORD_STORE_DIR = {{- joinPath .chezmoi.homeDir $passDir | quote }}

[data]
    email = {{- $email | quote }}
    device_type = {{- $deviceType | quote }}
    host_env = {{- $hostEnv | quote }}
    roles = {{- $roles | toToml }}
	isDarkMode = {{- $isDarkMode }}
    mem_gb = {{ $memGb }}
    disk_gb = {{ $diskGb }}

[data.path]
    pass = {{- $passDir | quote }}
{{- if eq $os "darwin" }}
# darwin
{{- if eq .chezmoi.arch "arm64" }}
    usr = "/opt/homebrew"
	etc = "/opt/homebrew/etc"
    gh = "/opt/homebrew/bin/gh"
{{- else }}
    usr = "/usr/local"
	etc = "/usr/local/etc"
    gh = "/usr/local/bin/gh"
{{- end }}
    log = {{- joinPath .chezmoi.homeDir "Library" "Logs" | quote }}
	zotero = {{- joinPath "Library" "Application Support" "Zotero" | quote}}
{{- else if eq $os "linux" }}
# linux
    usr = "/usr"
	etc = "/etc"
    gh = "/usr/bin/gh"
    log = "/var/log"
	zotero = {{- joinPath ".zotero" "zotero" | quote }}
{{- else if eq $os "windows" }}
# windows
    gh = "'C:\\\\Program Files\\\\GitHub CLI\\\\gh.exe'"
	zotero = {{- joinPath (env "APPDATA") "Zotero" "Zotero" | quote }}
{{- else if eq $os "android" }}
# android
    usr = "/data/data/com.termux/files/usr"
    gh = "/data/data/com.termux/files/usr/bin/gh"
    log = "/data/data/com.termux/files/var/log"
{{- else }}
# unknown
{{- end }}

[diff]
    command = "difft"
    args = ["--color", "always"]
    exclude = ["scripts", "externals"]

[gitHub]
    refreshPeriod = "24h"

[[textconv]]
    pattern = "**/*.plist"
    command = "plutil"
    args = ["-convert", "xml1", "-o", "-", "-"]
