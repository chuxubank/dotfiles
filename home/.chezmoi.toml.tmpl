{{- define "config-data-policies" -}}
{{- range $key := .value | keys | sortAlpha }}
{{- $value := index $.value $key }}
{{- if not (kindIs "map" $value) }}
{{ $key }} = {{ $value | toToml }}
{{- end }}
{{- end }}
{{- range $key := .value | keys | sortAlpha }}
{{- $value := index $.value $key }}
{{- if kindIs "map" $value }}
[{{ $.prefix }}.{{ $key }}]
{{- template "config-data-policies" (dict "prefix" (printf "%s.%s" $.prefix $key) "value" $value) }}
{{- end }}
{{- end }}
{{- end }}
{{- $interactive := stdinIsATTY }}
{{- $deviceTypeChoices := list "laptop" "desktop" "server" -}}
{{- $hostEnvChoices := list "personal" "aa" "iv" "cloud" "ci" -}}
{{- $roleChoices := list
  "automation"
  "daily"
  "game"
  "llm"
  "qmk"
  "router"
  "studio"
  "work"
-}}

{{- $email := env "EMAIL" -}}

{{- $deviceType := "server" -}}
{{- $hostEnv := "ci" -}}
{{- $roles := list "automation" -}}

{{- $passDir := ".password-store" }}
{{- $os := .chezmoi.os -}}
{{- $facts := includeTemplate "host/facts" . | fromJson -}}
{{- $memGb := $facts.mem_gb -}}
{{- $diskGb := $facts.disk_gb -}}
{{- $osVersion := $facts.os_version -}}
{{- $isDarkMode := $facts.isDarkMode -}}

{{- /* update --init does not pass --data, so prompt*Once cannot see the
       current chezmoi.toml. Read that file directly. Interactive prompts stay
       as they are; a non-TTY run keeps saved answers instead of the
       first-run defaults (server / ci / automation). */ -}}
{{- $savedData := dict -}}
{{- if and .chezmoi.configFile (stat .chezmoi.configFile) -}}
{{- $parsedConfig := include .chezmoi.configFile | fromToml -}}
{{- if hasKey $parsedConfig "data" -}}
{{- $savedData = index $parsedConfig "data" -}}
{{- end -}}
{{- end -}}

{{- if $interactive }}
{{- $email = promptStringOnce . "email" "Email address" -}}
{{- $deviceType = promptChoiceOnce . "device_type" "What type of device is this" $deviceTypeChoices -}}
{{- $hostEnv = promptChoiceOnce . "host_env" "What environment does this host belong to" $hostEnvChoices -}}

{{- $defaultRoles := includeTemplate "host/default-roles" (dict "host_env" $hostEnv "device_type" $deviceType "os" $os) | fromJson -}}

{{- $roles = promptMultichoiceOnce . "roles" "Roles" $roleChoices $defaultRoles }}
{{- $passDir = promptStringOnce . "path.pass" "Password store dir for pass cli" ".password-store" }}
{{- else }}
{{- if hasKey $savedData "email" }}{{ $email = index $savedData "email" }}{{ end }}
{{- if hasKey $savedData "device_type" }}{{ $deviceType = index $savedData "device_type" }}{{ end }}
{{- if hasKey $savedData "host_env" }}{{ $hostEnv = index $savedData "host_env" }}{{ end }}
{{- if hasKey $savedData "roles" }}{{ $roles = index $savedData "roles" }}{{ end }}
{{- if and (hasKey $savedData "path") (kindIs "map" (index $savedData "path")) (hasKey (index $savedData "path") "pass") -}}
{{- $passDir = index (index $savedData "path") "pass" -}}
{{- end }}
{{- end }}

sourceDir = {{ .chezmoi.sourceDir | quote }}
encryption = "gpg"

[gpg]
    recipient = "Misaka"
	args = ["--quiet"]

[scriptEnv]
    PASSWORD_STORE_DIR = {{- joinPath .chezmoi.homeDir $passDir | quote }}
{{- if eq $os "windows" }}
    PYTHONUTF8 = "1"
    PYTHONIOENCODING = "utf-8"
{{- end }}

{{- if eq $os "windows" }}
[interpreters.sh]
    command = "zsh"
{{- end }}

[data]
    email = {{- $email | quote }}
    device_type = {{- $deviceType | quote }}
    host_env = {{- $hostEnv | quote }}
    roles = {{- $roles | toToml }}
	isDarkMode = {{- $isDarkMode }}
    mem_gb = {{ $memGb }}
    disk_gb = {{ $diskGb }}
    os_version = {{ $osVersion | quote }}

[data.path]
    pass = {{- $passDir | quote }}
{{- includeTemplate "path/platform" (dict "os" $os "arch" .chezmoi.arch "homeDir" .chezmoi.homeDir) }}
{{- if and (hasKey $savedData "policies") (kindIs "map" (index $savedData "policies")) }}

[data.policies]
{{- template "config-data-policies" (dict "prefix" "data.policies" "value" (index $savedData "policies")) }}
{{- end }}

[diff]
    command = "difft"
    args = ["--color", "always"]
    exclude = ["scripts", "externals"]

[gitHub]
    refreshPeriod = "24h"

[[textconv]]
    pattern = "**/*.plist"
    command = "plutil"
    args = ["-convert", "xml1", "-o", "-", "-"]
