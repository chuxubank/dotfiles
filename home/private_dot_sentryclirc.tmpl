{{- if includeTemplate "tool/enabled" (merge (dict "tool" "sentry") .) | fromJson -}}
# IV self-hosted Sentry. SENTRY_URL scopes this token to the company instance.
[defaults]
org = sentry

[auth]
token = {{ includeTemplate "safe/pass" (merge (dict "path" "Work/IV/Sentry" "field" "api-token") .) }}
{{- end -}}
