{{- if and (eq .chezmoi.os "darwin") (ne .host_env "ci") -}}
{{- $mygoURL := includeTemplate "github/release-asset-url" (dict
      "repo" "egoist/mygo-cloudmusic"
      "pattern" (printf "mygo-cloudmusic-*-darwin-%s.tar.gz" .chezmoi.arch)) | trim -}}
{{- if $mygoURL }}
["MyGo 云音乐.app"]
    type = "archive"
    url = {{ $mygoURL | quote }}
    stripComponents = 1
    refreshPeriod = "168h"
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "darwin") (ne .host_env "ci") }}
["iloader.app"]
    type = "archive"
    url = "{{ (gitHubLatestReleaseAssetURL "nab138/iloader" "iloader-darwin-universal.app.tar.gz") }}"
    stripComponents = 1

["TuxGuitar.app"]
    type = "archive"
    url = "{{ (gitHubLatestReleaseAssetURL "helge17/tuxguitar" "tuxguitar-*-macosx-swt-cocoa-x86_64.app.tar.gz") }}"
    stripComponents = 1
{{- end }}
