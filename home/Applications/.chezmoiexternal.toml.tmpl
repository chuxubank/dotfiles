{{- if and (eq .chezmoi.os "darwin") (ne .host_env "ci") -}}
{{- $mygoURL := includeTemplate "github/release-asset-url" (dict
      "repo" "egoist/mygo-cloudmusic"
      "pattern" (printf "mygo-cloudmusic-*-darwin-%s.tar.gz" .chezmoi.arch)) | trim -}}
{{- if $mygoURL }}
["MyGo 云音乐.app"]
    type = "archive"
    url = {{ $mygoURL | quote }}
    stripComponents = 1
    refreshPeriod = "168h"
{{- end }}
{{- end }}

{{- if and (eq .chezmoi.os "darwin") (ne .host_env "ci") }}
["iloader.app"]
    type = "archive"
    url = "{{ (gitHubLatestReleaseAssetURL "nab138/iloader" "iloader-darwin-universal.app.tar.gz") }}"
    stripComponents = 1

["TuxGuitar.app"]
    type = "archive"
    url = "{{ (gitHubLatestReleaseAssetURL "helge17/tuxguitar" "tuxguitar-*-macosx-swt-cocoa-x86_64.app.tar.gz") }}"
    stripComponents = 1

{{- /* BetterCast publishes a DMG. chezmoi archives are tar or zip, so the
       filter mounts that image and writes a tar of the app.
       Same 50 GB free-space bar as the sidescreen cask. */ -}}
{{- $bettercastReady := includeTemplate "when/context" (merge (dict "item" (dict "when" (dict "enabled" (dict "disk_available_gb" (dict "min" 50))))) .) | fromJson -}}
{{- if $bettercastReady -}}
{{- $bettercastURL := includeTemplate "github/release-asset-url" (dict "repo" "StephenLovino/BetterCast" "pattern" "BetterCast.dmg") | trim -}}
{{- if $bettercastURL }}
["BetterCast.app"]
    type = "archive"
    format = "tar"
    url = {{ $bettercastURL | quote }}
    stripComponents = 1
    refreshPeriod = "168h"
    filter.command = "/bin/zsh"
    filter.args = ["-c", {{ `d=$(mktemp -d); trap 'diskutil eject "$d/mnt" >/dev/null 2>&1 || true; rm -rf "$d"' EXIT; cat > "$d/BetterCast.dmg"; diskutil image attach --nobrowse --readOnly --mountPoint "$d/mnt" "$d/BetterCast.dmg" >/dev/null; COPYFILE_DISABLE=1 tar -C "$d/mnt" -cf - BetterCast.app` | quote }}]
{{- end }}
{{- end }}

{{- /* Cindy publishes a notarized DMG with an Applications symlink. Archive
       only Cindy.app so that link is not followed into a second app. The app
       updates itself, so refresh weekly. */ -}}
{{- $cindyReady := includeTemplate "tool/enabled" (merge (dict "tool" "cindy" "require" true) .) | fromJson -}}
{{- if $cindyReady -}}
{{- $cindyURL := includeTemplate "github/release-asset-url" (dict "repo" "makecindy/cindy" "pattern" (printf "cindy-*-darwin-%s-global.dmg" .chezmoi.arch)) | trim -}}
{{- if $cindyURL }}
["Cindy.app"]
    type = "archive"
    format = "tar"
    url = {{ $cindyURL | quote }}
    stripComponents = 1
    refreshPeriod = "168h"
    filter.command = "/bin/zsh"
    filter.args = ["-c", {{ `d=$(mktemp -d); trap 'diskutil eject "$d/mnt" >/dev/null 2>&1 || true; rm -rf "$d"' EXIT; cat > "$d/Cindy.dmg"; diskutil image attach --nobrowse --readOnly --mountPoint "$d/mnt" "$d/Cindy.dmg" >/dev/null; COPYFILE_DISABLE=1 tar -C "$d/mnt" -cf - Cindy.app` | quote }}]
{{- end }}
{{- end }}
{{- end }}
