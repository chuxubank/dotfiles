{{- if eq .chezmoi.os "darwin" }}
["Developer/Example/Raycast/script-commands"]
    type = "git-repo"
    url = "https://github.com/raycast/script-commands.git"
    refreshPeriod = "24h"
    clone.args = ["--depth=1"]

["Developer/Example/Raycast/raycast-g4f"]
    type = "git-repo"
    url = "https://github.com/XInTheDark/raycast-g4f.git"
    refreshPeriod = "24h"
    clone.args = ["--depth=1"]

["Library/Fonts/Symbola.ttf"]
    type = "archive-file"
	url = "https://fontlibrary.org/assets/downloads/symbola/cf81aeb303c13ce765877d31571dc5c7/symbola.zip"
    path = "Symbola.ttf"

["bin/tuios"]
    type = "archive-file"
    url = "{{ (gitHubLatestReleaseAssetURL "Gaurav-Gosain/tuios" "tuios_*_Darwin_arm64.tar.gz") }}"
    path = "tuios"

["bin/md-babel"]
    type = "archive-file"
    url = "{{ (gitHubLatestReleaseAssetURL "md-babel/swift-markdown-babel" "md-babel_macos-universal-*.tar.bz2") }}"
    path = "md-babel"

{{- end }}