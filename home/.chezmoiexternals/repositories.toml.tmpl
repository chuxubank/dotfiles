{{- /* Render repositories.yaml into chezmoi git-repo externals. */ -}}
{{- $destinations := dict -}}
{{- range $repo := default (list) .repositories -}}
{{-   $enabled := includeTemplate "when/context" (merge (dict "item" $repo) $) | fromJson -}}
{{-   if $enabled -}}
{{-     $path := $.path -}}
{{-     $visited := list -}}
{{-     range $key := $repo.path -}}
{{-       $visited = append $visited $key -}}
{{-       if or (ne (kindOf $path) "map") (not (hasKey $path $key)) -}}
{{-         fail (printf "unknown repository path: path.%s" (join "." $visited)) -}}
{{-       end -}}
{{-       $path = index $path $key -}}
{{-     end -}}
{{-     if ne (kindOf $path) "string" -}}
{{-       fail (printf "repository path is not a string: path.%s" (join "." $visited)) -}}
{{-     end -}}
{{-     if hasKey $repo "dest" -}}
{{-       $path = joinPath $path $repo.dest -}}
{{-     end -}}
{{-     if hasKey $destinations $path -}}
{{-       fail (printf "duplicate repository destination: %s" $path) -}}
{{-     end -}}
{{-     $_ := set $destinations $path true }}
[{{ $path | quote }}]
    type = "git-repo"
    url = {{ $repo.url | quote }}
    refreshPeriod = {{ $repo.refresh_period | quote }}
{{-     if hasKey $repo "branch" }}
    clone.args = ["-b", {{ $repo.branch | quote }}]
    pull.args = ["--ff-only", "origin", {{ $repo.branch | quote }}]
{{-     end }}
{{ end -}}
{{- end -}}
