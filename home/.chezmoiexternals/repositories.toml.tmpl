{{- /* Render repositories.yaml into chezmoi git-repo externals.
       url is origin. When upstream is set, url is our fork and the upstream
       remote is configured at clone time, because chezmoi has no post-clone
       hook. Refresh runs a bare `git pull`, so branch names what it follows
       and it follows upstream whenever one exists. */ -}}
{{- $destinations := dict -}}
{{- range $repo := default (list) .repositories -}}
{{-   $enabled := includeTemplate "when/context" (merge (dict "item" $repo) $) | fromJson -}}
{{-   if $enabled -}}
{{-     $path := includeTemplate "path/value" (merge
          (dict "path" $.path "keys" $repo.path "label" "repository path")
          (pick $repo "dest")) -}}
{{-     if hasKey $destinations $path -}}
{{-       fail (printf "duplicate repository destination: %s" $path) -}}
{{-     end -}}
{{-     $_ := set $destinations $path true }}
[{{ $path | quote }}]
    type = "git-repo"
    url = {{ $repo.url | quote }}
    refreshPeriod = {{ $repo.refresh_period | quote }}
{{-     $cloneArgs := list -}}
{{-     if hasKey $repo "branch" -}}
{{-       $cloneArgs = concat $cloneArgs (list "-b" $repo.branch) -}}
{{-     end -}}
{{-     if hasKey $repo "depth" -}}
{{-       $cloneArgs = append $cloneArgs (printf "--depth=%v" $repo.depth) -}}
{{-     end -}}
{{-     if hasKey $repo "upstream" -}}
{{-       $cloneArgs = concat $cloneArgs (list
            "-c" (printf "remote.upstream.url=%s" $repo.upstream)
            "-c" "remote.upstream.fetch=+refs/heads/*:refs/remotes/upstream/*"
            "-c" "remote.pushDefault=origin") -}}
{{-     end -}}
{{-     if $cloneArgs }}
    clone.args = [{{ range $i, $arg := $cloneArgs }}{{ if $i }}, {{ end }}{{ $arg | quote }}{{ end }}]
{{-     end }}
{{-     if hasKey $repo "branch" }}
    pull.args = ["--ff-only", {{ if hasKey $repo "upstream" }}"upstream"{{ else }}"origin"{{ end }}, {{ $repo.branch | quote }}]
{{-     end }}
{{ end -}}
{{- end -}}
