{{- /* Render repositories.yaml into chezmoi git-repo externals. */ -}}
{{- $destinations := dict -}}
{{- range $repo := default (list) .repositories -}}
{{-   $enabled := includeTemplate "when/context" (merge (dict "item" $repo) $) | fromJson -}}
{{-   if $enabled -}}
{{-     $path := includeTemplate "path/value" (merge
          (dict "path" $.path "keys" $repo.path "label" "repository path")
          (pick $repo "dest")) -}}
{{-     if hasKey $destinations $path -}}
{{-       fail (printf "duplicate repository destination: %s" $path) -}}
{{-     end -}}
{{-     $_ := set $destinations $path true }}
[{{ $path | quote }}]
    type = "git-repo"
    url = {{ $repo.url | quote }}
    refreshPeriod = {{ $repo.refresh_period | quote }}
{{-     if hasKey $repo "branch" }}
    clone.args = ["-b", {{ $repo.branch | quote }}]
    pull.args = ["--ff-only", "origin", {{ $repo.branch | quote }}]
{{-     end }}
{{ end -}}
{{- end -}}
