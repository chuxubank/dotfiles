{{- $kotlinOS := get (dict
    "darwin"  "mac"
    "linux"   "linux"
    "windows" "win"
) $.chezmoi.os -}}

{{- $kotlinArch := get (dict
    "amd64" "x64"
    "arm64" "aarch64"
) .chezmoi.arch -}}

["Developer/Example/Zotero/translators"]
    type = "git-repo"
    url = "https://github.com/zotero/translators.git"
    refreshPeriod = "24h"
    clone.args = ["--depth=1"]

["Developer/Example/Zotero/translators_cn"]
    type = "git-repo"
    url = "https://github.com/l0o0/translators_CN.git"
    refreshPeriod = "24h"
    clone.args = ["--depth=1"]

["Developer/Example/Android/nowinandroid"]
    type = "git-repo"
    url = "https://github.com/android/nowinandroid.git"
    refreshPeriod = "168h"

["{{ .path.plum }}"]
    type = "git-repo"
    url = "https://github.com/rime/plum"
    refreshPeriod = "168h"

["bin/jar/pdf-unstamper.jar"]
    type = "file"
    url = "{{ (gitHubLatestReleaseAssetURL "hwding/pdf-unstamper" "pdf-unstamper.jar") }}"

[".local/share/kotlin-lsp"]
    type = "archive"
	url = "{{ regexFind (printf `https://[^\s]+-%s-%s\.zip` $kotlinOS $kotlinArch) (gitHubLatestRelease "Kotlin/kotlin-lsp").Body }}"
	exact = true
    refreshPeriod = "744h"

[{{ joinPath .path.zotero (index .path "zotero-ext") "better-bibtex@iris-advies.com.xpi" | quote }}]
    type = "file"
	url = "{{ (gitHubLatestReleaseAssetURL "retorquere/zotero-better-bibtex" "zotero-better-bibtex-*.xpi") }}"