["Developer/Example/Android/nowinandroid"]
    type = "git-repo"
    url = "https://github.com/android/nowinandroid.git"
    refreshPeriod = "168h"

["Developer/Example/KMP/compose-multiplatform"]
    type = "git-repo"
	url = "https://github.com/JetBrains/compose-multiplatform.git"
	refreshPeriod = "168h"

["{{ .path.plum }}"]
    type = "git-repo"
    url = "https://github.com/rime/plum"
    refreshPeriod = "168h"

["bin/jar/pdf-unstamper.jar"]
    type = "file"
    url = "{{ (gitHubLatestReleaseAssetURL "hwding/pdf-unstamper" "pdf-unstamper.jar") }}"

[{{ index .path "models-dev-api" | quote }}]
    type = "file"
    url = "https://models.dev/api.json"
    refreshPeriod = "24h"

{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") (eq .chezmoi.os "windows") }}
["bin/android"]
    type = "file"
	executable = true
	url = "https://dl.google.com/android/cli/latest/{{ if eq .chezmoi.os "linux" }}linux_x86_64{{ else if eq .chezmoi.os "windows" }}windows_x86_64{{ else }}darwin_arm64{{ end }}/android{{ if eq .chezmoi.os "windows" }}.exe{{ end }}"
{{- end }}
