{{- if ne .host_env "ci" -}}
[{{ joinPath (index .path.workspace "xz") "RobotDroid" | quote }}]
    type = "git-repo"
    url = "https://github.com/OpenXingZhi/RobotDroid"
    refreshPeriod = "48h"

[{{ joinPath (index .path.workspace "xz") "RobotDroidConfig" | quote }}]
    type = "git-repo"
    url = "https://gitee.com/star-spider-intelligence/robot-droid-config"
    refreshPeriod = "48h"

{{- if has "qmk" .roles -}}
["{{ .path.workspace.qmk }}"]
    type = "git-repo"
    url = "https://github.com/qmk/qmk_firmware"
    refreshPeriod = "48h"
{{- end -}}
{{- end -}}
