{{- /* Side-project org trees: path.workspace.asahiart, path.workspace.opentactic,
       path.workspace.xz. Work tree aa has no external and is cloned by hand.
       Source trees only clone on personal; InventoryConfig and
       RobotDroidConfig also clone on aa/iv because those are the Gitee
       write targets the apps read at runtime.
       Inclusion rule for every org: non-archived, non-fork, active. */ -}}
{{- if ne .host_env "ci" -}}
{{- if eq .host_env "personal" -}}
{{- range $repo := list
  "Arborist"
  "Luvia"
  "font-subset-gradle-plugin"
  "org-parser"
  "quote0-school-calendar"
  "tree-sitter-template"
}}
[{{ joinPath $.path.workspace.asahiart $repo | quote }}]
    type = "git-repo"
    url = "https://github.com/AsahiArt/{{ $repo }}"
    refreshPeriod = "4h"
{{ end }}
{{- range $repo := list
  "AndroidCI"
  "HardwareServerContainer"
  "Inventory"
  "RobotDroid"
  "license-library"
  "remote-config"
  "rfid-codec"
  "trusted-time"
}}
[{{ joinPath (index $.path.workspace "xz") $repo | quote }}]
    type = "git-repo"
    url = "https://github.com/OpenXingZhi/{{ $repo }}"
    refreshPeriod = "48h"
{{ end }}
{{- range $repo := list
  "OpenTactic"
}}
[{{ joinPath (index $.path.workspace "opentactic") $repo | quote }}]
    type = "git-repo"
    url = "https://github.com/OpenTactic/{{ $repo }}"
    refreshPeriod = "4h"
{{ end }}
{{- end }}
{{- /* Gitee is the write target and runtime source, not the GitHub copy. */}}
{{- range $cfg := list
  (dict "dest" "InventoryConfig" "slug" "inventory-config")
  (dict "dest" "RobotDroidConfig" "slug" "robot-droid-config")
}}
[{{ joinPath (index $.path.workspace "xz") $cfg.dest | quote }}]
    type = "git-repo"
    url = "https://gitee.com/star-spider-intelligence/{{ $cfg.slug }}"
    refreshPeriod = "48h"
{{ end }}
{{ end -}}
