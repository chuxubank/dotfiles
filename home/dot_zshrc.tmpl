# chezmoi:template:line-endings=native

{{- includeTemplate "shell/zshrc-hooks" (merge (dict "at" "before-omz") .) -}}
export ZSH="$HOME/.oh-my-zsh"
export ZSH_COMPDUMP=$ZSH/cache/.zcompdump-$HOST
export ZSHZ_DATA=$ZSH/cache/.z

{{ if eq .chezmoi.os "android" -}}
ZSH_THEME="lambda"
{{ else -}}
ZSH_THEME="half-life"
{{ end -}}

SHELLPROXY_CONFIG="$HOME/.config/shell-proxy.sh"

PYTHON_VENV_NAME=".venv"
PYTHON_AUTO_VRUN=true

plugins=(
    alias-finder
    aliases
    brew
    chezmoi
    command-not-found
    emacs
    fzf
    gh
    git
    git-lfs
    gitignore
    gnu-utils
    gpg-agent
    gradle
    man
    mosh
    pass
    podman
    python
    qrcode
	repo
    rclone
    rsync
    rust
    shell-proxy
    sudo
    tmux
    uv
    vscode
    wakeonlan
    z
)

if [[ "$TERM_PROGRAM" =~ ^(WezTerm|ghostty|termio)$ || -n "$WT_SESSION" ]]; then
    plugins+=(starship)
else
    plugins+=(
        timer
        virtualenv
    )
fi

if [[ "$(uname)" = 'Darwin' ]]; then
    plugins+=(macos)
fi

{{ if eq .host_env "aa" -}}
plugins+=(jira aws)
{{ end -}}

source_if $ZSH/oh-my-zsh.sh
if command -v starship >/dev/null && [[ -z ${STARSHIP_SHELL:-} ]]; then
  eval "$(starship init zsh)"
fi

zstyle ':omz:plugins:alias-finder' autoload yes

{{- includeTemplate "shell/zshrc-hooks" (merge (dict "at" "after-compinit") .) }}

# Login shells define sdk from .zprofile. Non-login interactive shells never read that file.
if (( ! $+functions[sdk] )); then
  source_if "$SDKMAN_DIR/bin/sdkman-init.sh"
fi

{{- includeTemplate "shell/zshrc-hooks" (merge (dict "at" "completion-ui") .) }}

source_if $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source_if $HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

source_if /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source_if /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

{{- if has "qmk" .roles -}}
source_if $QMK_HOME/util/qmk_tab_complete.sh
{{- end -}}

source_if "$BUN_INSTALL/_bun"

if [[ "$INSIDE_EMACS" = 'vterm' ]] \
    && [[ -n ${EMACS_VTERM_PATH} ]] \
    && [[ -f ${EMACS_VTERM_PATH}/etc/emacs-vterm-zsh.sh ]]; then
	source ${EMACS_VTERM_PATH}/etc/emacs-vterm-zsh.sh
fi

export MANPATH="/usr/local/man:$MANPATH"
export LANG=en_US.UTF-8

if [[ -n $SSH_CONNECTION ]]; then
  unset SSH_ASKPASS
  unset SUDO_ASKPASS
  # Force terminal pinentry so gpg/pass prompts work without a GUI.
  export PINENTRY_USER_DATA=USE_CURSES
  export GPG_TTY=$(tty)
  gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
  export EDITOR='vim'
else
  export EDITOR='emacsclient -a=""'
fi

alias bupa='brew upgrade --greedy-auto-updates'

# Surface git-repo external refreshes in real time; see the shim itself
# (~/.local/libexec/chezmoi-git-shim/git) for the rationale.
chezmoi() {
  PATH="$HOME/.local/libexec/chezmoi-git-shim:$PATH" command chezmoi "$@"
}
alias cz="chezmoi"
alias cza="cz apply --init"
alias czu="cz update --init -a"
alias czr="cz re-add"
alias czd="cz diff"
alias czc="cz cat"
alias czs="chezmoi-script"

load-api-keys() {
  local key
  key=$(pass-field Personal/Tech/Google gemini-api-key) || return
  export GEMINI_API_KEY="$key"
  key=$(pass-field Personal/Tech/AI/OpenRouter api-key) || return
  export OPENROUTER_API_KEY="$key"
}

{{ template "gpg/functions.sh" . }}

if (( $+commands[brew] )); then
  brew() {
    case "$1" in
      upgrade|reinstall|install|bundle)
        run_with_gpgk command brew "$@"
        ;;
      *)
        command brew "$@"
        ;;
    esac
  }
fi

function up() {
  {{- if eq .chezmoi.os "darwin" }}
  brew update && brew bundle --quiet --global
  {{- else if eq .chezmoi.os "android" }}
  pkg update && run_with_gpgk pkg upgrade
  {{- end }}
}
function upe() {
  git -C "{{ joinPath .chezmoi.homeDir .path.personal.emacs }}" pull --ff-only
  {{ template "emacs/package-sync-upgrade.sh" . }}
  {{ template "emacs/restart.sh" . }}
}
alias upn="bun update -g --latest"
alias upp="uv tool upgrade --all"
alias ups="skills update -g"

function webp-duration () {
  webpmux -info "$1" | awk '
    /^[[:space:]]*[0-9]+:/ {sum += $7; frames++}
    END {printf "%d frames, %d ms (%.3f s)\n", frames, sum, sum/1000}
  '
}

function iploc() {
  local prev=""
  local dig_args=(+short)
  local endpoint authority path

  case "$2" in
    https://*|http://*)
      endpoint="${2#*://}"
      authority="${endpoint%%/*}"
      [[ "$endpoint" == */* ]] && path="/${endpoint#*/}" || path="/"
      dig_args+=("@$authority")
      [[ "$2" == https://* ]] && dig_args+=("+https=$path") || dig_args+=("+http-plain=$path")
      dig_args+=("${@:3}")
      ;;
    tls://*)
      dig_args+=("@${${2#tls://}%%/*}" +tls "${@:3}")
      ;;
    tcp://*)
      dig_args+=("@${${2#tcp://}%%/*}" +tcp "${@:3}")
      ;;
    udp://*)
      dig_args+=("@${${2#udp://}%%/*}" "${@:3}")
      ;;
    +*|-*)
      dig_args+=("${@:2}")
      ;;
    ?*)
      dig_args+=("@${2#@}" "${@:3}")
      ;;
  esac

  dig "${dig_args[@]}" "$1" | while read -r line; do
    line=${line%.}

    if [[ $line =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
      echo "=== $line ==="
      curl -s "ipinfo.io/$line"
      echo
      echo
    else
      if [[ -n "$prev" ]]; then
        echo "$prev -> $line"
      fi
      prev="$line"
    fi
  done
}

{{- if eq .host_env "aa" }}
alias ci="export CIRCLECI=true && export CI=true && export key_file_path='/' && export key_alias='' && export key_password='' && export key_alias_password=''"
source <(fly completion --shell zsh)
source $HOME/.config/op/plugins.sh
{{- else if eq .host_env "iv" }}
source <(glab completion -s zsh)
{{- end }}
