{{- if eq .os "darwin" -}}
alias {{ .tool }}-{{ .target }}-off='launchctl bootout gui/{{ .uid }}/{{ .tool }}.{{ .target }}'
alias {{ .tool }}-{{ .target }}-on='launchctl bootstrap gui/{{ .uid }} ~/Library/LaunchAgents/{{ .tool }}.{{ .target }}.plist'
alias {{ .tool }}-{{ .target }}-restart='launchctl kickstart -k gui/{{ .uid }}/{{ .tool }}.{{ .target }}'
{{- else if eq .os "linux" -}}
alias {{ .tool }}-{{ .target }}-off='systemctl --user stop {{ .tool }}.{{ .target }}'
alias {{ .tool }}-{{ .target }}-on='systemctl --user start {{ .tool }}.{{ .target }}'
alias {{ .tool }}-{{ .target }}-restart='systemctl --user restart {{ .tool }}.{{ .target }}'
{{- end -}}
