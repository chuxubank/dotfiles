{{- /* service/services — Service specs for this host.
       serviceSelect "disabled" returns specs that must not be installed.
       The default is the enabled set. Output: JSON array. */ -}}
{{- $select := dig "serviceSelect" "enabled" . -}}
{{- $selected := list -}}
{{- range $service := .services -}}
  {{- $enabled := true -}}
  {{- if eq (kindOf $service) "map" -}}
    {{- $enabled = includeTemplate "tool/item-enabled" (merge (dict "item" $service) $) | fromJson -}}
  {{- end -}}
  {{- if and $enabled (eq (kindOf $service) "map") (hasKey $service "when") -}}
    {{- $enabled = includeTemplate "when/context" (merge (dict "item" $service) $) | fromJson -}}
  {{- end -}}
  {{- $keep := $enabled -}}
  {{- if eq $select "disabled" -}}
    {{- $keep = not $enabled -}}
  {{- end -}}
  {{- if $keep -}}
    {{- $selected = append $selected $service -}}
  {{- end -}}
{{- end -}}
{{- $selected | toJson -}}
