    <string>{{ $stderr }}</string>
    {{- if or (not (hasKey . "limitLoadToSessionType")) .limitLoadToSessionType }}
    <key>LimitLoadToSessionType</key>
    <array>
      {{- range (list "Aqua" "Background" "LoginWindow" "StandardIO" "System") }}
      <string>{{ . }}</string>
      {{- end }}
    </array>
    {{- end }}
    <key>ProgramArguments</key>
    <array>
      {{- range .programArguments }}
      <string>{{ includeTemplate "service/value" (dict "ctx" $ "item" .) }}</string>
      {{- end }}
    </array>
    {{- if hasKey . "environmentVariables" }}
    <key>EnvironmentVariables</key>
    <dict>
      {{- range $key, $value := .environmentVariables }}
      <key>{{ $key }}</key>
      <string>{{ includeTemplate "service/value" (dict "ctx" $ "item" $value) }}</string>
      {{- end }}
    </dict>
    {{- end }}
    {{- if and (hasKey . "runAtLoad") .runAtLoad }}
    <key>RunAtLoad</key>
    <true/>
    {{- end }}
    {{- if hasKey . "startInterval" }}
    <key>StartInterval</key>
    <integer>{{ .startInterval }}</integer>
    {{- end }}
    {{- if hasKey . "extra" }}
{{ .extra | indent 4 }}
    {{- end }}
  </dict>
