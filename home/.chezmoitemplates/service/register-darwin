{{- $isBrew := and (hasKey . "brew") .brew -}}
{{- $logBase := "" -}}
{{- $label := includeTemplate "service/label" (dict "os" .chezmoi.os "service" .) -}}
{{- if $isBrew -}}
  {{- $logBase = .tool -}}
{{- else -}}
  {{- $logBase = .target -}}
{{- end -}}
{{- $stdoutFile := printf "%s-stdout.log" $logBase -}}
{{- $stderrFile := printf "%s-stderr.log" $logBase -}}
{{- if hasKey . "stdoutLogFile" -}}{{- $stdoutFile = .stdoutLogFile -}}{{- end -}}
{{- if hasKey . "stderrLogFile" -}}{{- $stderrFile = .stderrLogFile -}}{{- end -}}
{{- $stdout := includeTemplate "service/log-path" (dict "path" .path "parts" (list .tool) "file" $stdoutFile) -}}
{{- $stderr := includeTemplate "service/log-path" (dict "path" .path "parts" (list .tool) "file" $stderrFile) -}}
{{- if hasKey . "standardOutPath" -}}{{- $stdout = .standardOutPath -}}{{- end -}}
{{- if hasKey . "standardErrorPath" -}}{{- $stderr = .standardErrorPath -}}{{- end -}}
{{- $plist := includeTemplate "service/plist-darwin" (merge (dict "label" $label "stdout" $stdout "stderr" $stderr) .) -}}
{{- if $isBrew }}
brew services restart {{ .tool }} --file=/dev/stdin <<'PLIST'
{{ $plist }}PLIST
{{- else -}}
{{- $launchagentsDir := joinPath .chezmoi.homeDir "Library" "LaunchAgents" -}}
mkdir -p {{ $launchagentsDir | quote }}
cat > {{ joinPath $launchagentsDir (printf "%s.plist" $label) | quote }} <<'PLIST'
{{ $plist }}PLIST
{{- end -}}
