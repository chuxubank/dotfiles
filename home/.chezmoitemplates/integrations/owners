{{- /* integrations/owners — JSON owner names selected for one lifecycle mode.
       setup: enabled owners whose integration_lifecycle.setup is not false.
       teardown: disabled owners. Optional integration_lifecycle.os limits both. */ -}}
{{- $mode := dig "mode" "" . -}}
{{- if not (has $mode (list "setup" "teardown")) -}}
{{- fail "integrations/owners: mode must be setup or teardown" -}}
{{- end -}}
{{- $owners := list -}}
{{- range $name := keys (default dict .tools) | sortAlpha -}}
  {{- $spec := index $.tools $name -}}
  {{- if hasKey $spec "integrations" -}}
    {{- $lifecycle := dig "integration_lifecycle" dict $spec -}}
    {{- $oses := dig "os" (list) $lifecycle -}}
    {{- $platform := or (eq (len $oses) 0) (has $.chezmoi.os $oses) -}}
    {{- $enabled := includeTemplate "tool/enabled" (merge (dict "tool" $name) $) | fromJson -}}
    {{- $setup := dig "setup" true $lifecycle -}}
    {{- if and $platform (or
          (and (eq $mode "setup") $enabled $setup)
          (and (eq $mode "teardown") (not $enabled))) -}}
      {{- $owners = append $owners $name -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $owners | toJson -}}
