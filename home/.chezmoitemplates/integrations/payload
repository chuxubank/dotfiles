{{- /* integrations/payload — JSON owner lifecycle plus resolved targets. */ -}}
{{- $name := .owner -}}
{{- if not $name -}}
{{- fail "integrations/payload: missing owner" -}}
{{- end -}}
{{- $spec := index .tools $name -}}
{{- $ints := dig "integrations" (list) $spec -}}
{{- if eq (len $ints) 0 -}}
{{- fail (printf "%s: integrations is empty" $name) -}}
{{- end -}}
{{- $targets := list -}}
{{- range $int := $ints -}}
  {{- $agent := dig "tool" "" $int -}}
  {{- if not $agent -}}
    {{- fail (printf "%s: integration missing tool" $name) -}}
  {{- end -}}
  {{- $enabled := includeTemplate "tool/enabled" (merge (dict "tool" $agent) $) | fromJson -}}
  {{- $targets = append $targets (dict
        "tool" $agent
        "args" (dig "args" (list) $int)
        "enabled" $enabled) -}}
{{- end -}}
{{- dict
      "owner" $name
      "lifecycle" (dig "integration_lifecycle" dict $spec)
      "targets" $targets
    | toJson -}}
