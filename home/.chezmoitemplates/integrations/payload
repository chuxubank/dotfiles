{{- /* integrations/payload — JSON owner lifecycle plus resolved targets. */ -}}
{{- $name := .owner -}}
{{- if not $name -}}
{{- fail "integrations/payload: missing owner" -}}
{{- end -}}
{{- $spec := index .integration_owners $name -}}
{{- $targetsRaw := dig "targets" (list) $spec -}}
{{- if eq (len $targetsRaw) 0 -}}
{{- fail (printf "%s: integration targets are empty" $name) -}}
{{- end -}}
{{- $targets := list -}}
{{- range $target := $targetsRaw -}}
  {{- $agent := dig "tool" "" $target -}}
  {{- if not $agent -}}
    {{- fail (printf "%s: integration target missing tool" $name) -}}
  {{- end -}}
  {{- $enabled := includeTemplate "tool/enabled" (merge (dict "tool" $agent "require" true) $) | fromJson -}}
  {{- $targets = append $targets (dict
        "tool" $agent
        "args" (dig "args" (list) $target)
        "enabled" $enabled
        "installed" (dig "installed" dict $target)) -}}
{{- end -}}
{{- dict
      "owner" $name
      "lifecycle" (dig "lifecycle" dict $spec)
      "targets" $targets
    | toJson -}}
