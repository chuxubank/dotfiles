{{- /* Resolve agents for a skill based on `when.enabled` / `when.disabled` conditions. */ -}}
{{- $skill := .skill -}}
{{- $allAgents := .skills.agents -}}
{{- $agents := list -}}
{{- range $agent := $allAgents -}}
  {{- $enabled := includeTemplate "when/evaluate" (dict
        "item" $skill
        "values" (dict
          "device_type" $.device_type
          "host_env" $.host_env
          "os" $.chezmoi.os
          "roles" $.roles
          "mem_gb" (dig "mem_gb" 0 $)
          "disk_gb" (dig "disk_gb" 0 $)
          "tool" $agent)
        "os_version" (dig "os_version" "" $)) | fromJson -}}
  {{- if $enabled -}}
    {{- $agents = append $agents $agent -}}
  {{- end -}}
{{- end -}}
{{- toJson $agents -}}
