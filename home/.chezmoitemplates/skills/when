{{- /* Resolve agents for a skill based on its optional owner switch and
       `when.enabled` / `when.disabled` conditions. Agents may be a plain name
       or a map with `name` plus optional `when` and `owner`. `when.*.tool`
       matches the agent name (skills CLI slug), not the lifecycle owner.
       A map `owner` is the tools.yaml switch when the slug is not the tool
       name. A bare name still looks itself up in tools.yaml when declared. */ -}}
{{- $skill := .skill -}}
{{- $allAgents := .skills.agents -}}
{{- $agents := list -}}
{{- $skillEnabled := includeTemplate "tool/item-enabled" (merge (dict "item" $skill) .) | fromJson -}}
{{- if $skillEnabled -}}
{{- range $agentEntry := $allAgents -}}
  {{- $agent := $agentEntry -}}
  {{- $agentSpec := dict -}}
  {{- if eq (kindOf $agentEntry) "map" -}}
    {{- $agent = $agentEntry.name -}}
    {{- $agentSpec = $agentEntry -}}
  {{- end -}}
  {{- $agentValues := dict
        "device_type" $.device_type
        "host_env" $.host_env
        "os" $.chezmoi.os
        "roles" $.roles
        "mem_gb" (dig "mem_gb" 0 $)
        "disk_gb" (dig "disk_gb" 0 $)
        "tool" $agent -}}
  {{- $agentEnabled := true -}}
  {{- $agentOwner := dig "owner" "" $agentSpec -}}
  {{- if $agentOwner -}}
    {{- $agentEnabled = includeTemplate "tool/enabled" (merge (dict "tool" $agentOwner "require" true) $) | fromJson -}}
  {{- else if hasKey (default dict $.tools) $agent -}}
    {{- $agentEnabled = includeTemplate "tool/enabled" (merge (dict "tool" $agent) $) | fromJson -}}
  {{- end -}}
  {{- if $agentEnabled -}}
    {{- $agentEnabled = includeTemplate "when/evaluate" (dict
          "item" $agentSpec
          "values" $agentValues
          "os_version" (dig "os_version" "" $)) | fromJson -}}
  {{- end -}}
  {{- if $agentEnabled -}}
    {{- $enabled := includeTemplate "when/evaluate" (dict
          "item" $skill
          "values" $agentValues
          "os_version" (dig "os_version" "" $)) | fromJson -}}
    {{- if $enabled -}}
      {{- $agents = append $agents $agent -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- end -}}
{{- toJson $agents -}}
