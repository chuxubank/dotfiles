{{- /* Resolve agents for a skill based on `when.enabled` / `when.disabled` conditions.
       Legacy `hosttype` remains supported for compatibility. */ -}}
{{- $skill := .skill -}}
{{- $allAgents := .agents -}}

{{- $hosttypeOk := includeTemplate "when/check" (dict "item" $skill "key" "hosttype" "value" .hosttype) | fromJson -}}
{{- $deviceTypeOk := includeTemplate "when/check" (dict "item" $skill "key" "device_type" "value" .device_type) | fromJson -}}
{{- $hostEnvOk := includeTemplate "when/check" (dict "item" $skill "key" "host_env" "value" .host_env) | fromJson -}}
{{- $rolesOk := includeTemplate "when/check" (dict "item" $skill "key" "roles" "value" .roles) | fromJson -}}

{{- if not (and $hosttypeOk $deviceTypeOk $hostEnvOk $rolesOk) -}}
  {{- toJson list -}}
{{- else -}}
  {{- $agents := $allAgents -}}
  {{- if hasKey $skill "when" -}}
    {{- $when := $skill.when -}}
    {{- if and (hasKey $when "enabled") (hasKey $when.enabled "tool") -}}
      {{- $agents = $when.enabled.tool -}}
    {{- else if and (hasKey $when "disabled") (hasKey $when.disabled "tool") -}}
      {{- $agents = list -}}
      {{- range $a := $allAgents -}}
        {{- if not (has $a $when.disabled.tool) -}}
          {{- $agents = append $agents $a -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- toJson $agents -}}
{{- end -}}
