{{- $selected := list -}}
{{ range $package := . -}}
{{ if eq (kindOf $package) "map" -}}
{{- $enabled := true -}}
{{- if hasKey $package "when" -}}
  {{- $enabled = includeTemplate "when/context" (merge (dict "item" $package) $) | fromJson -}}
{{- end -}}
{{ if $enabled -}}
{{- $selected = append $selected .name -}}
{{ end -}}
{{ else -}}
{{- $selected = append $selected . -}}
{{ end -}}
{{- end -}}
{{- $length := len $selected -}}
{{- range $index, $name := $selected -}}
{{- $name -}}
{{- if lt (add $index 1) $length }} \
{{ end -}}
{{ end }}
