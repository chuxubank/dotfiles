{{- /* Source-state ignore for disabled tools.
       foo/** ignores foo so .chezmoiremove can still delete children.
       Nested files ignore dirname (a/b/c -> a/b), never the first
       segment alone (.config/rclone/x must not ignore .config).
       Ignore both remove and purge so apply does not recreate files
       while runtime data is retained. */ -}}
{{- $ctx := . -}}
{{- range $name, $spec := default dict $ctx.tools -}}
  {{- if not (includeTemplate "tool/enabled" (merge (dict "tool" $name) $ctx) | fromJson) -}}
    {{- $patterns := dig "remove" (list) $spec -}}
    {{- range $p := dig "purge" (list) $spec -}}
      {{- $patterns = append $patterns $p -}}
    {{- end -}}
    {{- range $pattern := $patterns -}}
      {{- if hasSuffix "/**" $pattern }}
{{ trimSuffix "/**" $pattern }}
      {{- else if contains "/" $pattern -}}
        {{- $parts := splitList "/" $pattern -}}
        {{- if gt (len $parts) 1 }}
{{ slice $parts 0 (sub (len $parts) 1) | join "/" }}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
