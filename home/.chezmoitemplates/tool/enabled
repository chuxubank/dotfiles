{{- /* tool/enabled — Is this declared tool wanted on this host?
       Input: dict "tool" <name> (merged with root context $)
              optional "require" bool — fail when the name is not in tools.
       Undeclared names are enabled unless require is set.
       Lifecycle affiliation on data items is `owner`; this template
       still takes the declared name as `tool`.
       Output: JSON boolean */ -}}
{{- $name := .tool -}}
{{- if not $name -}}
  {{- fail "tool/enabled: missing tool name" -}}
{{- end -}}
{{- $declared := default dict .tools -}}
{{- if not (hasKey $declared $name) -}}
  {{- if dig "require" false . -}}
    {{- fail (printf "unknown tool %q" $name) -}}
  {{- else -}}
    {{- toJson true -}}
  {{- end -}}
{{- else -}}
  {{- /* Drop a caller item first. merge keeps that item, and enabled:false
         is empty, so a package when would hide a disabled tool. */ -}}
  {{- includeTemplate "when/context" (merge (omit . "item") (dict "item" (index $declared $name))) -}}
{{- end -}}
