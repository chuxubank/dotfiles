{{- /* llm/compaction-thresholds — Shared compaction rules.
       Input: root context (.llm.compaction.thresholds, .llm.models).
       Output: JSON list of {match, stem, regex, percent|reserve_tokens}.

       match is a double-star prefix plus a final-segment name and a
       trailing star, tested against provider/id. The double star crosses
       slashes; the trailing star consumes the rest of the last segment.
       ${name} expands from llm.models before that check. stem is that
       name. regex is the same rule for regexMatch. A rule is either a
       percent of the window (1–99) or an absolute reserve_tokens value. */ -}}
{{- $rules := dig "compaction" "thresholds" (list) .llm -}}
{{- if eq (len $rules) 0 -}}
  {{- fail "llm.compaction.thresholds is empty" -}}
{{- end -}}
{{- $aliases := default dict .llm.models -}}
{{- $out := list -}}
{{- range $rule := $rules -}}
  {{- $raw := printf "%v" (index $rule "match") -}}
  {{- $match := includeTemplate "llm/resolve-model-alias" (dict "model" $raw "aliases" $aliases) -}}
  {{- if not (regexMatch "^\\*\\*/[A-Za-z0-9][A-Za-z0-9._-]*\\*$" $match) -}}
    {{- fail (printf "llm.compaction.thresholds match %q must look like **/name*" $match) -}}
  {{- end -}}
  {{- $hasPercent := hasKey $rule "percent" -}}
  {{- $hasReserve := hasKey $rule "reserve_tokens" -}}
  {{- if or (and $hasPercent $hasReserve) (not (or $hasPercent $hasReserve)) -}}
    {{- fail (printf "llm.compaction.thresholds %q needs percent or reserve_tokens, not both" $match) -}}
  {{- end -}}
  {{- $stem := trimSuffix "*" (trimPrefix "**/" $match) -}}
  {{- $quoted := $stem -}}
  {{- range $char := list "." "+" "?" "(" ")" "[" "]" "{" "}" "|" "^" "$" -}}
    {{- $quoted = replace $char (printf "\\%s" $char) $quoted -}}
  {{- end -}}
  {{- $entry := dict "match" $match "stem" $stem "regex" (printf "(^|.*/)%s[^/]*$" $quoted) -}}
  {{- if $hasPercent -}}
    {{- $percent := int (index $rule "percent") -}}
    {{- if or (le $percent 0) (ge $percent 100) -}}
      {{- fail (printf "llm.compaction.thresholds percent %v is outside 1–99" $percent) -}}
    {{- end -}}
    {{- $_ := set $entry "percent" $percent -}}
  {{- else -}}
    {{- $reserve := int (index $rule "reserve_tokens") -}}
    {{- if le $reserve 0 -}}
      {{- fail (printf "llm.compaction.thresholds reserve_tokens %v must be positive" $reserve) -}}
    {{- end -}}
    {{- $_ := set $entry "reserve_tokens" $reserve -}}
  {{- end -}}
  {{- $out = append $out $entry -}}
{{- end -}}
{{- toJson $out -}}
