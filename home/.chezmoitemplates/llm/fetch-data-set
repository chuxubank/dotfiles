{{- /* llm/fetch-data-set — Fetch raw model data from a data set.
   Works like fetch-models but returns full model metadata from a data catalog.
   Input: dict with "type", "file" or "base_url" (from llm.data_sets.<name>)
          Optional "provider" — only return models from this source provider
   Output: flat JSON dict of { model_id: { name, cost, open_weights, modalities, ... } }
   Returns empty dict on failure.
*/ -}}
{{- $models := dict -}}
{{- $file := "" -}}
{{- if hasKey . "file" -}}{{- $file = .file -}}{{- end -}}
{{- $baseURL := "" -}}
{{- if hasKey . "base_url" -}}{{- $baseURL = .base_url -}}{{- end -}}
{{- if or $file $baseURL -}}
  {{- $raw := dict -}}
  {{- $type := "" -}}
  {{- if hasKey . "type" -}}{{- $type = .type -}}{{- end -}}
  {{- if $file -}}
    {{- $raw = output "sh" "-c" (printf "test -r '%s' && cat '%s' 2>/dev/null || echo '{}'" $file $file) | trim | fromJson -}}
  {{- else -}}
    {{- $fetchURL := printf "%s/api.json" $baseURL -}}
    {{- $raw = includeTemplate "http/get-json" (dict "url" $fetchURL "label" (printf "llm/fetch-data-set:%s" $type) "timeout" 3) | fromJson -}}
  {{- end -}}
  {{- $targetProv := "" -}}
  {{- if hasKey . "provider" -}}{{- $targetProv = .provider -}}{{- end -}}
  {{- if eq $type "models-dev" -}}
    {{- /* models.dev response: { provider_id: { id, name, api, models: { model_id: { name, cost, ... } } } } */ -}}
    {{- range $pid, $p := $raw -}}
      {{- if or (not $targetProv) (eq $pid $targetProv) -}}
        {{- if hasKey $p "models" -}}
          {{- range $mid, $m := $p.models -}}
            {{- $_ := set $models $mid $m -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- toJson $models -}}
