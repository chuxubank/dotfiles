{{- /* llm/fetch-data-set — Fetch raw model data from a data set.
   Works like fetch-models but returns full model metadata from a data catalog.
   Input: dict with "type", "file" or "base_url" (from llm.data_sets.<name>)
          Optional "provider" — only return models from this source provider
          Optional "providers" — first-listed source wins on id collision;
                   takes precedence over "provider"
                   "map_api" — enrich models with canonical API metadata
   Output: flat JSON dict of { model_id: { name, cost, modalities, api, ... } }.
           `api` is canonical metadata produced by llm/model-api; source-specific
           transport fields remain available for adapters that need them.
   Returns empty dict on failure.
*/ -}}
{{- $models := dict -}}
{{- $file := "" -}}
{{- if hasKey . "file" -}}{{- $file = .file -}}{{- end -}}
{{- $baseURL := "" -}}
{{- if hasKey . "base_url" -}}{{- $baseURL = .base_url -}}{{- end -}}
{{- if or $file $baseURL -}}
  {{- $raw := dict -}}
  {{- $type := "" -}}
  {{- if hasKey . "type" -}}{{- $type = .type -}}{{- end -}}
  {{- if $file -}}
    {{- $raw = output "sh" "-c" (printf "test -r '%s' && cat '%s' 2>/dev/null || echo '{}'" $file $file) | trim | fromJson -}}
  {{- else -}}
    {{- $fetchURL := printf "%s/api.json" $baseURL -}}
    {{- $raw = includeTemplate "http/get-json" (dict "url" $fetchURL "label" (printf "llm/fetch-data-set:%s" $type) "timeout" 3) | fromJson -}}
  {{- end -}}
  {{- $targetProvs := list -}}
  {{- if hasKey . "providers" -}}{{- $targetProvs = .providers -}}
  {{- else if hasKey . "provider" -}}{{- $targetProvs = list .provider -}}
  {{- end -}}
  {{- if eq $type "models-dev" -}}
    {{- /* models.dev response: { provider_id: { id, name, api, models: { model_id: { name, cost, ... } } } } */ -}}
    {{- if gt (len $targetProvs) 0 -}}
      {{- /* Preference order: first-listed source keeps the id. */ -}}
      {{- range $pid := $targetProvs -}}
        {{- if hasKey $raw $pid -}}
          {{- $p := index $raw $pid -}}
          {{- if hasKey $p "models" -}}
            {{- range $mid, $m := $p.models -}}
              {{- if not (hasKey $models $mid) -}}
                {{- if and (hasKey $ "map_api") $.map_api -}}
                  {{- $model := deepCopy $m -}}
                  {{- $api := includeTemplate "llm/model-api" (dict "type" $type "provider" $p "model" $m) | trim -}}
                  {{- if $api -}}{{- $_ := set $model "api" $api -}}{{- end -}}
                  {{- $_ := set $models $mid $model -}}
                {{- else -}}
                  {{- $_ := set $models $mid $m -}}
                {{- end -}}
              {{- end -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- else -}}
      {{- /* Unfiltered flatten is last-wins, matching the historical union. */ -}}
      {{- range $pid, $p := $raw -}}
        {{- if hasKey $p "models" -}}
          {{- range $mid, $m := $p.models -}}
            {{- if and (hasKey $ "map_api") $.map_api -}}
              {{- $model := deepCopy $m -}}
              {{- $api := includeTemplate "llm/model-api" (dict "type" $type "provider" $p "model" $m) | trim -}}
              {{- if $api -}}{{- $_ := set $model "api" $api -}}{{- end -}}
              {{- $_ := set $models $mid $model -}}
            {{- else -}}
              {{- $_ := set $models $mid $m -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- toJson $models -}}
