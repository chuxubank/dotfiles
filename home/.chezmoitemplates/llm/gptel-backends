{{- /* llm/gptel-backends — GPTel backends and updater model strings.
       Input: root context.
       Output JSON:
         backends — resolved aliases gptel can construct, alias-sorted
         models, small_models — "MenuName:model-id" candidates

       One llm/tool-config call. A backend requires a base URL; login
       aliases have none and are skipped. Request headers cannot be sent
       by these constructors, so a header map fails instead of vanishing.
       openai-responses is not constructed: gptel-make-openai selects
       Responses only when the host is api.openai.com.

       Model strings keep every declared candidate. tool-config omits an
       alias that is off, and the menu name still has to be the one that
       alias would have registered, because the updater skips a missing
       backend rather than dropping the candidate. */ -}}
{{- $cfg := includeTemplate "llm/tool-config" (mergeOverwrite (deepCopy .) (dict "tool" "gptel")) | fromJson -}}
{{- $toolCfg := index .llm.tools "gptel" -}}
{{- $llmProviders := .llm.providers -}}
{{- $modelAliases := default dict .llm.models -}}

{{- /* Same reference merge as tool-config, names only. Disabled aliases
       are absent from $cfg.providers, which is why this is not a second
       resolve. */ -}}
{{- $refs := dict -}}
{{- $defaults := default dict (index .llm "default_providers") -}}
{{- if eq (kindOf $defaults) "slice" -}}
  {{- range $name := $defaults -}}
    {{- $_ := set $refs $name (dict "provider" $name) -}}
  {{- end -}}
{{- else -}}
  {{- $refs = deepCopy $defaults -}}
{{- end -}}
{{- $sets := concat (default (list) (index .llm "default_provider_sets")) (default (list) (index $toolCfg "provider_sets")) | uniq -}}
{{- range $setName := $sets -}}
  {{- $set := index (default dict (index $.llm "provider_sets")) $setName -}}
  {{- if not $set -}}
    {{- fail (printf "llm provider_sets: unknown set %q" $setName) -}}
  {{- end -}}
  {{- range $alias, $ref := $set -}}
    {{- $_ := set $refs $alias (mergeOverwrite (deepCopy (default dict (index $refs $alias))) (deepCopy $ref)) -}}
  {{- end -}}
{{- end -}}
{{- if hasKey $toolCfg "providers" -}}
  {{- $raw := $toolCfg.providers -}}
  {{- if eq (kindOf $raw) "slice" -}}
    {{- range $name := $raw -}}
      {{- $_ := set $refs $name (mergeOverwrite (deepCopy (default dict (index $refs $name))) (dict "provider" $name)) -}}
    {{- end -}}
  {{- else -}}
    {{- range $alias, $ref := $raw -}}
      {{- if hasKey $refs $alias -}}
        {{- $ref = mergeOverwrite (deepCopy (index $refs $alias)) (deepCopy $ref) -}}
      {{- end -}}
      {{- $_ := set $refs $alias $ref -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $alias := default (list) (index $toolCfg "exclude_providers") -}}
  {{- $_ := unset $refs $alias -}}
{{- end -}}

{{- $names := dict -}}
{{- range $alias, $ref := $refs -}}
  {{- $provName := index $ref "provider" -}}
  {{- if not (hasKey $llmProviders $provName) -}}
    {{- fail (printf "gptel: unknown provider %q for alias %q" $provName $alias) -}}
  {{- end -}}
  {{- $prov := index $llmProviders $provName -}}
  {{- $display := $alias -}}
  {{- if hasKey $prov "name" -}}{{- $display = index $prov "name" -}}{{- end -}}
  {{- if hasKey $ref "name" -}}{{- $display = index $ref "name" -}}{{- end -}}
  {{- if hasKey $cfg.providers $alias -}}
    {{- $resolvedName := (index $cfg.providers $alias).display_name -}}
    {{- if ne $resolvedName $display -}}
      {{- fail (printf "gptel: display name for %s is %q from tool-config and %q from declarations" $alias $resolvedName $display) -}}
    {{- end -}}
  {{- end -}}
  {{- $_ := set $names $alias $display -}}
{{- end -}}

{{- $rendered := dict -}}
{{- range $group := list (dict "src" "model" "dst" "models") (dict "src" "small_model" "dst" "small_models") -}}
  {{- $raw := list -}}
  {{- if hasKey $toolCfg $group.src -}}{{- $raw = index $toolCfg $group.src -}}{{- end -}}
  {{- if eq (kindOf $raw) "string" -}}
    {{- $raw = list $raw -}}
  {{- else if ne (kindOf $raw) "slice" -}}
    {{- fail (printf "gptel: %s must be a string or a list" $group.src) -}}
  {{- end -}}
  {{- $out := list -}}
  {{- range $candidate := $raw -}}
    {{- if ne (kindOf $candidate) "string" -}}
      {{- fail (printf "gptel: %s entry must be a string" $group.src) -}}
    {{- end -}}
    {{- $resolved := includeTemplate "llm/resolve-model-alias" (dict "model" $candidate "aliases" $modelAliases) -}}
    {{- $parts := splitList "/" $resolved -}}
    {{- if or (le (len $parts) 1) (not (hasKey $names (index $parts 0))) -}}
      {{- fail (printf "gptel: model %q is not a declared <alias>/<id>" $resolved) -}}
    {{- end -}}
    {{- $alias := index $parts 0 -}}
    {{- $id := join "/" (rest $parts) -}}
    {{- if not $id -}}
      {{- fail (printf "gptel: model %q has no id" $resolved) -}}
    {{- end -}}
    {{- $display := index $names $alias -}}
    {{- if contains ":" $display -}}
      {{- fail (printf "gptel: display name %q contains ':'" $display) -}}
    {{- end -}}
    {{- $out = append $out (printf "%s:%s" $display $id) -}}
  {{- end -}}
  {{- $_ := set $rendered $group.dst $out -}}
{{- end -}}

{{- $backends := list -}}
{{- $seenNames := dict -}}
{{- range $alias := keys $cfg.providers | sortAlpha -}}
  {{- $ep := index $cfg.providers $alias -}}
  {{- if index $ep "headers" -}}
    {{- fail (printf "gptel: alias %s has request headers, which this backend cannot send" $alias) -}}
  {{- end -}}
  {{- $base := trimSuffix "/" (default "" (index $ep "base_url")) -}}
  {{- if $base -}}
    {{- if not (regexMatch "^[A-Za-z0-9-]+$" $alias) -}}
      {{- fail (printf "gptel: alias %q cannot be a Lisp symbol" $alias) -}}
    {{- end -}}
    {{- $display := $ep.display_name -}}
    {{- if contains ":" $display -}}
      {{- fail (printf "gptel: display name %q contains ':'" $display) -}}
    {{- end -}}
    {{- if hasKey $seenNames $display -}}
      {{- fail (printf "gptel: display name %q is shared by %s and %s" $display (index $seenNames $display) $alias) -}}
    {{- end -}}
    {{- $_ := set $seenNames $display $alias -}}
    {{- $parsed := urlParse $base -}}
    {{- $host := $parsed.host -}}
    {{- $protocol := $parsed.scheme -}}
    {{- if or (not $host) (not $protocol) -}}
      {{- fail (printf "gptel: alias %s base URL %q has no host" $alias $base) -}}
    {{- end -}}
    {{- $type := $ep.type -}}
    {{- $constructor := "" -}}
    {{- $endpoint := "" -}}
    {{- if eq $type "openai-completions" -}}
      {{- $constructor = "gptel-make-openai" -}}
      {{- /* The endpoint is a path on the host. A first segment that is
             neither "api" nor a version is not an API base: Magpie's public
             URL is an origin, and that suffix must not enter
             /v1/chat/completions. /api is OpenRouter's base and stays.
             model-endpoint adds /v1 when the base has no version. */ -}}
      {{- $path := $parsed.path -}}
      {{- $first := trimPrefix "/" $path -}}
      {{- if contains "/" $first -}}{{- $first = index (splitList "/" $first) 0 -}}{{- end -}}
      {{- $apiBase := $base -}}
      {{- if and (ne $path "") (ne $path "/") (ne $first "api") (not (regexMatch "^v[0-9]" $first)) -}}
        {{- $apiBase = printf "%s://%s" $protocol $host -}}
      {{- end -}}
      {{- $info := includeTemplate "llm/model-endpoint" (dict "type" $type "base_url" $apiBase) | fromJson -}}
      {{- $apiPath := (urlParse $info.api_base_url).path -}}
      {{- if not $apiPath -}}
        {{- fail (printf "gptel: alias %s OpenAI base %q has no path" $alias $apiBase) -}}
      {{- end -}}
      {{- $endpoint = printf "%s/chat/completions" $apiPath -}}
    {{- else if eq $type "anthropic-messages" -}}
      {{- $constructor = "gptel-make-anthropic" -}}
      {{- /* An empty path on the origin is /v1/messages. A base that already
             ends in /v1 keeps that prefix. */ -}}
      {{- $messagesURL := $base -}}
      {{- if not (hasSuffix "/v1" $messagesURL) -}}
        {{- $messagesURL = printf "%s/v1" $messagesURL -}}
      {{- end -}}
      {{- $endpoint = (urlParse (printf "%s/messages" $messagesURL)).path -}}
    {{- else if eq $type "google-generative-ai" -}}
      {{- $constructor = "gptel-make-gemini" -}}
      {{- $info := includeTemplate "llm/model-endpoint" (dict "type" $type "base_url" $base) | fromJson -}}
      {{- $apiPath := (urlParse $info.api_base_url).path -}}
      {{- if not $apiPath -}}
        {{- fail (printf "gptel: alias %s Gemini base %q has no path" $alias $base) -}}
      {{- end -}}
      {{- $endpoint = printf "%s/models" $apiPath -}}
    {{- else if eq $type "ollama" -}}
      {{- /* model-endpoint appends /v1. gptel-make-ollama talks to the
             origin at /api/chat, so that base is not used. */ -}}
      {{- $constructor = "gptel-make-ollama" -}}
      {{- $endpoint = "/api/chat" -}}
    {{- else -}}
      {{- fail (printf "gptel: alias %s type %q is not a gptel backend" $alias $type) -}}
    {{- end -}}
    {{- $backend := dict
      "alias" $alias
      "symbol" (printf "gptel--%s" $alias)
      "name" $display
      "constructor" $constructor
      "host" $host
      "protocol" $protocol
      "endpoint" $endpoint
    -}}
    {{- if index $ep "auth_path" -}}
      {{- $_ := set $backend "auth_path" $ep.auth_path -}}
      {{- if index $ep "auth_field" -}}{{- $_ := set $backend "auth_field" $ep.auth_field -}}{{- end -}}
    {{- end -}}
    {{- if index $ep "cache_file" -}}{{- $_ := set $backend "cache_file" $ep.cache_file -}}{{- end -}}
    {{- if hasKey $ep "model_metadata_args" -}}
      {{- $args := $ep.model_metadata_args | fromJson -}}
      {{- $meta := list "all" -}}
      {{- if and (hasKey $args "providers") (gt (len $args.providers) 0) -}}
        {{- $meta = $args.providers -}}
      {{- end -}}
      {{- $_ := set $backend "metadata_providers" $meta -}}
    {{- end -}}
    {{- if and (hasKey $ep "models") (eq (kindOf $ep.models) "slice") (gt (len $ep.models) 0) -}}
      {{- $parts := list -}}
      {{- range $id := $ep.models -}}
        {{- if ne (kindOf $id) "string" -}}
          {{- fail (printf "gptel: alias %s model id must be a string" $alias) -}}
        {{- end -}}
        {{- $escaped := $id -}}
        {{- $escaped = replace "\\" "\\\\" $escaped -}}
        {{- range $ch := list "." "^" "$" "*" "+" "?" "(" ")" "[" "]" "{" "}" "|" -}}
          {{- $escaped = replace $ch (printf "\\%s" $ch) $escaped -}}
        {{- end -}}
        {{- $parts = append $parts $escaped -}}
      {{- end -}}
      {{- $include := printf "^%s$" (index $parts 0) -}}
      {{- if gt (len $parts) 1 -}}
        {{- $include = printf "^\\(%s\\)$" (join "\\|" $parts) -}}
      {{- end -}}
      {{- $_ := set $backend "include" $include -}}
    {{- end -}}
    {{- $backends = append $backends $backend -}}
  {{- end -}}
{{- end -}}

{{- dict "backends" $backends "models" $rendered.models "small_models" $rendered.small_models | toJson -}}
