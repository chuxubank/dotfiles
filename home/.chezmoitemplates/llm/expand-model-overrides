{{- /* llm/expand-model-overrides — Fan modelOverrides out to sibling ids.
       Input: { overrides: dict, prefixes: list }
       Output: JSON dict.

       Cost copies. An existing key is never replaced:
       - prefixes (`cursor-` + id)
       - one effort suffix on a stem (`-high`, `-thinking`, ...)
       - Claude thinking compounds `{stem}-thinking-{effort}` and
         `{stem}-{effort}-thinking`, including the `*-fast` twin
       - a dedicated `*-fast` key expands to `*-{effort}-fast`.
         It does not price the non-fast ids.

       Image input follows a stem only when that stem has a dedicated
       `*-fast` key. The fast lane is the same model at another rate, and
       Cursor's Grok effort ids are text-only, so those siblings would
       otherwise hide the stem card's image input. Stems with no fast key
       stay cost-only: their live catalog modalities are left alone. A
       named card is not copied onto the fast id. */ -}}
{{- $in := . -}}
{{- $overrides := default dict (index $in "overrides") -}}
{{- $prefixes := default (list) (index $in "prefixes") -}}
{{- $efforts := list "none" "minimal" "low" "medium" "high" "xhigh" "max" "thinking" -}}

{{- $base := dict -}}
{{- range $id, $ov := $overrides -}}
  {{- $_ := set $base $id $ov -}}
  {{- $costCopy := dict -}}
  {{- if hasKey $ov "cost" -}}{{- $costCopy = dict "cost" $ov.cost -}}{{- end -}}
  {{- if gt (len $costCopy) 0 -}}
    {{- range $pfx := $prefixes -}}
      {{- if not (hasPrefix $pfx $id) -}}
        {{- $pid := printf "%s%s" $pfx $id -}}
        {{- if not (hasKey $base $pid) -}}{{- $_ := set $base $pid $costCopy -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $expanded := dict -}}
{{- range $id, $ov := $base -}}
  {{- $_ := set $expanded $id $ov -}}
{{- end -}}
{{- range $id, $ov := $base -}}
  {{- $patch := dict -}}
  {{- if hasKey $ov "cost" -}}{{- $_ := set $patch "cost" $ov.cost -}}{{- end -}}
  {{- if gt (len $patch) 0 -}}
    {{- $lane := $id -}}
    {{- $fast := false -}}
    {{- if hasSuffix "-fast" $id -}}
      {{- $fast = true -}}
      {{- $lane = trimSuffix "-fast" $id -}}
    {{- end -}}
    {{- $isEffort := false -}}
    {{- range $suf := $efforts -}}
      {{- if hasSuffix (printf "-%s" $suf) $lane -}}{{- $isEffort = true -}}{{- end -}}
    {{- end -}}
    {{- if not $isEffort -}}
      {{- $stemId := $lane -}}
      {{- range $pfx := $prefixes -}}
        {{- if hasPrefix $pfx $stemId -}}
          {{- $stemId = trimPrefix $pfx $stemId -}}
        {{- end -}}
      {{- end -}}
      {{- if and (hasKey $base $stemId) (hasKey $base (printf "%s-fast" $stemId)) -}}
        {{- $stem := index $base $stemId -}}
        {{- if hasKey $stem "input" -}}
          {{- $image := false -}}
          {{- range $mod := $stem.input -}}
            {{- if eq $mod "image" -}}{{- $image = true -}}{{- end -}}
          {{- end -}}
          {{- if $image -}}{{- $_ := set $patch "input" $stem.input -}}{{- end -}}
        {{- end -}}
      {{- end -}}
      {{- range $suf := $efforts -}}
        {{- $sibling := printf "%s-%s" $lane $suf -}}
        {{- if $fast -}}{{- $sibling = printf "%s-fast" $sibling -}}{{- end -}}
        {{- if not (hasKey $expanded $sibling) -}}{{- $_ := set $expanded $sibling $patch -}}{{- end -}}
        {{- if and (hasPrefix "claude-" $lane) (ne $suf "thinking") -}}
          {{- $thinkFirst := printf "%s-thinking-%s" $lane $suf -}}
          {{- $thinkLast := printf "%s-%s-thinking" $lane $suf -}}
          {{- if $fast -}}
            {{- $thinkFirst = printf "%s-fast" $thinkFirst -}}
            {{- $thinkLast = printf "%s-fast" $thinkLast -}}
          {{- end -}}
          {{- if not (hasKey $expanded $thinkFirst) -}}{{- $_ := set $expanded $thinkFirst $patch -}}{{- end -}}
          {{- if not (hasKey $expanded $thinkLast) -}}{{- $_ := set $expanded $thinkLast $patch -}}{{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- toJson $expanded -}}
