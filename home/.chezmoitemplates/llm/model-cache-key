{{- $provider := .provider -}}
{{- $authField := default "" (index . "auth_field") -}}
{{- $result := "" -}}
{{- $providerConfig := index .llm.providers $provider -}}
{{- if hasKey $providerConfig "model_caches" -}}
  {{- range $key, $cache := $providerConfig.model_caches -}}
    {{- $cacheField := default "" (index $cache "auth_field") -}}
    {{- if and (eq $result "") (eq $cacheField $authField) -}}
      {{- $result = $key -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $result -}}
