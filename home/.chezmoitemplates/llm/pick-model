{{- /* llm/pick-model — Pick first model from list whose provider is available.
        Input: dict "models" <list> "providers" <dict>
        Output: chosen model string
*/ -}}
{{- $chosen := "" -}}
{{- range $m := .models -}}
  {{- if not $chosen -}}
    {{- $selection := includeTemplate "llm/split-model" (dict "model" $m "providers" $.providers) | fromJson -}}
    {{- if $selection.provider -}}
      {{- $chosen = $m -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- if not $chosen -}}{{- $chosen = index .models 0 -}}{{- end -}}{{- $chosen -}}
