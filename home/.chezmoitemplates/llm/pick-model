{{- /* llm/pick-model — Pick first model from list whose provider alias resolved.
        Input: dict "models" <list> "providers" <dict>
        Output: chosen model string

        If no alias resolves, take the last candidate. */ -}}
{{- $chosen := "" -}}
{{- range $m := .models -}}
  {{- if not $chosen -}}
    {{- $selection := includeTemplate "llm/split-model" (dict "model" $m "providers" $.providers) | fromJson -}}
    {{- if $selection.provider -}}
      {{- $chosen = $m -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- if not $chosen -}}
  {{- range .models -}}{{- $chosen = . -}}{{- end -}}
{{- end -}}{{- $chosen -}}
