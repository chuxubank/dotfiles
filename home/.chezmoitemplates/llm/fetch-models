{{- /* llm/fetch-models — Fetch model list from a provider endpoint.
       Input: dict with "type", "base_url", "auth_key"
       Optional "cache_file" — read the raw response from this file
              (populated by an external or refresh script) instead of
              a live curl.
       Optional "metadata" — return normalized model objects instead of names.
       Output: JSON map keyed by the exact upstream id.
       Returns empty map on failure or missing base_url.

       Provider types:
         openai (default):  GET /v1/models           → .data[]  (.id, .name)
         ollama:            GET /api/tags             → .models[] (.name)
         gemini:            GET /v1beta/models?key=   → .models[] (.name, .displayName)
*/ -}}
{{- $models := dict -}}
{{- $details := dict -}}
{{- if .base_url }}
  {{- $endpoint := includeTemplate "llm/model-endpoint" . | fromJson -}}
  {{- $fetchURL := $endpoint.url -}}
  {{- $headers := list -}}
  {{- $timeout := default 2 (index . "timeout") -}}
  {{- if and (eq $endpoint.auth_mode "bearer") .auth_key }}
    {{- $headers = append $headers (printf "Authorization: Bearer %s" .auth_key) -}}
  {{- else if and (hasPrefix "query:" $endpoint.auth_mode) .auth_key }}
    {{- $queryParam := trimPrefix "query:" $endpoint.auth_mode -}}
    {{- $separator := "?" -}}
    {{- if contains "?" $fetchURL -}}{{- $separator = "&" -}}{{- end -}}
    {{- $fetchURL = printf "%s%s%s=%s" $fetchURL $separator $queryParam .auth_key -}}
  {{- end }}
  {{- $raw := "" -}}
  {{- $cacheFile := default "" (index . "cache_file") -}}
  {{- if and $cacheFile (exec "test" "-r" $cacheFile) -}}
    {{- $raw = output "cat" $cacheFile | trim -}}
  {{- end -}}
  {{- /* A missing first-run cache must not suppress the provider catalog. The
         refresh script persists the same response for subsequent renders. */ -}}
  {{- if not $raw -}}
    {{- $raw = includeTemplate "http/get-json" (dict "url" $fetchURL "label" (printf "llm/fetch-models:%s:%s" .name .type) "headers" $headers "timeout" $timeout) -}}
  {{- end -}}
  {{- $resp := $raw | fromJson -}}
  {{- if eq .type "ollama" }}
    {{- if hasKey $resp "models" }}
      {{- range $m := $resp.models }}
        {{- $_ := set $models $m.name $m.name -}}
      {{- end }}
    {{- end }}
  {{- else if eq .type "gemini" }}
    {{- if hasKey $resp "models" }}
      {{- range $m := $resp.models }}
        {{- $id := $m.name -}}
        {{- if hasPrefix "models/" $id }}
          {{- $id = trimPrefix "models/" $id -}}
        {{- end }}
        {{- $display := $id -}}
        {{- if hasKey $m "displayName" }}
          {{- $display = $m.displayName -}}
        {{- end }}
        {{- $_ := set $models $id $display -}}
      {{- end }}
    {{- end }}
  {{- else if eq .type "opencode" }}
    {{- if hasKey $resp "opencode" -}}
      {{- $oc := $resp.opencode -}}
      {{- if hasKey $oc "models" -}}
        {{- range $id, $m := $oc.models -}}
          {{- $_ := set $models $id $m.name -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- else }}
    {{- if hasKey $resp "data" }}
      {{- range $m := $resp.data }}
        {{- $display := $m.id -}}
        {{- if hasKey $m "name" }}
          {{- $display = $m.name -}}
        {{- else if hasKey $m "display_name" }}
          {{- $display = $m.display_name -}}
        {{- end }}
        {{- $_ := set $models $m.id $display -}}
        {{- $_ := set $details $m.id $m -}}
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
{{- if eq true (index . "metadata") -}}
  {{- $normalized := dict -}}
  {{- range $id, $name := $models -}}
    {{- $raw := default dict (index $details $id) -}}
    {{- $model := dict "id" $id -}}
    {{- if ne $name $id -}}{{- $_ := set $model "name" $name -}}{{- end -}}
    {{- $limits := dict -}}
    {{- $context := default (index $raw "max_input_tokens") (default (index $raw "context_length") (index $raw "context_window")) -}}
    {{- if gt (int (default 0 $context)) 0 -}}{{- $_ := set $limits "context" (int $context) -}}{{- end -}}
    {{- if gt (int (default 0 (index $raw "max_output_tokens"))) 0 -}}
      {{- $_ := set $limits "output" (int (index $raw "max_output_tokens")) -}}
    {{- end -}}
    {{- if gt (len $limits) 0 -}}{{- $_ := set $model "limit" $limits -}}{{- end -}}
    {{- if hasKey $raw "modalities" -}}{{- $_ := set $model "modalities" $raw.modalities -}}{{- end -}}
    {{- if hasKey $raw "reasoning" -}}{{- $_ := set $model "reasoning" $raw.reasoning -}}{{- end -}}
    {{- $levels := default (list) (index $raw "reasoning_levels") -}}
    {{- if not $levels -}}
      {{- range $level := default (list) (index $raw "supported_reasoning_levels") -}}
        {{- $levels = append $levels $level.effort -}}
      {{- end -}}
    {{- end -}}
    {{- if $levels -}}
      {{- $_ := set $model "reasoning_options" (list (dict "type" "effort" "values" $levels)) -}}
    {{- end -}}
    {{- /* Gateway pricing is USD/token; internal cost cards use USD/million. */ -}}
    {{- if hasKey $raw "pricing" -}}
      {{- $cost := dict -}}
      {{- range $source, $target := dict "prompt" "input" "completion" "output" "input_cache_read" "cache_read" "input_cache_write" "cache_write" -}}
        {{- if hasKey $raw.pricing $source -}}
          {{- $_ := set $cost $target (mulf 1000000 (float64 (index $raw.pricing $source))) -}}
        {{- end -}}
      {{- end -}}
      {{- if gt (len $cost) 0 -}}{{- $_ := set $model "cost" $cost -}}{{- end -}}
    {{- end -}}
    {{- $_ := set $normalized $id $model -}}
  {{- end -}}
  {{- $models = $normalized -}}
{{- end -}}
{{- toJson $models -}}
