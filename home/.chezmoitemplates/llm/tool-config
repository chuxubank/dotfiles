{{- /* llm/tool-config — Resolve tool-level config from llm.tools.
       Input: dict "tool" <tool-name> (merged with root context $)
       Output JSON:
         model       — default model id
         small_model — small model id (if set)
         reasoning_effort — string (if set)
         providers   — map of alias -> resolved provider:
           name      — provider key in llm.providers
           base_url  — string
           auth_key  — resolved API key (with optional field override)

       Provider reference formats:
         Short:  providers: [iv, ollama]        — alias = provider name, default auth
         Map:    providers:
                   anthropic:                    — alias differs from provider name
                     provider: iv
                     auth_field: cc-auth-token   — optional auth override
*/ -}}
{{- $tool := .tool -}}
{{- $toolCfg := index .llm.tools $tool -}}
{{- $llmProviders := .llm.providers -}}
{{- $result := dict -}}

{{- if hasKey $toolCfg "reasoning_effort" }}
  {{- $_ := set $result "reasoning_effort" $toolCfg.reasoning_effort -}}
{{- end }}

{{- /* Normalize provider references into a uniform list of (alias, ref-map) */ -}}
{{- $refs := dict -}}
{{- if hasKey $toolCfg "providers" }}
  {{- $raw := $toolCfg.providers -}}
  {{- if eq (kindOf $raw) "slice" }}
    {{- /* Short form: ["iv", "ollama"] → alias = provider name */ -}}
    {{- range $name := $raw }}
      {{- $_ := set $refs $name (dict "provider" $name) -}}
    {{- end }}
  {{- else }}
    {{- /* Map form: { alias: { provider: ..., auth_field: ... } } */ -}}
    {{- range $alias, $ref := $raw }}
      {{- $_ := set $refs $alias $ref -}}
    {{- end }}
  {{- end }}
{{- end }}

{{- /* Resolve each provider reference */ -}}
{{- $ctx := . -}}
{{- $providers := dict -}}
{{- range $alias, $ref := $refs }}
  {{- $provName := $ref.provider -}}
  {{- $prov := index $llmProviders $provName -}}

  {{- /* Check if provider passes when.enabled conditions */ -}}
  {{- $enabled := true -}}
  {{- if hasKey $prov "when" -}}
    {{- $when := $prov.when -}}
    {{- if hasKey $when "enabled" -}}
      {{- $enabledCfg := $when.enabled -}}
      {{- if hasKey $enabledCfg "host_env" -}}
        {{- $heOk := false -}}
        {{- range $he := $enabledCfg.host_env -}}
          {{- if eq $ctx.host_env $he -}}{{- $heOk = true -}}{{- end -}}
        {{- end -}}
        {{- if not $heOk -}}{{- $enabled = false -}}{{- end -}}
      {{- end -}}
      {{- if hasKey $enabledCfg "roles" -}}
        {{- $hasRole := false -}}
        {{- if eq (kindOf $ctx.roles) "slice" -}}
          {{- range $ur := $ctx.roles -}}
            {{- range $r := $enabledCfg.roles -}}
              {{- if eq $ur $r -}}{{- $hasRole = true -}}{{- end -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
        {{- if not $hasRole -}}{{- $enabled = false -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- if $enabled -}}

  {{- /* Resolve auth key — use tool-level auth_field override if present */ -}}
  {{- $authKey := "" -}}
  {{- if hasKey $prov "auth" }}
    {{- $auth := $prov.auth -}}
    {{- $field := "" -}}
    {{- if hasKey $ref "auth_field" }}
      {{- $field = $ref.auth_field -}}
    {{- else if hasKey $auth "field" }}
      {{- $field = $auth.field -}}
    {{- end }}
    {{- if $field }}
      {{- $authKey = index (passFields $auth.path) $field -}}
    {{- else }}
      {{- $authKey = pass $auth.path -}}
    {{- end }}
  {{- end }}

  {{- $resolved := dict
    "name"     $provName
    "type"     (default "openai" (index $prov "type"))
    "base_url" (default "" (index $prov "base_url"))
    "auth_key" $authKey
  -}}
  {{- /* Resolve data_set: alias-level takes precedence, fall back to provider-level */ -}}
  {{- $dsName := "" -}}
  {{- if hasKey $ref "data_set" -}}
    {{- $dsName = $ref.data_set -}}
  {{- else if hasKey $prov "data_set" -}}
    {{- $dsName = $prov.data_set -}}
  {{- end -}}

  {{- if $dsName -}}
    {{- $ds := index $ctx.llm.data_sets $dsName -}}
    {{- if $ds -}}
      {{- $dsFetchArgs := dict "type" $ds.type "base_url" (default "" (index $ds "base_url")) -}}
      {{- if hasKey $ds "file_path" -}}
        {{- $dsFile := index $ctx.path $ds.file_path -}}
        {{- if not (hasPrefix "/" $dsFile) -}}{{- $dsFile = joinPath $ctx.chezmoi.homeDir $dsFile -}}{{- end -}}
        {{- $_ := set $dsFetchArgs "file" $dsFile -}}
      {{- else if hasKey $ds "file" -}}
        {{- $dsFile := $ds.file -}}
        {{- if not (hasPrefix "/" $dsFile) -}}{{- $dsFile = joinPath $ctx.chezmoi.homeDir $dsFile -}}{{- end -}}
        {{- $_ := set $dsFetchArgs "file" $dsFile -}}
      {{- end -}}
      {{- if hasKey $prov "provider" -}}{{- $_ := set $dsFetchArgs "provider" $prov.provider -}}{{- end -}}
      {{- $allModels := includeTemplate "llm/fetch-data-set" $dsFetchArgs | fromJson -}}
      {{- $filterArg := dict "models" $allModels -}}
      {{- $flt := dict -}}
      {{- if hasKey $ref "filter" -}}{{- $flt = $ref.filter -}}{{- else if hasKey $prov "filter" -}}{{- $flt = $prov.filter -}}{{- end -}}
      {{- $_ := set $filterArg "filter" $flt -}}
      {{- $mods := dict -}}
      {{- if hasKey $ref "modalities" -}}{{- $mods = $ref.modalities -}}{{- else if hasKey $prov "modalities" -}}{{- $mods = $prov.modalities -}}{{- end -}}
      {{- $_ := set $filterArg "modalities" $mods -}}
      {{- $filtered := includeTemplate "llm/filter-models" $filterArg | fromJson -}}
      {{- if gt (len $filtered) 0 -}}
        {{- $_ := set $resolved "models" $filtered -}}
      {{- end -}}
    {{- end -}}
  {{- else if hasKey $ref "models" }}
    {{- $_ := set $resolved "models" $ref.models -}}
  {{- end }}

  {{- $_ := set $providers $alias $resolved -}}
  {{- end -}}
{{- end }}
{{- $_ := set $result "providers" $providers -}}

{{- /* Resolve model: string → use as-is, list → pick first with available provider */ -}}
{{- if hasKey $toolCfg "model" -}}
  {{- if eq (kindOf $toolCfg.model) "slice" -}}
    {{- $_ := set $result "model" (includeTemplate "llm/pick-model" (dict "models" $toolCfg.model "providers" $providers)) -}}
  {{- else -}}
    {{- $_ := set $result "model" $toolCfg.model -}}
  {{- end -}}
{{- end -}}

{{- if hasKey $toolCfg "small_model" -}}
  {{- if eq (kindOf $toolCfg.small_model) "slice" -}}
    {{- $_ := set $result "small_model" (includeTemplate "llm/pick-model" (dict "models" $toolCfg.small_model "providers" $providers)) -}}
  {{- else -}}
    {{- $_ := set $result "small_model" $toolCfg.small_model -}}
  {{- end -}}
{{- end -}}

{{- toJson $result -}}
