{{- /* llm/tool-config — Resolve tool-level config from llm.tools.
       Input: dict "tool" <tool-name> (merged with root context $)
       Output JSON:
         model       — selected model in "<provider>/<model>" form
         model_provider — selected provider alias, or empty
         model_id    — selected model with a configured provider alias removed
          small_model — small model id (if set)
         small_model_provider — selected small-model provider alias, or empty
         small_model_id — selected small model with its provider alias removed
          reasoning_effort — string (if set)
          default_models — map of role -> model id (if set)
         providers   — map of alias -> resolved provider:
           name      — provider key in llm.providers
           base_url  — string
           auth_key  — resolved API key (with optional field override)
           auth_path — pass path used for auth (if set)
           auth_field — pass field used for auth (if set)
           timeout   — model fetch timeout in seconds (if set)
           headers   — static request headers (if set)
           model_metadata — map of model id -> data set metadata (if resolved)
           model_filter — model metadata filter (if set)

       Provider reference formats:
          Short:  providers: [iv, ollama]        — alias = provider name, default auth
          Map:    providers:
                    anthropic:                    — alias differs from provider name
                      provider: iv
                      name: Anthropic             — optional display name override
                      type: anthropic             — optional type override
                      auth_field: cc-auth-token   — optional auth override
*/ -}}
{{- $tool := .tool -}}
{{- $toolCfg := index .llm.tools $tool -}}
{{- $llmProviders := .llm.providers -}}
{{- $result := dict -}}

{{- if hasKey $toolCfg "reasoning_effort" }}
  {{- $_ := set $result "reasoning_effort" $toolCfg.reasoning_effort -}}
{{- end }}

{{- if hasKey $toolCfg "default_models" }}
  {{- $_ := set $result "default_models" $toolCfg.default_models -}}
{{- end }}

{{- /* Normalize provider references into a uniform list of (alias, ref-map) */ -}}
{{- $refs := dict -}}
{{- if hasKey $toolCfg "providers" }}
  {{- $raw := $toolCfg.providers -}}
  {{- if eq (kindOf $raw) "slice" }}
    {{- /* Short form: ["iv", "ollama"] → alias = provider name */ -}}
    {{- range $name := $raw }}
      {{- $_ := set $refs $name (dict "provider" $name) -}}
    {{- end }}
  {{- else }}
    {{- /* Map form: { alias: { provider: ..., auth_field: ... } } */ -}}
    {{- range $alias, $ref := $raw }}
      {{- $_ := set $refs $alias $ref -}}
    {{- end }}
  {{- end }}
{{- end }}

{{- /* Resolve each provider reference */ -}}
{{- $ctx := . -}}
{{- $providers := dict -}}
{{- range $alias, $ref := $refs }}
  {{- $provName := $ref.provider -}}
  {{- $prov := index $llmProviders $provName -}}

  {{- /* Check if provider passes when.enabled conditions */ -}}
  {{- $enabled := true -}}
  {{- if hasKey $prov "when" -}}
    {{- $when := $prov.when -}}
    {{- if hasKey $when "enabled" -}}
      {{- $enabledCfg := $when.enabled -}}
      {{- if hasKey $enabledCfg "host_env" -}}
        {{- $heOk := false -}}
        {{- range $he := $enabledCfg.host_env -}}
          {{- if eq $ctx.host_env $he -}}{{- $heOk = true -}}{{- end -}}
        {{- end -}}
        {{- if not $heOk -}}{{- $enabled = false -}}{{- end -}}
      {{- end -}}
      {{- if hasKey $enabledCfg "roles" -}}
        {{- $hasRole := false -}}
        {{- if eq (kindOf $ctx.roles) "slice" -}}
          {{- range $ur := $ctx.roles -}}
            {{- range $r := $enabledCfg.roles -}}
              {{- if eq $ur $r -}}{{- $hasRole = true -}}{{- end -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
        {{- if not $hasRole -}}{{- $enabled = false -}}{{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- if $enabled -}}

  {{- /* Resolve auth key — use tool-level auth_field override if present */ -}}
  {{- $authKey := "" -}}
  {{- $authPath := "" -}}
  {{- $authField := "" -}}
  {{- if hasKey $prov "auth" }}
    {{- $auth := $prov.auth -}}
    {{- $authPath = $auth.path -}}
    {{- $field := "" -}}
    {{- if hasKey $ref "auth_field" }}
      {{- $field = $ref.auth_field -}}
    {{- else if hasKey $auth "field" }}
      {{- $field = $auth.field -}}
    {{- end }}
    {{- $authField = $field -}}
    {{- $authKey = includeTemplate "safe/pass" (merge (dict "path" $auth.path "field" $field) $ctx) -}}
  {{- end }}

  {{- $displayName := $alias -}}
  {{- if hasKey $prov "name" -}}
    {{- $displayName = $prov.name -}}
  {{- end -}}
  {{- if hasKey $ref "name" -}}
    {{- $displayName = $ref.name -}}
  {{- end -}}

  {{- $resolved := dict
    "name"     $provName
    "display_name" $displayName
    "type"     (default (default "openai" (index $prov "type")) (index $ref "type"))
    "base_url" (default "" (index $prov "base_url"))
    "auth_key" $authKey
    "auth_path" $authPath
    "auth_field" $authField
  -}}
  {{- if hasKey $prov "timeout" -}}{{- $_ := set $resolved "timeout" $prov.timeout -}}{{- end -}}
  {{- if hasKey $ref "timeout" -}}{{- $_ := set $resolved "timeout" $ref.timeout -}}{{- end -}}
  {{- $headers := dict -}}
  {{- if hasKey $prov "headers" -}}{{- $headers = deepCopy $prov.headers -}}{{- end -}}
  {{- if hasKey $ref "headers" -}}{{- $headers = mergeOverwrite $headers (deepCopy $ref.headers) -}}{{- end -}}
  {{- if gt (len $headers) 0 -}}{{- $_ := set $resolved "headers" $headers -}}{{- end -}}
  {{- /* Resolve the cache declared for this provider/auth combination. */ -}}
  {{- $cacheKey := "" -}}
  {{- if hasKey $ref "models_cache" -}}{{- $cacheKey = $ref.models_cache -}}
  {{- else if hasKey $prov "models_cache" -}}{{- $cacheKey = $prov.models_cache -}}{{- end -}}
  {{- if not $cacheKey -}}
    {{- $cacheKey = includeTemplate "llm/model-cache-key" (merge (dict "provider" $provName "auth_field" $authField) $ctx) | trim -}}
  {{- end -}}
  {{- if $cacheKey -}}
    {{- $cacheFile := index $ctx.path.cache $cacheKey -}}
    {{- if not (hasPrefix "/" $cacheFile) -}}{{- $cacheFile = joinPath $ctx.chezmoi.homeDir $cacheFile -}}{{- end -}}
    {{- $_ := set $resolved "cache_file" $cacheFile -}}
  {{- end -}}
  {{- /* Resolve data_set: alias-level takes precedence, fall back to provider-level */ -}}
  {{- $dsName := "" -}}
  {{- if hasKey $ref "data_set" -}}
    {{- $dsName = $ref.data_set -}}
  {{- else if hasKey $prov "data_set" -}}
    {{- $dsName = $prov.data_set -}}
  {{- end -}}

  {{- if $dsName -}}
    {{- $ds := index $ctx.llm.data_sets $dsName -}}
    {{- if $ds -}}
      {{- $dsFetchArgs := dict "type" $ds.type "base_url" (default "" (index $ds "base_url")) -}}
      {{- if hasKey $ds "file_path" -}}
        {{- $dsFile := index $ctx.path.cache $ds.file_path -}}
        {{- if not (hasPrefix "/" $dsFile) -}}{{- $dsFile = joinPath $ctx.chezmoi.homeDir $dsFile -}}{{- end -}}
        {{- $_ := set $dsFetchArgs "file" $dsFile -}}
      {{- else if hasKey $ds "file" -}}
        {{- $dsFile := $ds.file -}}
        {{- if not (hasPrefix "/" $dsFile) -}}{{- $dsFile = joinPath $ctx.chezmoi.homeDir $dsFile -}}{{- end -}}
        {{- $_ := set $dsFetchArgs "file" $dsFile -}}
      {{- end -}}
      {{- $flt := dict -}}
      {{- if hasKey $ref "filter" -}}{{- $flt = $ref.filter -}}{{- else if hasKey $prov "filter" -}}{{- $flt = $prov.filter -}}{{- end -}}
      {{- if gt (len $flt) 0 -}}{{- $_ := set $resolved "model_filter" $flt -}}{{- end -}}
      {{- /* Canonical API mapping is relatively expensive, so request it only
             for filters that consume it rather than enriching every catalog model. */ -}}
      {{- if hasKey $flt "api" -}}{{- $_ := set $dsFetchArgs "map_api" true -}}{{- end -}}
      {{- $metadataModels := dict -}}
      {{- if hasKey $prov "provider" -}}
        {{- /* A provider-scoped catalog is authoritative; do not first flatten
               the entire data set only to discard it. */ -}}
        {{- $_ := set $dsFetchArgs "provider" $prov.provider -}}
        {{- $metadataModels = includeTemplate "llm/fetch-data-set" $dsFetchArgs | fromJson -}}
        {{- if and (not $resolved.base_url) (not (hasKey $ref "models")) (gt (len $metadataModels) 0) -}}
          {{- $sourceNames := dict -}}
          {{- range $id, $m := $metadataModels -}}
            {{- $name := $m.name -}}
            {{- if not $name -}}{{- $name = $id -}}{{- end -}}
            {{- $_ := set $sourceNames $id $name -}}
          {{- end -}}
          {{- $_ := set $resolved "models" $sourceNames -}}
        {{- end -}}
      {{- else -}}
        {{- $metadataModels = includeTemplate "llm/fetch-data-set" $dsFetchArgs | fromJson -}}
      {{- end -}}
      {{- if gt (len $metadataModels) 0 -}}
        {{- $_ := set $resolved "model_metadata" $metadataModels -}}
      {{- end -}}
    {{- end -}}
  {{- end }}

  {{- /* Explicit tool-level model declarations always win, including
         `models: false` for data-set-backed providers. */ -}}
  {{- if hasKey $ref "models" -}}
    {{- $_ := set $resolved "models" $ref.models -}}
  {{- end -}}

  {{- $_ := set $providers $alias $resolved -}}
  {{- end -}}
{{- end }}
{{- $_ := set $result "providers" $providers -}}

{{- /* Resolve model: string → use as-is, list → pick first with available provider */ -}}
{{- if hasKey $toolCfg "model" -}}
  {{- $model := $toolCfg.model -}}
  {{- if eq (kindOf $toolCfg.model) "slice" -}}
    {{- $model = includeTemplate "llm/pick-model" (dict "models" $toolCfg.model "providers" $providers) -}}
  {{- end -}}
  {{- $selection := includeTemplate "llm/split-model" (dict "model" $model "providers" $providers) | fromJson -}}
  {{- $_ := set $result "model" $model -}}
  {{- $_ := set $result "model_provider" $selection.provider -}}
  {{- $_ := set $result "model_id" $selection.model -}}
{{- end -}}

{{- if hasKey $toolCfg "small_model" -}}
  {{- $smallModel := $toolCfg.small_model -}}
  {{- if eq (kindOf $toolCfg.small_model) "slice" -}}
    {{- $smallModel = includeTemplate "llm/pick-model" (dict "models" $toolCfg.small_model "providers" $providers) -}}
  {{- end -}}
  {{- $selection := includeTemplate "llm/split-model" (dict "model" $smallModel "providers" $providers) | fromJson -}}
  {{- $_ := set $result "small_model" $smallModel -}}
  {{- $_ := set $result "small_model_provider" $selection.provider -}}
  {{- $_ := set $result "small_model_id" $selection.model -}}
{{- end -}}

{{- toJson $result -}}
