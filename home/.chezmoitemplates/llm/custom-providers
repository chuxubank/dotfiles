{{- /* llm/custom-providers — Alias map for Pi/OMP custom-provider files.
       Input: dict "tool" <tool-name> merged with root context.
       Output: JSON object of alias -> {baseUrl, apiKey, api, models, headers,
                                       disableStrictTools, compat, modelOverrides}.

       models: false → endpoint override only (no catalog rewrite).
       models as a bare id list → display name is the id.
       model_overrides → per-id metadata. When models are declared, merged into
       each row last. When models: false, one stem map is built: the
       models.dev card, then the `catalog` rates (llm.catalogs), then this
       provider's model_overrides. Each later layer wins.
       OMP then runs llm/expand-model-overrides, which copies `cost` onto
       sibling ids: `cursor-` prefixes, effort suffixes, and Claude
       `{stem}-thinking-{effort}` compounds.
       A dedicated `*-fast` key expands to `*-{effort}-fast` and wins.
       That fast lane also copies the stem's image input onto those
       siblings. A catalog stem's `omp_windows` land on
       `{stem}-{window}-fast` the same way. Missing Fast ids stay
       unpriced; the stem rate is not copied onto them. With `live_ids`, only
       ids the provider serves survive, plus the synthesized window ids.
       Pi with a catalog skips that expansion. It keeps cost only and
       rewrites each stem onto pi-cursor-sdk ids (`@window`, `:fast`,
       `:slow`). longContext becomes cost.tiers. Names, windows, and
       thinking ladders stay on the extension.

       Emit only when the alias contributes a model list, an override-only
       modelOverrides map, or an endpoint we can authenticate against. A bare
       baseUrl with no key would just restate the tool's own default. */ -}}
{{- $cfg := includeTemplate "llm/tool-config" . | fromJson -}}
{{- $tool := .tool -}}
{{- $passField := joinPath .chezmoi.homeDir "bin" "pass-field" -}}

{{- $providers := dict -}}
{{- range $alias, $ep := $cfg.providers -}}
  {{- $endpoint := includeTemplate "llm/model-endpoint" $ep | fromJson -}}
  {{- $api := $endpoint.api -}}
  {{- $baseURL := $endpoint.api_base_url -}}

  {{- $models := list -}}
  {{- $declaresModels := true -}}
  {{- $overrides := default dict (index $ep "model_overrides") -}}
  {{- if and (hasKey $ep "models") (eq (kindOf $ep.models) "bool") -}}
    {{- $declaresModels = false -}}
  {{- else -}}
    {{- $source := dict -}}
    {{- if hasKey $ep "models" -}}
      {{- if eq (kindOf $ep.models) "slice" -}}
        {{- /* Bare id list: the display name is the id, matching what the
               endpoint's own /v1/models returns for these entries. */ -}}
        {{- range $id := $ep.models -}}{{- $_ := set $source $id $id -}}{{- end -}}
      {{- else -}}
        {{- $source = $ep.models -}}
      {{- end -}}
    {{- else -}}
      {{- $source = includeTemplate "llm/fetch-models" $ep | fromJson -}}
    {{- end -}}
    {{- $metadata := default dict (index $ep "model_metadata") -}}
    {{- $filter := default dict (index $ep "model_filter") -}}
    {{- if and (gt (len $filter) 0) (gt (len $metadata) 0) -}}
      {{- $allowed := includeTemplate "llm/filter-models" (dict "models" $metadata "filter" $filter) | fromJson -}}
      {{- $kept := dict -}}
      {{- range $id, $name := $source -}}
        {{- if hasKey $allowed $id -}}{{- $_ := set $kept $id $name -}}{{- end -}}
      {{- end -}}
      {{- $source = $kept -}}
    {{- end -}}
    {{- range $id, $name := $source -}}
      {{- $model := dict "id" $id "api" $api -}}
      {{- /* Only a real display name is authoritative. Endpoints that echo the
             id (every IV group) leave the slot open for the data set's name,
             and model-config/pi falls back to the id if neither has one. */ -}}
      {{- if ne $name $id -}}{{- $_ := set $model "name" $name -}}{{- end -}}
      {{- if hasKey $metadata $id -}}
        {{- $model = mergeOverwrite (deepCopy (index $metadata $id)) $model -}}
      {{- end -}}
      {{- if hasKey $overrides $id -}}
        {{- $model = mergeOverwrite $model (deepCopy (index $overrides $id)) -}}
      {{- end -}}
      {{- /* Inline Pi's single-consumer ProviderModelConfig projection.
             Pi takes long-context pricing as cost.tiers; OMP rows stay flat. */ -}}
      {{- $costOv := dict -}}
      {{- if hasKey $model "cost" -}}
        {{- $costOv = includeTemplate "llm/cost-override" $model.cost | fromJson -}}
      {{- end -}}
      {{- if ne $tool "pi" -}}{{- $costOv = omit $costOv "longContext" -}}{{- end -}}
      {{- $cost := includeTemplate "llm/pi-cost" $costOv | fromJson -}}
      {{- $input := list -}}
      {{- if hasKey $model "modalities" -}}
        {{- range $modality := default (list) (index $model.modalities "input") -}}
          {{- if or (eq $modality "text") (eq $modality "image") -}}{{- $input = append $input $modality -}}{{- end -}}
        {{- end -}}
      {{- end -}}
      {{- if not $input -}}{{- $input = list "text" -}}{{- end -}}
      {{- $contextWindow := 128000 -}}
      {{- $maxTokens := 8192 -}}
      {{- if hasKey $model "limit" -}}
        {{- $limits := $model.limit -}}
        {{- $contextWindow = int (default $contextWindow (index $limits "context")) -}}
        {{- $maxTokens = int (default $maxTokens (index $limits "output")) -}}
      {{- end -}}
      {{- $models = append $models (dict
        "id" $model.id
        "name" (default $model.id (index $model "name"))
        "api" $model.api
        "reasoning" (eq true (index $model "reasoning"))
        "input" $input
        "cost" $cost
        "contextWindow" $contextWindow
        "maxTokens" $maxTokens
      ) -}}
    {{- end -}}
  {{- end -}}

  {{- if not $declaresModels -}}
    {{- $piCatalog := and (eq $tool "pi") (hasKey $ep "catalog_models") -}}
    {{- $explicit := $overrides -}}
    {{- if hasKey $ep "rates" -}}
      {{- $explicit = mergeOverwrite (deepCopy $ep.rates) $explicit -}}
    {{- end -}}
    {{- $stem := $explicit -}}
    {{- if or (eq $tool "omp") $piCatalog -}}
      {{- $fromMeta := dict -}}
      {{- range $id, $m := default dict (index $ep "model_metadata") -}}
        {{- $full := includeTemplate "model-config/omp" $m | fromJson -}}
        {{- if gt (len $full) 0 -}}{{- $_ := set $fromMeta $id $full -}}{{- end -}}
      {{- end -}}
      {{- $stem = mergeOverwrite $fromMeta $explicit -}}
    {{- end -}}
    {{- if $piCatalog -}}
      {{- $overrides = includeTemplate "llm/pi-cursor-costs" (dict "overrides" $stem "models" $ep.catalog_models) | fromJson -}}
    {{- else if eq $tool "omp" -}}
      {{- $overrides = includeTemplate "llm/expand-model-overrides" (dict
            "overrides" $stem
            "prefixes" (default (list) (index $ep "model_override_prefixes"))
            "contexts" (default dict (index $ep "context_windows"))) | fromJson -}}
      {{- if hasKey $ep "live_ids" -}}
        {{- $keep := dict -}}
        {{- range $id := $ep.live_ids -}}{{- $_ := set $keep $id true -}}{{- end -}}
        {{- range $stemId, $windows := default dict (index $ep "context_windows") -}}
          {{- range $window := $windows -}}
            {{- $_ := set $keep (printf "%s-%s-fast" $stemId $window) true -}}
          {{- end -}}
        {{- end -}}
        {{- $live := dict -}}
        {{- range $id, $ov := $overrides -}}
          {{- if hasKey $keep $id -}}{{- $_ := set $live $id $ov -}}{{- end -}}
        {{- end -}}
        {{- $overrides = $live -}}
      {{- end -}}
    {{- else -}}
      {{- $overrides = $explicit -}}
    {{- end -}}
  {{- end -}}

  {{- $hasOverrides := and (not $declaresModels) (gt (len $overrides) 0) -}}
  {{- if or (gt (len $models) 0) (and $baseURL $ep.auth_path) $hasOverrides -}}
    {{- $p := dict -}}
    {{- if $baseURL -}}{{- $_ := set $p "baseUrl" $baseURL -}}{{- end -}}
    {{- if hasKey $ep "headers" -}}{{- $_ := set $p "headers" $ep.headers -}}{{- end -}}
    {{- if hasKey $ep "disable_strict_tools" -}}{{- $_ := set $p "disableStrictTools" $ep.disable_strict_tools -}}{{- end -}}
    {{- if hasKey $ep "compat" -}}{{- $_ := set $p "compat" $ep.compat -}}{{- end -}}
    {{- if $ep.auth_path -}}
      {{- $args := $ep.auth_path -}}
      {{- if $ep.auth_field -}}
        {{- $args = printf "%s %s" $ep.auth_path $ep.auth_field -}}
      {{- end -}}
      {{- $_ := set $p "apiKey" (printf "!%s %s" $passField $args) -}}
    {{- else if $declaresModels -}}
      {{- $_ := set $p "apiKey" "unused" -}}
    {{- end -}}
    {{- if $declaresModels -}}
      {{- $_ := set $p "api" $api -}}
      {{- $_ := set $p "models" $models -}}
    {{- end -}}
    {{- if $hasOverrides -}}
      {{- $_ := set $p "modelOverrides" $overrides -}}
    {{- end -}}
    {{- $_ := set $providers $alias $p -}}
  {{- end -}}
{{- end -}}
{{- toJson $providers -}}
