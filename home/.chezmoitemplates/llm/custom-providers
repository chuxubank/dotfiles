{{- /* llm/custom-providers — Alias map for Pi/OMP custom-provider files.
       Input: dict "tool" <tool-name> merged with root context.
       Output: JSON object of alias -> {baseUrl, apiKey, api, models, headers,
                                       disableStrictTools, compat}.

       models: false → endpoint override only (no catalog rewrite).
       models as a bare id list → display name is the id.
       model_overrides → per-id metadata fields applied last, for endpoints
       whose real capabilities differ from the catalog's.

       Emit only when the alias contributes a model list, or an endpoint we
       can authenticate against. A bare baseUrl with no key would just restate
       the tool's own default. */ -}}
{{- $cfg := includeTemplate "llm/tool-config" . | fromJson -}}
{{- $passField := joinPath .chezmoi.homeDir "bin" "pass-field" -}}

{{- $providers := dict -}}
{{- range $alias, $ep := $cfg.providers -}}
  {{- $endpoint := includeTemplate "llm/model-endpoint" $ep | fromJson -}}
  {{- $api := $endpoint.api -}}
  {{- $baseURL := $endpoint.api_base_url -}}

  {{- $models := list -}}
  {{- $declaresModels := true -}}
  {{- if and (hasKey $ep "models") (eq (kindOf $ep.models) "bool") -}}
    {{- $declaresModels = false -}}
  {{- else -}}
    {{- $source := dict -}}
    {{- if hasKey $ep "models" -}}
      {{- if eq (kindOf $ep.models) "slice" -}}
        {{- /* Bare id list: the display name is the id, matching what the
               endpoint's own /v1/models returns for these entries. */ -}}
        {{- range $id := $ep.models -}}{{- $_ := set $source $id $id -}}{{- end -}}
      {{- else -}}
        {{- $source = $ep.models -}}
      {{- end -}}
    {{- else -}}
      {{- $source = includeTemplate "llm/fetch-models" $ep | fromJson -}}
    {{- end -}}
    {{- $metadata := default dict (index $ep "model_metadata") -}}
    {{- $filter := default dict (index $ep "model_filter") -}}
    {{- if and (gt (len $filter) 0) (gt (len $metadata) 0) -}}
      {{- $allowed := includeTemplate "llm/filter-models" (dict "models" $metadata "filter" $filter) | fromJson -}}
      {{- $kept := dict -}}
      {{- range $id, $name := $source -}}
        {{- if hasKey $allowed $id -}}{{- $_ := set $kept $id $name -}}{{- end -}}
      {{- end -}}
      {{- $source = $kept -}}
    {{- end -}}
    {{- $overrides := default dict (index $ep "model_overrides") -}}
    {{- range $id, $name := $source -}}
      {{- $model := dict "id" $id "api" $api -}}
      {{- /* Only a real display name is authoritative. Endpoints that echo the
             id (every IV group) leave the slot open for the data set's name,
             and model-config/pi falls back to the id if neither has one. */ -}}
      {{- if ne $name $id -}}{{- $_ := set $model "name" $name -}}{{- end -}}
      {{- if hasKey $metadata $id -}}
        {{- $model = mergeOverwrite (deepCopy (index $metadata $id)) $model -}}
      {{- end -}}
      {{- if hasKey $overrides $id -}}
        {{- $model = mergeOverwrite $model (deepCopy (index $overrides $id)) -}}
      {{- end -}}
      {{- $models = append $models (includeTemplate "model-config/pi" $model | fromJson) -}}
    {{- end -}}
  {{- end -}}

  {{- if or (gt (len $models) 0) (and $baseURL $ep.auth_path) -}}
    {{- $p := dict -}}
    {{- if $baseURL -}}{{- $_ := set $p "baseUrl" $baseURL -}}{{- end -}}
    {{- if hasKey $ep "headers" -}}{{- $_ := set $p "headers" $ep.headers -}}{{- end -}}
    {{- if hasKey $ep "disable_strict_tools" -}}{{- $_ := set $p "disableStrictTools" $ep.disable_strict_tools -}}{{- end -}}
    {{- if hasKey $ep "compat" -}}{{- $_ := set $p "compat" $ep.compat -}}{{- end -}}
    {{- if $ep.auth_path -}}
      {{- $args := $ep.auth_path -}}
      {{- if $ep.auth_field -}}
        {{- $args = printf "%s %s" $ep.auth_path $ep.auth_field -}}
      {{- end -}}
      {{- $_ := set $p "apiKey" (printf "!%s %s" $passField $args) -}}
    {{- else if $declaresModels -}}
      {{- $_ := set $p "apiKey" "unused" -}}
    {{- end -}}
    {{- if $declaresModels -}}
      {{- $_ := set $p "api" $api -}}
      {{- $_ := set $p "models" $models -}}
    {{- end -}}
    {{- $_ := set $providers $alias $p -}}
  {{- end -}}
{{- end -}}
{{- toJson $providers -}}
