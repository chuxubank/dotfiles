{{- /* llm/custom-providers — Alias map for Pi/OMP custom-provider files.
       Input: dict "tool" <tool-name> merged with root context.
       Output: JSON object of alias -> {baseUrl, apiKey, api, models, headers,
                                       disableStrictTools, compat, modelOverrides}.

       models: false → endpoint override only (no catalog rewrite).
       models as a bare id list → display name is the id.
       model_overrides → per-id metadata. When models are declared, merged into
       each row last. When models: false, emitted as OMP provider-level
       modelOverrides, with billed costs copied from model_metadata (models-dev)
       first and explicit overrides winning. model_override_prefixes duplicate
       those keys (`cursor-` for GetUsableModels grok ids). A stem copies onto
       thinking-effort siblings (the rate does not split). -fast is a second
       lane: a dedicated `*-fast` key expands to `*-{effort}-fast` and wins;
       otherwise the stem rate fills the missing fast ids.

       Emit only when the alias contributes a model list, an override-only
       modelOverrides map, or an endpoint we can authenticate against. A bare
       baseUrl with no key would just restate the tool's own default. */ -}}
{{- $cfg := includeTemplate "llm/tool-config" . | fromJson -}}
{{- $passField := joinPath .chezmoi.homeDir "bin" "pass-field" -}}

{{- $providers := dict -}}
{{- range $alias, $ep := $cfg.providers -}}
  {{- $endpoint := includeTemplate "llm/model-endpoint" $ep | fromJson -}}
  {{- $api := $endpoint.api -}}
  {{- $baseURL := $endpoint.api_base_url -}}

  {{- $models := list -}}
  {{- $declaresModels := true -}}
  {{- $overrides := default dict (index $ep "model_overrides") -}}
  {{- if and (hasKey $ep "models") (eq (kindOf $ep.models) "bool") -}}
    {{- $declaresModels = false -}}
  {{- else -}}
    {{- $source := dict -}}
    {{- if hasKey $ep "models" -}}
      {{- if eq (kindOf $ep.models) "slice" -}}
        {{- /* Bare id list: the display name is the id, matching what the
               endpoint's own /v1/models returns for these entries. */ -}}
        {{- range $id := $ep.models -}}{{- $_ := set $source $id $id -}}{{- end -}}
      {{- else -}}
        {{- $source = $ep.models -}}
      {{- end -}}
    {{- else -}}
      {{- $source = includeTemplate "llm/fetch-models" $ep | fromJson -}}
    {{- end -}}
    {{- $metadata := default dict (index $ep "model_metadata") -}}
    {{- $filter := default dict (index $ep "model_filter") -}}
    {{- if and (gt (len $filter) 0) (gt (len $metadata) 0) -}}
      {{- $allowed := includeTemplate "llm/filter-models" (dict "models" $metadata "filter" $filter) | fromJson -}}
      {{- $kept := dict -}}
      {{- range $id, $name := $source -}}
        {{- if hasKey $allowed $id -}}{{- $_ := set $kept $id $name -}}{{- end -}}
      {{- end -}}
      {{- $source = $kept -}}
    {{- end -}}
    {{- range $id, $name := $source -}}
      {{- $model := dict "id" $id "api" $api -}}
      {{- /* Only a real display name is authoritative. Endpoints that echo the
             id (every IV group) leave the slot open for the data set's name,
             and model-config/pi falls back to the id if neither has one. */ -}}
      {{- if ne $name $id -}}{{- $_ := set $model "name" $name -}}{{- end -}}
      {{- if hasKey $metadata $id -}}
        {{- $model = mergeOverwrite (deepCopy (index $metadata $id)) $model -}}
      {{- end -}}
      {{- if hasKey $overrides $id -}}
        {{- $model = mergeOverwrite $model (deepCopy (index $overrides $id)) -}}
      {{- end -}}
      {{- $models = append $models (includeTemplate "model-config/pi" $model | fromJson) -}}
    {{- end -}}
  {{- end -}}

  {{- if not $declaresModels -}}
    {{- $metadata := default dict (index $ep "model_metadata") -}}
    {{- $fromMeta := dict -}}
    {{- range $id, $m := $metadata -}}
      {{- if hasKey $m "cost" -}}
        {{- $costOv := includeTemplate "llm/cost-override" (index $m "cost") | fromJson -}}
        {{- if gt (len $costOv) 0 -}}
          {{- $_ := set $fromMeta $id (dict "cost" $costOv) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
    {{- $overrides = mergeOverwrite $fromMeta $overrides -}}
    {{- $prefixes := default (list) (index $ep "model_override_prefixes") -}}
    {{- if gt (len $prefixes) 0 -}}
      {{- $withPfx := dict -}}
      {{- range $id, $ov := $overrides -}}
        {{- $_ := set $withPfx $id $ov -}}
        {{- range $pfx := $prefixes -}}
          {{- if not (hasPrefix $pfx $id) -}}
            {{- $pid := printf "%s%s" $pfx $id -}}
            {{- if not (hasKey $overrides $pid) -}}
              {{- $_ := set $withPfx $pid $ov -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
      {{- $overrides = $withPfx -}}
    {{- end -}}
  {{- end -}}

  {{- $hasOverrides := and (not $declaresModels) (gt (len $overrides) 0) -}}
  {{- if or (gt (len $models) 0) (and $baseURL $ep.auth_path) $hasOverrides -}}
    {{- $p := dict -}}
    {{- if $baseURL -}}{{- $_ := set $p "baseUrl" $baseURL -}}{{- end -}}
    {{- if hasKey $ep "headers" -}}{{- $_ := set $p "headers" $ep.headers -}}{{- end -}}
    {{- if hasKey $ep "disable_strict_tools" -}}{{- $_ := set $p "disableStrictTools" $ep.disable_strict_tools -}}{{- end -}}
    {{- if hasKey $ep "compat" -}}{{- $_ := set $p "compat" $ep.compat -}}{{- end -}}
    {{- if $ep.auth_path -}}
      {{- $args := $ep.auth_path -}}
      {{- if $ep.auth_field -}}
        {{- $args = printf "%s %s" $ep.auth_path $ep.auth_field -}}
      {{- end -}}
      {{- $_ := set $p "apiKey" (printf "!%s %s" $passField $args) -}}
    {{- else if $declaresModels -}}
      {{- $_ := set $p "apiKey" "unused" -}}
    {{- end -}}
    {{- if $declaresModels -}}
      {{- $_ := set $p "api" $api -}}
      {{- $_ := set $p "models" $models -}}
    {{- end -}}
    {{- if $hasOverrides -}}
      {{- /* Stem keys cover thinking-effort siblings in the same rate lane.
             A dedicated *-fast key expands to *-{effort}-fast; otherwise the
             stem rate fills missing fast ids. An explicit sibling still wins. */ -}}
      {{- $effortSuffixes := list "none" "minimal" "low" "medium" "high" "xhigh" "max" "thinking" -}}
      {{- $expanded := dict -}}
      {{- range $modelId, $ov := $overrides -}}
        {{- $_ := set $expanded $modelId $ov -}}
      {{- end -}}
      {{- range $modelId, $ov := $overrides -}}
        {{- $lane := $modelId -}}
        {{- $fast := false -}}
        {{- if hasSuffix "-fast" $modelId -}}
          {{- $fast = true -}}
          {{- $lane = trimSuffix "-fast" $modelId -}}
        {{- end -}}
        {{- $isEffort := false -}}
        {{- range $suf := $effortSuffixes -}}
          {{- if hasSuffix (printf "-%s" $suf) $lane -}}{{- $isEffort = true -}}{{- end -}}
        {{- end -}}
        {{- if not $isEffort -}}
          {{- range $suf := $effortSuffixes -}}
            {{- $sibling := printf "%s-%s" $modelId $suf -}}
            {{- if $fast -}}{{- $sibling = printf "%s-%s-fast" $lane $suf -}}{{- end -}}
            {{- if not (hasKey $expanded $sibling) -}}
              {{- $_ := set $expanded $sibling $ov -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
      {{- range $modelId, $ov := $overrides -}}
        {{- if not (hasSuffix "-fast" $modelId) -}}
          {{- $isEffort := false -}}
          {{- range $suf := $effortSuffixes -}}
            {{- if hasSuffix (printf "-%s" $suf) $modelId -}}{{- $isEffort = true -}}{{- end -}}
          {{- end -}}
          {{- if not $isEffort -}}
            {{- $fastStem := printf "%s-fast" $modelId -}}
            {{- if not (hasKey $overrides $fastStem) -}}
              {{- if not (hasKey $expanded $fastStem) -}}
                {{- $_ := set $expanded $fastStem $ov -}}
              {{- end -}}
              {{- range $suf := $effortSuffixes -}}
                {{- $sibling := printf "%s-%s-fast" $modelId $suf -}}
                {{- if not (hasKey $expanded $sibling) -}}
                  {{- $_ := set $expanded $sibling $ov -}}
                {{- end -}}
              {{- end -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
      {{- $_ := set $p "modelOverrides" $expanded -}}
    {{- end -}}
    {{- $_ := set $providers $alias $p -}}
  {{- end -}}
{{- end -}}
{{- toJson $providers -}}
