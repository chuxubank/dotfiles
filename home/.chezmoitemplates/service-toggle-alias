alias {{ .tool }}-{{ .target }}-off='launchctl bootout gui/{{ .uid }}/{{ .tool }}.{{ .target }}'
alias {{ .tool }}-{{ .target }}-on='launchctl bootstrap gui/{{ .uid }} ~/Library/LaunchAgents/{{ .tool }}.{{ .target }}.plist'
alias {{ .tool }}-{{ .target }}-restart='{{ .tool }}-{{ .target }}-off && sleep {{ if (index . "wait") }} {{ .wait }} {{ else -}} 3 {{ end -}} && {{ .tool }}-{{ .target }}-on'