{{- /* path/platform — Host-specific [data.path] keys as a TOML fragment.
       Input: dict "os" "arch" "homeDir" */ -}}
{{- $os := .os -}}
{{- $arch := .arch -}}
{{- $homeDir := .homeDir -}}
{{- if eq $os "darwin" }}
# darwin
{{- if eq $arch "arm64" }}
    usr = "/opt/homebrew"
	etc = "/opt/homebrew/etc"
    gh = "/opt/homebrew/bin/gh"
{{- else }}
    usr = "/usr/local"
	etc = "/usr/local/etc"
    gh = "/usr/local/bin/gh"
{{- end }}
    log = {{- joinPath $homeDir "Library" "Logs" | quote }}
	zotero = {{- joinPath "Library" "Application Support" "Zotero" | quote}}
{{- else if eq $os "linux" }}
# linux
    usr = "/usr"
	etc = "/etc"
    gh = "/usr/bin/gh"
    log = "/var/log"
	zotero = {{- joinPath ".zotero" "zotero" | quote }}
{{- else if eq $os "windows" }}
# windows
    usr = "C:/Program Files"
	etc = "C:/ProgramData"
    gh = "'C:\\\\Program Files\\\\GitHub CLI\\\\gh.exe'"
    log = {{- joinPath "AppData" "Local" "Temp" | quote }}
	zotero = {{- joinPath "AppData" "Roaming" "Zotero" "Zotero" | quote }}
{{- else if eq $os "android" }}
# android
    usr = "/data/data/com.termux/files/usr"
    gh = "/data/data/com.termux/files/usr/bin/gh"
    log = "/data/data/com.termux/files/var/log"
{{- else }}
# unknown
{{- end }}
