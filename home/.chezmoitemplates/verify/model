{{- /* verify/model — Checks against the real chezmoidata.
       Requires .tools / .packages / .skills / .services / .environment / .defaults. */ -}}

{{- $declared := default dict .tools -}}
{{- if eq (len $declared) 0 -}}
  {{- fail "verify/model: tools.yaml is empty" -}}
{{- end -}}

{{- /* Explicit enable/disable table for every declared tool.
       Host shapes: personal/darwin 512G, iv/darwin 512G, ci/linux 20G, aa/windows 256G. */ -}}
{{- $hostShapes := dict
      "personal" (dict "host_env" "personal" "os" "darwin" "disk_gb" 512 "os_version" "26.0")
      "iv" (dict "host_env" "iv" "os" "darwin" "disk_gb" 512 "os_version" "26.0")
      "ci" (dict "host_env" "ci" "os" "linux" "disk_gb" 20 "os_version" "")
      "aa" (dict "host_env" "aa" "os" "windows" "disk_gb" 256 "os_version" "")
-}}
{{- $expect := dict
      "claude-code" (dict "personal" false "iv" true "ci" false "aa" false)
      "codex" (dict "personal" true "iv" true "ci" false "aa" true)
      "cursor" (dict "personal" true "iv" true "ci" false "aa" true)
      "gemini-cli" (dict "personal" true "iv" true "ci" false "aa" true)
      "goose" (dict "personal" true "iv" true "ci" false "aa" true)
      "grok" (dict "personal" true "iv" true "ci" true "aa" true)
      "herdr" (dict "personal" true "iv" true "ci" true "aa" true)
      "opencode" (dict "personal" true "iv" true "ci" false "aa" true)
      "pi" (dict "personal" true "iv" true "ci" false "aa" true)
      "rclone" (dict "personal" true "iv" true "ci" false "aa" true)
      "rtk" (dict "personal" true "iv" true "ci" true "aa" false)
      "sentry" (dict "personal" false "iv" true "ci" false "aa" false)
      "termio" (dict "personal" true "iv" true "ci" false "aa" false)
      "warp" (dict "personal" true "iv" true "ci" false "aa" true)
      "talkify" (dict "personal" true "iv" false "ci" false "aa" false)
-}}
{{- range $name, $spec := $declared -}}
  {{- if not (hasKey $expect $name) -}}
    {{- fail (printf "matrix: add expected enablement for tool %q" $name) -}}
  {{- end -}}
  {{- range $shapeName, $want := index $expect $name -}}
    {{- $shape := index $hostShapes $shapeName -}}
    {{- $got := includeTemplate "tool/enabled" (dict
          "tool" $name
          "tools" $declared
          "host_env" $shape.host_env
          "device_type" "laptop"
          "roles" (list "llm")
          "mem_gb" 16
          "disk_gb" $shape.disk_gb
          "os_version" $shape.os_version
          "chezmoi" (dict "os" $shape.os)) | fromJson -}}
    {{- if ne $got $want -}}
      {{- fail (printf "matrix: %s on %s: got %v want %v" $name $shapeName $got $want) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Ignore lines must not be a whole well-known root. */ -}}
{{- $broad := list ".config" "Library" ".local" "AppData" -}}
{{- $ignoreHosts := list
      (dict "name" "ci" "host_env" "ci" "os" "linux" "disk_gb" 20)
      (dict "name" "windows" "host_env" "aa" "os" "windows" "disk_gb" 256)
-}}
{{- range $ih := $ignoreHosts -}}
  {{- $ignore := printf "\n%s\n" (includeTemplate "tool/disabled-ignore" (dict
        "tools" $declared
        "host_env" $ih.host_env
        "device_type" "laptop"
        "roles" (list "llm")
        "mem_gb" 16
        "disk_gb" $ih.disk_gb
        "os_version" ""
        "chezmoi" (dict "os" $ih.os))) -}}
  {{- range $root := $broad -}}
    {{- if contains (printf "\n%s\n" $root) $ignore -}}
      {{- fail (printf "disabled-ignore on %s: overly broad %q" $ih.name $root) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* rtk integrations target declared agents and list init args.
       Agent-owned files cannot live in remove/purge (parent ignore). */ -}}
{{- $rtkSpec := index $declared "rtk" -}}
{{- $rtkInts := dig "integrations" (list) $rtkSpec -}}
{{- if eq (len $rtkInts) 0 -}}
  {{- fail "rtk: integrations must be declared" -}}
{{- end -}}
{{- range $int := $rtkInts -}}
  {{- if ne (kindOf $int) "map" -}}
    {{- fail "rtk: each integration must be a map" -}}
  {{- end -}}
  {{- $agent := dig "tool" "" $int -}}
  {{- if not $agent -}}
    {{- fail "rtk: integration missing tool" -}}
  {{- end -}}
  {{- if not (hasKey $declared $agent) -}}
    {{- fail (printf "rtk integration: unknown tool %q" $agent) -}}
  {{- end -}}
  {{- $args := dig "args" (list) $int -}}
  {{- if or (ne (kindOf $args) "slice") (eq (len $args) 0) -}}
    {{- fail (printf "rtk integration %s: args must be a non-empty list" $agent) -}}
  {{- end -}}
{{- end -}}
{{- $rtkPurge := dig "purge" (list) $rtkSpec -}}
{{- range $need := list
      ".config/rtk/**"
      ".local/share/rtk/**"
      "Library/Application Support/rtk/**"
      "Library/Caches/rtk/**"
      "AppData/Local/rtk/**" -}}
  {{- if not (has $need $rtkPurge) -}}
    {{- fail (printf "rtk purge missing %q" $need) -}}
  {{- end -}}
{{- end -}}

{{- /* Path width for remove and purge. */ -}}
{{- range $name, $spec := $declared -}}
  {{- $patterns := dig "remove" (list) $spec -}}
  {{- range $p := dig "purge" (list) $spec -}}
    {{- $patterns = append $patterns $p -}}
  {{- end -}}
  {{- range $pattern := $patterns -}}
    {{- if not $pattern -}}
      {{- fail (printf "tool %s: empty remove/purge path" $name) -}}
    {{- end -}}
    {{- if or (hasPrefix "/" $pattern) (hasPrefix "~" $pattern) -}}
      {{- fail (printf "tool %s: absolute remove/purge path %q" $name $pattern) -}}
    {{- end -}}
    {{- if or (eq $pattern "*") (eq $pattern "**") (eq $pattern "/**") -}}
      {{- fail (printf "tool %s: overly broad remove/purge path %q" $name $pattern) -}}
    {{- end -}}
    {{- if or (hasPrefix "../" $pattern) (contains "/../" $pattern) (eq $pattern "..") -}}
      {{- fail (printf "tool %s: parent traversal in %q" $name $pattern) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Every owner reference is declared. Package maps must use owner, not tool. */ -}}
{{- $pkgPaths := list
      (list "darwin" "taps")
      (list "darwin" "brews")
      (list "darwin" "casks")
      (list "darwin" "mas")
      (list "python" "tools")
      (list "node" "global")
      (list "apt" "pkg")
      (list "pacman" "core")
      (list "pacman" "extra")
      (list "pacman" "aur")
      (list "termux" "pkg")
      (list "sdkman")
      (list "rust" "cargo")
      (list "go")
-}}
{{- range $path := $pkgPaths -}}
  {{- $list := $.packages -}}
  {{- $ok := true -}}
  {{- range $key := $path -}}
    {{- if and $ok (hasKey $list $key) -}}
      {{- $list = index $list $key -}}
    {{- else -}}
      {{- $ok = false -}}
    {{- end -}}
  {{- end -}}
  {{- if and $ok (eq (kindOf $list) "slice") -}}
    {{- range $package := $list -}}
      {{- if eq (kindOf $package) "map" -}}
        {{- if hasKey $package "tool" -}}
          {{- fail (printf "package %s: use owner, not tool" (dig "name" "?" $package)) -}}
        {{- end -}}
        {{- $owner := dig "owner" "" $package -}}
        {{- if and $owner (not (hasKey $declared $owner)) -}}
          {{- fail (printf "package %s: unknown owner %q" (dig "name" "?" $package) $owner) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range $groupName := keys (default dict .skills.provider_groups) | sortAlpha -}}
  {{- range $provider := index $.skills.provider_groups $groupName -}}
    {{- if hasKey $provider "tool" -}}
      {{- fail (printf "skill provider in %s: use owner, not tool" $groupName) -}}
    {{- end -}}
    {{- $owner := dig "owner" "" $provider -}}
    {{- if and $owner (not (hasKey $declared $owner)) -}}
      {{- fail (printf "skill provider %s: unknown owner %q" (dig "name" "?" $provider) $owner) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range $service := .services -}}
  {{- $owner := dig "owner" "" $service -}}
  {{- if and $owner (not (hasKey $declared $owner)) -}}
    {{- fail (printf "service %s: unknown owner %q" (dig "tool" "?" $service) $owner) -}}
  {{- end -}}
{{- end -}}

{{- range $entry := .environment.static -}}
  {{- $owner := dig "owner" "" $entry -}}
  {{- if and $owner (not (hasKey $declared $owner)) -}}
    {{- fail (printf "environment %s: unknown owner %q" (dig "tool" "?" $entry) $owner) -}}
  {{- end -}}
{{- end -}}

{{- range $name := keys (default dict .defaults) -}}
  {{- $item := index $.defaults $name -}}
  {{- if hasKey $item "tool" -}}
    {{- fail (printf "defaults %s: use owner, not tool" $name) -}}
  {{- end -}}
  {{- $owner := dig "owner" "" $item -}}
  {{- if and $owner (not (hasKey $declared $owner)) -}}
    {{- fail (printf "defaults %s: unknown owner %q" $name $owner) -}}
  {{- end -}}
{{- end -}}

ok
