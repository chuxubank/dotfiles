{{- /* verify/model — Checks against the real chezmoidata.
       Requires .tools / .packages / .skills / .services / .environment / .defaults. */ -}}

{{- $declared := default dict .tools -}}

{{- /* Ignore lines must not be a whole well-known root. */ -}}
{{- $broad := list ".config" "Library" ".local" "AppData" "bin" -}}
{{- $ignoreHosts := list
      (dict "name" "ci" "host_env" "ci" "os" "linux" "disk_gb" 20)
      (dict "name" "windows" "host_env" "aa" "os" "windows" "disk_gb" 256)
-}}
{{- range $ih := $ignoreHosts -}}
  {{- $ignore := printf "\n%s\n" (includeTemplate "tool/disabled-ignore" (dict
        "tools" $declared
        "host_env" $ih.host_env
        "device_type" "laptop"
        "roles" (list "llm")
        "mem_gb" 16
        "disk_gb" $ih.disk_gb
        "os_version" ""
        "chezmoi" (dict "os" $ih.os))) -}}
  {{- range $root := $broad -}}
    {{- if contains (printf "\n%s\n" $root) $ignore -}}
      {{- fail (printf "disabled-ignore on %s: overly broad %q" $ih.name $root) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* Schema validates tool declaration shape. Keep only the cross-entry
       constraint that string purges must not overlap command-owned targets. */ -}}
{{- range $name, $spec := $declared -}}
  {{- range $entry := dig "purge" (list) $spec -}}
    {{- if eq (kindOf $entry) "map" -}}
      {{- range $path := $entry.paths -}}
        {{- $target := trimSuffix "/**" $path -}}
        {{- range $other := dig "purge" (list) $spec -}}
          {{- if eq (kindOf $other) "string" -}}
            {{- $root := trimSuffix "/**" $other -}}
            {{- if or (eq $root $target) (hasPrefix (printf "%s/" $root) $target) (hasPrefix (printf "%s/" $target) $root) -}}
              {{- fail (printf "tool %s: string purge %q overlaps command target %q" $name $other $path) -}}
            {{- end -}}
          {{- end -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range $provider := dig "providers" (list) (default dict .mcp) -}}
  {{- $owner := dig "owner" "" $provider -}}
  {{- if and $owner (not (hasKey $declared $owner)) -}}
    {{- fail (printf "mcp %s: unknown owner %q" (dig "name" "?" $provider) $owner) -}}
  {{- end -}}
{{- end -}}

{{- /* Cross-file owner references must name declared tools. */ -}}
{{- $pkgPaths := list
      (list "darwin" "taps")
      (list "darwin" "brews")
      (list "darwin" "casks")
      (list "darwin" "mas")
      (list "python" "tools")
      (list "node" "global")
      (list "apt" "pkg")
      (list "pacman" "core")
      (list "pacman" "extra")
      (list "pacman" "aur")
      (list "msys2" "msys")
      (list "msys2" "ucrt64")
      (list "termux" "pkg")
      (list "sdkman")
      (list "rust" "cargo")
      (list "go")
-}}
{{- range $path := $pkgPaths -}}
  {{- $list := $.packages -}}
  {{- $ok := true -}}
  {{- range $key := $path -}}
    {{- if and $ok (hasKey $list $key) -}}
      {{- $list = index $list $key -}}
    {{- else -}}
      {{- $ok = false -}}
    {{- end -}}
  {{- end -}}
  {{- if and $ok (eq (kindOf $list) "slice") -}}
    {{- range $package := $list -}}
      {{- if eq (kindOf $package) "map" -}}
        {{- $owner := dig "owner" "" $package -}}
        {{- if and $owner (not (hasKey $declared $owner)) -}}
          {{- fail (printf "package %s: unknown owner %q" (dig "name" "?" $package) $owner) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range $groupName := keys (default dict .skills.provider_groups) | sortAlpha -}}
  {{- range $provider := index $.skills.provider_groups $groupName -}}
    {{- $owner := dig "owner" "" $provider -}}
    {{- if and $owner (not (hasKey $declared $owner)) -}}
      {{- fail (printf "skill provider %s: unknown owner %q" (dig "name" "?" $provider) $owner) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range $agentEntry := default (list) .skills.agents -}}
  {{- if eq (kindOf $agentEntry) "map" -}}
    {{- $owner := dig "owner" "" $agentEntry -}}
    {{- if and $owner (not (hasKey $declared $owner)) -}}
      {{- fail (printf "skills agent %s: unknown owner %q" (dig "name" "?" $agentEntry) $owner) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- range $service := .services -}}
  {{- $owner := dig "owner" "" $service -}}
  {{- if and $owner (not (hasKey $declared $owner)) -}}
    {{- fail (printf "service %s: unknown owner %q" (dig "tool" "?" $service) $owner) -}}
  {{- end -}}
{{- end -}}

{{- range $entry := .environment.static -}}
  {{- $owner := dig "owner" "" $entry -}}
  {{- if and $owner (not (hasKey $declared $owner)) -}}
    {{- fail (printf "environment %s: unknown owner %q" (dig "tool" "?" $entry) $owner) -}}
  {{- end -}}
{{- end -}}

{{- range $name := keys (default dict .defaults) -}}
  {{- $item := index $.defaults $name -}}
  {{- $owner := dig "owner" "" $item -}}
  {{- if and $owner (not (hasKey $declared $owner)) -}}
    {{- fail (printf "defaults %s: unknown owner %q" $name $owner) -}}
  {{- end -}}
{{- end -}}

{{- /* One entry, one root. Luvus reassigns a tab to the workspace matching
       its pane's live cwd, so a second root splits the entry into two
       workspaces and no longer matches the Herdr and Zellij output. */ -}}
{{- range $ws := default (list) .workspaces -}}
  {{- $roots := list -}}
  {{- range $tab := dig "tabs" (list) $ws -}}
    {{- range $pane := dig "panes" (list) $tab -}}
      {{- if hasKey $pane "cwd" -}}
        {{- $roots = append $roots $pane.cwd -}}
      {{- else if hasKey $pane "path" -}}
        {{- $roots = append $roots (printf "%s/%s" (join "." $pane.path) (dig "dest" "" $pane)) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- if gt (len (uniq $roots)) 1 -}}
    {{- fail (printf "workspace %s: %d roots %s; split it into one entry per root" (dig "name" "?" $ws) (len (uniq $roots)) (uniq $roots | toJson)) -}}
  {{- end -}}
{{- end -}}

ok
