{{- end -}}
{{- if or (hasKey $expanded "lane-high") (ne (float64 (index $expanded "lane-high-fast").cost.input) 1.0) -}}
  {{- fail "expand-model-overrides: fast priced the standard lane" -}}
{{- end -}}
{{- if ne (float64 (index $expanded "cursor-claude-fable-5-high").cost.input) 10.0 -}}
  {{- fail "expand-model-overrides: cursor prefix" -}}
{{- end -}}

{{- /* Pi projects the same stem cards. The fast lane is not the slow rate. */ -}}
{{- $projected := includeTemplate "llm/pi-cursor-costs" (dict
      "overrides" (dict
        "grok-4.7" (dict "name" "Grok" "cost" (dict "input" 2 "output" 6 "cacheRead" 0.5 "cacheWrite" 0 "longContext" (dict "inputThreshold" 200000 "input" 4 "output" 12 "cacheRead" 1 "cacheWrite" 0)))
        "grok-4.7-fast" (dict "cost" (dict "input" 4 "output" 12 "cacheRead" 1 "cacheWrite" 0))
        "composer-2.5" (dict "cost" (dict "input" 0.5 "output" 2.5 "cacheRead" 0.2 "cacheWrite" 0))
        "composer-2.5-fast" (dict "cost" (dict "input" 3 "output" 15 "cacheRead" 0.5 "cacheWrite" 0)))
      "models" (dict
        "grok-4.7" (dict "contexts" (list "256k" "500k") "fast" true "default_fast" true)
        "composer-2.5" (dict "fast" true "default_fast" true)
        "missing-stem" (dict))) | fromJson -}}
{{- if or (ne (float64 (index $projected "grok-4.7@500k:fast").cost.input) 4.0) (hasKey (index $projected "grok-4.7@500k:fast").cost "tiers") (ne (len (index $projected "grok-4.7@500k:fast")) 1) -}}
  {{- fail "pi-cursor-costs: fast lane" -}}
{{- end -}}
{{- if or (ne (float64 (index $projected "grok-4.7@256k").cost.input) 4.0) (ne (float64 (index $projected "grok-4.7@500k:slow").cost.input) 2.0) (ne (int (index (index $projected "grok-4.7@500k:slow").cost.tiers 0).inputTokensAbove) 200000) -}}
  {{- fail "pi-cursor-costs: default fast and slow tier" -}}
{{- end -}}
{{- if or (ne (float64 (index $projected "composer-2.5").cost.input) 3.0) (ne (float64 (index $projected "composer-2.5:slow").cost.input) 0.5) (hasKey $projected "composer-2.5@200k") (hasKey $projected "missing-stem") -}}
  {{- fail "pi-cursor-costs: composer" -}}
{{- end -}}

{{- /* Image input is copied only when the stem card and its fast key both exist.
      The live catalog is not on CI, so this fixture is the check. */ -}}
{{- $imaged := includeTemplate "llm/expand-model-overrides" (dict
      "overrides" (dict
        "grok-4.7" (dict "cost" (dict "input" 2 "output" 6) "input" (list "text" "image"))
        "grok-4.7-fast" (dict "cost" (dict "input" 4 "output" 12))
        "plain" (dict "cost" (dict "input" 1 "output" 1) "input" (list "text" "image")))) | fromJson -}}
{{- if or (not (has "image" (index $imaged "grok-4.7-high-fast").input)) (ne (float64 (index $imaged "grok-4.7-high-fast").cost.input) 4.0) (not (has "image" (index $imaged "grok-4.7-high").input)) (hasKey (index $imaged "plain-high") "input") -}}
  {{- fail "expand-model-overrides: image follows the fast lane" -}}
{{- end -}}

{{- /* Live projection uses the shared rate table. Stem list prices come from
      models.dev and are absent on CI, so only cards in llm/cursor.yaml are checked here. */ -}}
{{- $ompCursor := index (includeTemplate "llm/custom-providers" (merge (dict "tool" "omp") .) | fromJson) "cursor" "modelOverrides" -}}
{{- $ompFast := index $ompCursor "grok-4.7-high-fast" -}}
{{- if or (not $ompFast) (ne (float64 $ompFast.cost.input) 4.0) (ne (float64 (index $ompCursor "composer-2.5").cost.input) 0.5) (ne (float64 (index $ompCursor "composer-2.5-fast").cost.input) 3.0) -}}
  {{- fail "cursor rates: omp projection" -}}
{{- end -}}
{{- $piCursor := index (includeTemplate "llm/custom-providers" (merge (dict "tool" "pi") .) | fromJson) "cursor" "modelOverrides" -}}
{{- if or (hasKey $piCursor "grok-4.7-high-fast") (ne (float64 (index $piCursor "grok-4.7@500k:fast").cost.input) 4.0) (ne (float64 (index $piCursor "composer-2.5").cost.input) 3.0) (ne (float64 (index $piCursor "composer-2.5:slow").cost.input) 0.5) (ne (float64 (index $piCursor "claude-opus-5-5@1m:fast").cost.input) 8.0) (ne (float64 (index $piCursor "claude-opus-5-5@1m").cost.input) 4.0) (ne (float64 (index (index (index $piCursor "gpt-5.6-luna@1m:fast").cost.tiers 0) "input")) 0.8) -}}
  {{- fail "cursor rates: pi projection" -}}
{{- end -}}

ok
