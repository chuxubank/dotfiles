{{- /* verify/contracts — Self-contained checks for resolver interfaces.
       fail() aborts chezmoi execute-template on mismatch. */ -}}

{{- /* when/range: ints and JSON float64 */ -}}
{{- if ne (includeTemplate "when/range" (dict "value" 10 "rule" (dict "min" 8)) | fromJson) true -}}
  {{- fail "when/range: 10 >= 8" -}}
{{- end -}}
{{- if ne (includeTemplate "when/range" (dict "value" 4 "rule" (dict "min" 8)) | fromJson) false -}}
  {{- fail "when/range: 4 >= 8" -}}
{{- end -}}
{{- if ne (includeTemplate "when/range" (dict "value" 12 "rule" (dict "max" 10)) | fromJson) false -}}
  {{- fail "when/range: 12 <= 10" -}}
{{- end -}}
{{- if ne (includeTemplate "when/range" (dict "value" 0 "rule" (dict "min" 8)) | fromJson) true -}}
  {{- fail "when/range: unknown 0 is lenient" -}}
{{- end -}}
{{- $jsonRule := fromJson "{\"min\": 256, \"max\": 1024}" -}}
{{- if ne (includeTemplate "when/range" (dict "value" (fromJson "512") "rule" $jsonRule) | fromJson) true -}}
  {{- fail "when/range: JSON float64 512 in [256,1024]" -}}
{{- end -}}
{{- if ne (includeTemplate "when/range" (dict "value" (fromJson "128") "rule" $jsonRule) | fromJson) false -}}
  {{- fail "when/range: JSON float64 128 in [256,1024]" -}}
{{- end -}}
{{- if ne (includeTemplate "when/range" (dict "value" (fromJson "0") "rule" $jsonRule) | fromJson) true -}}
  {{- fail "when/range: JSON float64 0 is lenient" -}}
{{- end -}}

{{- /* host/disk-available-gb: dynamic root-filesystem probe */ -}}
{{- $availableGb := includeTemplate "host/disk-available-gb" (dict "chezmoi" (dict "os" "darwin")) | fromJson -}}
{{- if or (lt $availableGb 0) (gt $availableGb 1000000000) -}}
  {{- fail (printf "host/disk-available-gb: unexpected value %d" $availableGb) -}}
{{- end -}}

{{- /* when/context: dynamic disk availability condition */ -}}
{{- $diskItem := dict "when" (dict "enabled" (dict "disk_available_gb" (dict "min" 1))) -}}
{{- if ne (includeTemplate "when/context" (dict
      "item" $diskItem
      "device_type" "laptop"
      "host_env" "personal"
      "roles" (list)
      "mem_gb" 16
      "disk_gb" 512
      "chezmoi" (dict "os" "darwin")) | fromJson) true -}}
  {{- fail "when/context: current available disk should satisfy min 1 on this host" -}}
{{- end -}}

{{- /* llm/resolve-model-alias: shared ids expand inside provider-qualified refs. */ -}}
{{- $aliasedModel := includeTemplate "llm/resolve-model-alias" (dict
      "model" "openai/${gpt_primary}:high"
      "aliases" (dict "gpt_primary" "gpt-5.6-sol")) -}}
{{- if ne $aliasedModel "openai/gpt-5.6-sol:high" -}}
  {{- fail (printf "llm/resolve-model-alias: unexpected expansion %q" $aliasedModel) -}}
{{- end -}}

{{- /* llm/split-model: split only configured aliases and preserve model slashes */ -}}
{{- $splitModel := includeTemplate "llm/split-model" (dict
      "model" "openrouter/vendor/model"
      "providers" (dict "openrouter" (dict))) | fromJson -}}
{{- if or (ne $splitModel.provider "openrouter") (ne $splitModel.model "vendor/model") -}}
  {{- fail (printf "llm/split-model: unexpected split %s" ($splitModel | toJson)) -}}
{{- end -}}
{{- $bareModel := includeTemplate "llm/split-model" (dict
      "model" "vendor/model"
      "providers" (dict "openrouter" (dict))) | fromJson -}}
{{- if or $bareModel.provider (ne $bareModel.model "vendor/model") -}}
  {{- fail (printf "llm/split-model: unconfigured prefix must be preserved %s" ($bareModel | toJson)) -}}
{{- end -}}

{{- /* llm/pick-model: first resolved alias, else last candidate */ -}}
{{- $picked := includeTemplate "llm/pick-model" (dict
      "models" (list "iv/flash" "openai/sol" "xai/grok")
      "providers" (dict "openai" (dict))) -}}
{{- if ne $picked "openai/sol" -}}
  {{- fail (printf "llm/pick-model: first resolved alias, got %s" $picked) -}}
{{- end -}}
{{- $fallback := includeTemplate "llm/pick-model" (dict
      "models" (list "iv/flash" "xai/grok")
      "providers" (dict "openai" (dict))) -}}
{{- if ne $fallback "xai/grok" -}}
  {{- fail (printf "llm/pick-model: unresolved should take last, got %s" $fallback) -}}
{{- end -}}

{{- /* when/evaluate AND groups */ -}}
{{- $hostItem := dict "when" (dict "enabled" (dict "host_env" (list "iv" "aa"))) -}}
{{- if ne (includeTemplate "when/evaluate" (dict "item" $hostItem "values" (dict "host_env" "iv") "os_version" "") | fromJson) true -}}
  {{- fail "when/evaluate: iv matches enabled.host_env" -}}
{{- end -}}
{{- if ne (includeTemplate "when/evaluate" (dict "item" $hostItem "values" (dict "host_env" "personal") "os_version" "") | fromJson) false -}}
  {{- fail "when/evaluate: personal misses enabled.host_env" -}}
{{- end -}}
{{- $disabledItem := dict "when" (dict "disabled" (dict "host_env" (list "ci"))) -}}
{{- if ne (includeTemplate "when/evaluate" (dict "item" $disabledItem "values" (dict "host_env" "ci") "os_version" "") | fromJson) false -}}
  {{- fail "when/evaluate: ci hits disabled.host_env" -}}
{{- end -}}
{{- if ne (includeTemplate "when/evaluate" (dict "item" $disabledItem "values" (dict "host_env" "personal") "os_version" "") | fromJson) true -}}
  {{- fail "when/evaluate: personal misses disabled.host_env" -}}
{{- end -}}

{{- /* tool/enabled */ -}}
{{- $tools := dict
      "claude-code" (dict "when" (dict "enabled" (dict "host_env" (list "iv"))))
      "codex" (dict "when" (dict "disabled" (dict "host_env" (list "ci"))))
-}}
{{- $base := dict
      "tools" $tools
      "device_type" "laptop"
      "roles" (list)
      "mem_gb" 16
      "disk_gb" 512
      "os_version" "26.0"
      "chezmoi" (dict "os" "darwin")
-}}
{{- if ne (includeTemplate "tool/enabled" (merge (dict) $base (dict "tool" "claude-code" "host_env" "iv")) | fromJson) true -}}
  {{- fail "tool/enabled: claude-code on iv" -}}
{{- end -}}
{{- if ne (includeTemplate "tool/enabled" (merge (dict) $base (dict "tool" "claude-code" "host_env" "personal")) | fromJson) false -}}
  {{- fail "tool/enabled: claude-code off personal" -}}
{{- end -}}
{{- if ne (includeTemplate "tool/enabled" (merge (dict) $base (dict "tool" "codex" "host_env" "ci")) | fromJson) false -}}
  {{- fail "tool/enabled: codex off ci" -}}
{{- end -}}
{{- if ne (includeTemplate "tool/enabled" (merge (dict) $base (dict "tool" "codex" "host_env" "personal")) | fromJson) true -}}
  {{- fail "tool/enabled: codex on personal" -}}
{{- end -}}
{{- if ne (includeTemplate "tool/enabled" (dict "tool" "unknown" "tools" $tools) | fromJson) true -}}
  {{- fail "tool/enabled: undeclared defaults on" -}}
{{- end -}}

{{- /* integrations/owners: fixed dispatcher selects by mode and platform. */ -}}
{{- $integrationTools := dict
      "active" (dict)
      "cleanup-only" (dict "when" (dict "enabled" false))
      "windows-only" (dict)
      "codex" (dict)
-}}
{{- $integrationOwners := dict
      "active" (dict "lifecycle" (dict) "targets" (list (dict "tool" "codex")))
      "cleanup-only" (dict
        "lifecycle" (dict "setup" false)
        "targets" (list (dict "tool" "codex")))
      "windows-only" (dict
        "lifecycle" (dict "os" (list "windows"))
        "targets" (list (dict "tool" "codex")))
-}}
{{- $integrationCtx := merge (dict) $base (dict
      "tools" $integrationTools
      "integration_owners" $integrationOwners
      "host_env" "personal"
      "chezmoi" (dict "os" "darwin")) -}}
{{- $setupOwners := includeTemplate "integrations/owners" (merge (dict "mode" "setup") $integrationCtx) | fromJson -}}
{{- if or (ne (len $setupOwners) 1) (ne (index $setupOwners 0) "active") -}}
  {{- fail (printf "integrations/owners: unexpected setup owners %s" ($setupOwners | toJson)) -}}
{{- end -}}
{{- $teardownOwners := includeTemplate "integrations/owners" (merge (dict "mode" "teardown") $integrationCtx) | fromJson -}}
{{- if or (ne (len $teardownOwners) 1) (ne (index $teardownOwners 0) "cleanup-only") -}}
  {{- fail (printf "integrations/owners: unexpected teardown owners %s" ($teardownOwners | toJson)) -}}
{{- end -}}

{{- /* tool/item-enabled: owner required, tool is identity unless alias */ -}}
{{- $owned := dict "owner" "claude-code" -}}
{{- if ne (includeTemplate "tool/item-enabled" (merge (dict) $base (dict "item" $owned "host_env" "iv")) | fromJson) true -}}
  {{- fail "tool/item-enabled: owner claude-code on iv" -}}
{{- end -}}
{{- if ne (includeTemplate "tool/item-enabled" (merge (dict) $base (dict "item" $owned "host_env" "personal")) | fromJson) false -}}
  {{- fail "tool/item-enabled: owner claude-code off personal" -}}
{{- end -}}
{{- $identity := dict "tool" "claude-code" -}}
{{- if ne (includeTemplate "tool/item-enabled" (merge (dict) $base (dict "item" $identity "host_env" "personal")) | fromJson) true -}}
  {{- fail "tool/item-enabled: identity tool is not an implicit owner" -}}
{{- end -}}
{{- $alias := dict "tool" "claude-code" -}}
{{- if ne (includeTemplate "tool/item-enabled" (merge (dict) $base (dict "item" $alias "alias" true "host_env" "personal")) | fromJson) false -}}
  {{- fail "tool/item-enabled: alias tool=claude-code off personal" -}}
{{- end -}}
{{- if ne (includeTemplate "tool/item-enabled" (merge (dict) $base (dict "item" (dict "name" "black") "host_env" "personal")) | fromJson) true -}}
  {{- fail "tool/item-enabled: no owner stays on" -}}
{{- end -}}
{{- /* mcp/when: owner is the lifecycle switch, tool is the consuming agent */ -}}
{{- $mcpOwned := dict "name" "Owned Server" "owner" "claude-code" -}}
{{- if ne (includeTemplate "mcp/when" (merge (dict) $base (dict "provider" $mcpOwned "tool" "pi" "host_env" "personal")) | fromJson) false -}}
  {{- fail "mcp/when: owner claude-code off personal" -}}
{{- end -}}
{{- if ne (includeTemplate "mcp/when" (merge (dict) $base (dict "provider" $mcpOwned "tool" "pi" "host_env" "iv")) | fromJson) true -}}
  {{- fail "mcp/when: owner claude-code on iv" -}}
{{- end -}}
{{- $mcpFree := dict "name" "Unowned Server" -}}
{{- if ne (includeTemplate "mcp/when" (merge (dict) $base (dict "provider" $mcpFree "tool" "pi" "host_env" "personal")) | fromJson) true -}}
  {{- fail "mcp/when: no owner stays on" -}}
{{- end -}}
{{- $mcpAgentGated := dict "name" "Agent Gated" "owner" "codex" "when" (dict "disabled" (dict "tool" (list "pi"))) -}}
{{- if ne (includeTemplate "mcp/when" (merge (dict) $base (dict "provider" $mcpAgentGated "tool" "pi" "host_env" "personal")) | fromJson) false -}}
  {{- fail "mcp/when: when.disabled.tool must still gate the consuming agent" -}}
{{- end -}}
{{- if ne (includeTemplate "mcp/when" (merge (dict) $base (dict "provider" $mcpAgentGated "tool" "codex" "host_env" "personal")) | fromJson) true -}}
  {{- fail "mcp/when: owner on, other agent allowed" -}}
{{- end -}}

{{- /* package/items */ -}}
{{- $pkgCtx := merge (dict) $base (dict
      "host_env" "personal"
      "packages" (dict "python" (dict "tools" (list
        "black"
        (dict "name" "sentry" "owner" "claude-code")
        (dict "name" "gone" "ensure" "absent"))))) -}}
{{- $pkgs := includeTemplate "package/items" (dict "ctx" $pkgCtx "path" (list "python" "tools")) | fromJson -}}
{{- if ne (len $pkgs) 1 -}}
  {{- fail (printf "package/items: expected 1 item, got %d %s" (len $pkgs) ($pkgs | toJson)) -}}
{{- end -}}
{{- if ne (index $pkgs 0) "black" -}}
  {{- fail "package/items: expected black" -}}
{{- end -}}

{{- /* skills/when: owner gates; a top-level tool field is not an owner alias */ -}}
{{- $skillOn := dict "name" "herdr" "owner" "codex" -}}
{{- $skillCtx := merge (dict) $base (dict
      "host_env" "personal"
      "skill" $skillOn
      "skills" (dict "agents" (list "codex" "amp"))) -}}
{{- $agents := includeTemplate "skills/when" $skillCtx | fromJson -}}
{{- if ne (len $agents) 2 -}}
  {{- fail (printf "skills/when: expected amp+codex, got %s" ($agents | toJson)) -}}
{{- end -}}
{{- $skillOff := dict "name" "herdr" "owner" "claude-code" -}}
{{- $agentsOff := includeTemplate "skills/when" (merge (dict) $base (dict
      "host_env" "personal"
      "skill" $skillOff
      "skills" (dict "agents" (list "codex" "amp")))) | fromJson -}}
{{- if ne (len $agentsOff) 0 -}}
  {{- fail "skills/when: disabled owner should yield no agents" -}}
{{- end -}}
{{- $skillToolField := dict "name" "herdr" "tool" "claude-code" -}}
{{- $agentsToolField := includeTemplate "skills/when" (merge (dict) $base (dict
      "host_env" "personal"
      "skill" $skillToolField
      "skills" (dict "agents" (list "codex" "amp")))) | fromJson -}}
{{- if ne (len $agentsToolField) 2 -}}
  {{- fail "skills/when: tool identity must not act as owner" -}}
{{- end -}}
{{- $agentsSlugOff := includeTemplate "skills/when" (merge (dict) $base (dict
      "host_env" "personal"
      "skill" (dict "name" "find-docs")
      "skills" (dict "agents" (list
        (dict "name" "hermes-agent" "owner" "claude-code")
        "codex")))) | fromJson -}}
{{- if ne (len $agentsSlugOff) 1 -}}
  {{- fail (printf "skills/when: expected only codex when slug owner is off, got %s" ($agentsSlugOff | toJson)) -}}
{{- end -}}
{{- if ne (index $agentsSlugOff 0) "codex" -}}
  {{- fail "skills/when: remaining agent should be the skills CLI slug" -}}
{{- end -}}

{{- /* skills/external: owner gates protection; missing owner is rejected */ -}}
{{- $externalOn := includeTemplate "skills/external" (merge (dict) $base (dict
      "host_env" "personal"
      "skills" (dict "external" (list
        (dict "name" "zeta" "owner" "codex")
        (dict "name" "alpha" "owner" "codex"))))) | fromJson -}}
{{- if or (ne (len $externalOn) 2) (ne (index $externalOn 0) "alpha") -}}
  {{- fail (printf "skills/external: expected sorted alpha+zeta, got %s" ($externalOn | toJson)) -}}
{{- end -}}
{{- $externalOff := includeTemplate "skills/external" (merge (dict) $base (dict
      "host_env" "personal"
      "skills" (dict "external" (list
        (dict "name" "alpha" "owner" "claude-code"))))) | fromJson -}}
{{- if ne (len $externalOff) 0 -}}
  {{- fail "skills/external: disabled owner must drop the name so cleanup reaps it" -}}
{{- end -}}
{{- $externalEmpty := includeTemplate "skills/external" (merge (dict) $base (dict
      "host_env" "personal"
      "skills" (dict))) | fromJson -}}
{{- if ne (len $externalEmpty) 0 -}}
  {{- fail "skills/external: absent key should yield an empty list" -}}
{{- end -}}
{{- $agentsSlugOn := includeTemplate "skills/when" (merge (dict) $base (dict
      "host_env" "personal"
      "skill" (dict "name" "find-docs")
      "skills" (dict "agents" (list
        (dict "name" "hermes-agent" "owner" "codex")
        "amp")))) | fromJson -}}
{{- if ne (len $agentsSlugOn) 2 -}}
  {{- fail (printf "skills/when: expected hermes-agent+amp, got %s" ($agentsSlugOn | toJson)) -}}
{{- end -}}

{{- /* disabled-ignore uses dirname, not the first path segment */ -}}
{{- $ignoreCtx := merge (dict) $base (dict
      "host_env" "ci"
      "tools" (dict "rclone" (dict
        "when" (dict "disabled" (dict "host_env" (list "ci")))
        "remove" (list ".config/rclone/rclone.conf")
        "purge" (list ".config/rclone/**")))) -}}
{{- $ignore := printf "\n%s\n" (includeTemplate "tool/disabled-ignore" $ignoreCtx) -}}
{{- if contains "\n.config\n" $ignore -}}
  {{- fail "disabled-ignore: must not ignore .config" -}}
{{- end -}}
{{- if not (contains "\n.config/rclone\n" $ignore) -}}
  {{- fail (printf "disabled-ignore: expected .config/rclone, got %q" $ignore) -}}
{{- end -}}

{{- /* disabled-ignore derives a parent from every remove/purge path. A
       two-segment path under a non-hidden first segment makes that parent a
       shared tree (bin/herdr-layout once ignored all of ~/bin and froze every
       home/bin script). Gate such a file's template on tool/enabled instead. */ -}}
{{- range $name, $spec := default dict .tools -}}
  {{- range $pattern := concat (dig "remove" (list) $spec) (dig "purge" (list) $spec) -}}
    {{- $parts := splitList "/" (trimSuffix "/**" $pattern) -}}
    {{- if and (eq (len $parts) 2) (not (hasPrefix "." (index $parts 0))) -}}
      {{- fail (printf "tool %s: %q would make disabled-ignore skip the shared tree %q" $name $pattern (index $parts 0)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- /* service/services: identity tool does not gate; owner does */ -}}
{{- $svcCtx := merge (dict) $base (dict
      "host_env" "personal"
      "services" (list
        (dict "tool" "isync" "brew" true)
        (dict "tool" "rclone" "owner" "claude-code" "target" "nutstore"))) -}}
{{- $svcs := includeTemplate "service/services" $svcCtx | fromJson -}}
{{- if ne (len $svcs) 1 -}}
  {{- fail (printf "service/services: expected only isync, got %s" ($svcs | toJson)) -}}
{{- end -}}
{{- if ne (index $svcs 0).tool "isync" -}}
  {{- fail "service/services: expected isync" -}}
{{- end -}}

{{- /* Homebrew 6 launchd dest/label is sh.brew.<formula>, not homebrew.mxcl.<formula> */ -}}
{{- $brewDarwin := includeTemplate "service/label" (dict "os" "darwin" "service" (dict "tool" "isync" "brew" true)) -}}
{{- if ne $brewDarwin "sh.brew.isync" -}}
  {{- fail (printf "service/label: darwin brew expected sh.brew.isync, got %q" $brewDarwin) -}}
{{- end -}}
{{- $brewLinux := includeTemplate "service/label" (dict "os" "linux" "service" (dict "tool" "isync" "brew" true)) -}}
{{- if ne $brewLinux "homebrew.isync" -}}
  {{- fail (printf "service/label: linux brew expected homebrew.isync, got %q" $brewLinux) -}}
{{- end -}}
{{- $customLabel := includeTemplate "service/label" (dict "os" "darwin" "service" (dict "tool" "gitwatch" "target" "org")) -}}
{{- if ne $customLabel "gitwatch.org" -}}
  {{- fail (printf "service/label: expected gitwatch.org, got %q" $customLabel) -}}
{{- end -}}

{{- /* workspace/items: CI omitted by default; host-gated entries still filter */ -}}
{{- $workspaceDefs := list
      (dict "name" "always")
      (dict "name" "personal" "when" (dict "enabled" (dict "host_env" (list "personal"))))
-}}
{{- $personalWorkspaces := includeTemplate "workspace/items" (merge (dict) $base (dict
      "host_env" "personal"
      "workspaces" $workspaceDefs)) | fromJson -}}
{{- if or (ne (len $personalWorkspaces) 2) (ne (index $personalWorkspaces 1).name "personal") -}}
  {{- fail (printf "workspace/items: personal should include gated entry, got %s" ($personalWorkspaces | toJson)) -}}
{{- end -}}
{{- $ciWorkspaces := includeTemplate "workspace/items" (merge (dict) $base (dict
      "host_env" "ci"
      "workspaces" $workspaceDefs)) | fromJson -}}
{{- if ne (len $ciWorkspaces) 0 -}}
  {{- fail (printf "workspace/items: ci should omit every entry, got %s" ($ciWorkspaces | toJson)) -}}
{{- end -}}

{{- /* model-config/omp: models.dev row → OMP patch, including Grok minimal. */ -}}
{{- $grokOverride := includeTemplate "model-config/omp" (dict
      "name" "Grok 4.7"
      "reasoning" true
      "reasoning_options" (list (dict "type" "effort" "values" (list "low" "medium" "high" "xhigh")))
      "modalities" (dict "input" (list "text" "image" "pdf"))
      "limit" (dict "context" 500000 "output" 500000)
      "cost" (dict "input" 2 "output" 6 "cache_read" 0.5)
      "tool_call" true) | fromJson -}}
{{- if ne $grokOverride.name "Grok 4.7" -}}
  {{- fail (printf "model-config/omp: name %q" $grokOverride.name) -}}
{{- end -}}
{{- if ne $grokOverride.reasoning true -}}
  {{- fail "model-config/omp: reasoning" -}}
{{- end -}}
{{- if or (ne $grokOverride.thinking.mode "effort") (ne (index $grokOverride.thinking.efforts 0) "minimal") (ne (index $grokOverride.thinking.effortMap "minimal") "low") -}}
  {{- fail (printf "model-config/omp: thinking %s" ($grokOverride.thinking | toJson)) -}}
{{- end -}}
{{- if not (has "image" $grokOverride.input) -}}
  {{- fail (printf "model-config/omp: input %s" ($grokOverride.input | toJson)) -}}
{{- end -}}
{{- if or (ne $grokOverride.contextWindow 500000) (ne $grokOverride.maxTokens 500000) -}}
  {{- fail (printf "model-config/omp: limits %v/%v" $grokOverride.contextWindow $grokOverride.maxTokens) -}}
{{- end -}}
{{- if or (ne (float64 $grokOverride.cost.input) 2.0) (ne (float64 $grokOverride.cost.cacheRead) 0.5) -}}
  {{- fail (printf "model-config/omp: cost %s" ($grokOverride.cost | toJson)) -}}
{{- end -}}
{{- if ne $grokOverride.supportsTools true -}}
  {{- fail "model-config/omp: supportsTools" -}}
{{- end -}}
{{- $grok43 := includeTemplate "model-config/omp" (dict
      "name" "Grok 4.3"
      "reasoning_options" (list (dict "type" "effort" "values" (list "none" "low" "medium" "high")))) | fromJson -}}
{{- if or (has "none" $grok43.thinking.efforts) (not (has "minimal" $grok43.thinking.efforts)) -}}
  {{- fail (printf "model-config/omp: drop none %s" ($grok43.thinking | toJson)) -}}
{{- end -}}


{{- /* llm/expand-model-overrides: effort siblings, thinking compounds, Fast lanes. */ -}}
{{- $expanded := includeTemplate "llm/expand-model-overrides" (dict
      "prefixes" (list "cursor-")
      "overrides" (dict
        "claude-opus-5" (dict "cost" (dict "input" 5 "output" 25))
        "claude-opus-5-high" (dict "cost" (dict "input" 99 "output" 99))
        "claude-opus-5-fast" (dict "cost" (dict "input" 10 "output" 50))
        "claude-fable-5" (dict "name" "Fable 5" "cost" (dict "input" 10 "output" 50))
        "claude-opus-5-5" (dict "cost" (dict "input" 4 "output" 20))
        "claude-opus-5-5-fast" (dict "cost" (dict "input" 8 "output" 40))
        "lane-fast" (dict "cost" (dict "input" 1 "output" 2)))) | fromJson -}}
{{- if ne (index $expanded "claude-fable-5").name "Fable 5" -}}
  {{- fail "expand-model-overrides: full card lost" -}}
{{- end -}}
{{- if ne (float64 (index $expanded "claude-opus-5-high").cost.input) 99.0 -}}
  {{- fail "expand-model-overrides: explicit effort lost" -}}
{{- end -}}
{{- if or (ne (float64 (index $expanded "claude-opus-5-thinking-max").cost.input) 5.0) (ne (float64 (index $expanded "claude-opus-5-thinking-max-fast").cost.input) 10.0) -}}
  {{- fail "expand-model-overrides: thinking compound" -}}
{{- end -}}
{{- if ne (float64 (index $expanded "claude-fable-5-thinking-high").cost.input) 10.0 -}}
  {{- fail "expand-model-overrides: fable thinking" -}}
{{- end -}}
{{- if or (ne (float64 (index $expanded "claude-opus-5-5-high").cost.input) 4.0) (ne (float64 (index $expanded "claude-opus-5-5-high-fast").cost.input) 8.0) -}}
