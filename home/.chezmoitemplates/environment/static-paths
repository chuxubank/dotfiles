{{- /* environment/static-paths — Enabled static PATH entries, in data order.
       Shells and GUI launchers that do not source zshenv both consume this
       list. Input: root context. Output: JSON array of directory strings. */ -}}
{{- $ctx := . -}}
{{- $paths := list -}}
{{- range $tool := .environment.static -}}
  {{- $enabled := includeTemplate "tool/item-enabled" (merge (dict "item" $tool) $ctx) | fromJson -}}
  {{- if and $enabled (hasKey $tool "when") -}}
    {{- $enabled = includeTemplate "when/context" (merge (dict "item" $tool) $ctx) | fromJson -}}
  {{- end -}}
  {{- if $enabled -}}
    {{- range dig "path" (list) $tool -}}
      {{- $paths = append $paths (includeTemplate "environment/value" (dict "ctx" $ctx "item" .)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $paths | toJson -}}
