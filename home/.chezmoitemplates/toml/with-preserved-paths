{{- $config := .config -}}
{{- $existing := dict -}}
{{- if stat .path }}
  {{- $existing = output "cat" .path | fromToml -}}
{{- end -}}
{{- range $path := .preserve }}
  {{- $value := $existing -}}
  {{- $found := true -}}
  {{- range $key := splitList "." $path }}
    {{- if and $found (eq (kindOf $value) "map") (hasKey $value $key) -}}
      {{- $value = index $value $key -}}
    {{- else -}}
      {{- $found = false -}}
    {{- end -}}
  {{- end -}}
  {{- if $found -}}
    {{- $config = $config | setValueAtPath $path $value -}}
  {{- end -}}
{{- end -}}
{{ $config | toToml }}
