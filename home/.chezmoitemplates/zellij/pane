{{- /* zellij/pane — dict "pane" "indent" */ -}}
{{- $p := .pane -}}
{{- $indent := .indent -}}
{{- $cmd := "" -}}
{{- $args := list -}}
{{- if hasKey $p "command" }}{{ $cmd = $p.command }}{{ else if hasKey $p "kind" }}{{ $cmd = $p.kind }}{{ if eq $p.kind "pi" }}{{ $args = list "--session-control" }}{{ end }}{{ end -}}
{{- $indent }}pane{{ if $cmd }} command={{ $cmd | quote }}{{ end }}{{ if hasKey $p "cwd" }} cwd={{ $p.cwd | quote }}{{ end }}{{ if and (hasKey $p "focus") $p.focus }} focus=true{{ end -}}
{{- if $args }} {
{{ range $a := $args -}}
{{ $indent }}    args {{ $a | quote }}
{{ end -}}
{{ $indent }}}
{{- end -}}
