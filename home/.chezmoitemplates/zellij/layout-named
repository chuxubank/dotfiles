{{- /* zellij/layout-named — render the workspace whose name is .workspaceName */ -}}
{{- $name := .workspaceName -}}
{{- $selected := list -}}
{{- range includeTemplate "workspace/items" . | fromJson }}
  {{- if eq .name $name }}
    {{- $selected = append $selected . }}
  {{- end }}
{{- end -}}
{{- includeTemplate "zellij/layout" (dict "workspaces" $selected) -}}
