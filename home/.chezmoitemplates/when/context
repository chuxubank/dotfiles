{{- /* Check whether an item passes host_env/device_type/roles conditions. */ -}}
{{- $hostEnvOk := includeTemplate "when/check" (dict "item" .item "key" "host_env" "value" .host_env) | fromJson -}}
{{- $deviceTypeOk := includeTemplate "when/check" (dict "item" .item "key" "device_type" "value" .device_type) | fromJson -}}
{{- $rolesOk := includeTemplate "when/check" (dict "item" .item "key" "roles" "value" .roles) | fromJson -}}
{{- toJson (and $hostEnvOk $deviceTypeOk $rolesOk) -}}
