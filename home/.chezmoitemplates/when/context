{{- /* Check whether an item passes all host context conditions. */ -}}
{{- includeTemplate "when/evaluate" (dict
      "item" .item
      "values" (dict
        "device_type" .device_type
        "host_env" .host_env
        "os" .chezmoi.os
        "roles" .roles
        "mem_gb" (dig "mem_gb" 0 .)
        "disk_gb" (dig "disk_gb" 0 .))
      "os_version" (dig "os_version" "" .)) -}}
