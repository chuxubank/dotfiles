{{- /* plugins/payload — One manager plus resolved plugin and marketplace data. */ -}}
{{- $name := .manager -}}
{{- if not $name -}}{{- fail "plugins/payload: missing manager" -}}{{- end -}}
{{- $manager := deepCopy (index .plugin_managers $name) -}}
{{- $_ := set $manager "name" $name -}}
{{- $_ := set $manager "declared_plugins" (includeTemplate "plugins/resolve" (merge (dict "tool" $name) .) | fromJson) -}}
{{- $marketplaces := list -}}
{{- range $market := dig "marketplaces" (list) (dig $name dict .plugins) -}}
  {{- $enabled := includeTemplate "when/evaluate" (dict
        "item" $market
        "values" (dict
          "device_type" $.device_type
          "host_env" $.host_env
          "os" $.chezmoi.os
          "roles" $.roles
          "mem_gb" (dig "mem_gb" 0 $)
          "disk_gb" (dig "disk_gb" 0 $)
          "tool" $name)
        "os_version" (dig "os_version" "" $)) | fromJson -}}
  {{- $entry := dict "name" $market.name "source" $market.source "enabled" $enabled -}}
  {{- if hasKey $market "ref" -}}{{- $_ := set $entry "ref" $market.ref -}}{{- end -}}
  {{- $marketplaces = append $marketplaces $entry -}}
{{- end -}}
{{- $_ := set $manager "declared_marketplaces" $marketplaces -}}
{{- toJson $manager -}}
