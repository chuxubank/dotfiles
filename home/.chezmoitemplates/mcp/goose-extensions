{{- /* https://block.github.io/goose/docs/guides/config-file/#extensions-configuration */ -}}
{{- range $provider := .mcp.providers }}
  {{- $enabled := includeTemplate "mcp/when" (dict "provider" $provider "hosttype" $.hosttype "tool" (default "" $.tool)) | fromJson -}}
  {{ regexReplaceAll "[^a-z0-9]+" ($provider.name | lower) "-" }}:
    enabled: {{ $enabled }}
    type: {{ $provider.execution.type }}
    name: {{ regexReplaceAll "[^a-z0-9]+" ($provider.name | lower) "_" }}
    description: {{ $provider.description }}
    {{- if eq $provider.execution.type "stdio" }}
    cmd: {{ $provider.execution.cmd }}
    args:
      {{- range $provider.execution.args }}
    - {{ . | quote }}
      {{- end }}
	{{- else if or (eq $provider.execution.type "http") (eq $provider.execution.type "sse") }}
	uri: {{ $provider.execution.uri }}
    {{- end }}
    {{- if (hasKey $provider.execution "envs") }}
    envs:
      {{- $envs := includeTemplate "mcp/envs" $provider.execution.envs | fromJson | toYaml -}}
    {{- end }}
    timeout: {{ $provider.execution.timeout }}
    bundled: null
    display_name: {{ $provider.name }}
{{- end }}
