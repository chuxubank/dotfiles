{{- /* https://block.github.io/goose/docs/guides/config-file/#extensions-configuration */ -}}
{{- $all := includeTemplate "mcp/servers" (merge (dict "tool" "goose") $) | fromJson -}}
{{- range $s := $all }}
  {{ $s.name }}:
    enabled: {{ $s.enabled }}
    type: {{ $s.type }}
    name: {{ $s.name_snake }}
    description: {{ $s.description }}
    {{- if eq $s.type "stdio" }}
    cmd: {{ $s.cmd }}
    args:
      {{- range $s.args }}
    - {{ . | quote }}
      {{- end }}
	{{- else if or (eq $s.type "http") (eq $s.type "sse") }}
	uri: {{ $s.uri }}
    {{- end }}
    {{- if gt (len $s.envs) 0 }}
    envs:
      {{- $s.envs | toYaml | nindent 6 -}}
    {{- end }}
    timeout: {{ $s.timeout }}
    bundled: null
    display_name: {{ $s.display }}
{{- end }}
