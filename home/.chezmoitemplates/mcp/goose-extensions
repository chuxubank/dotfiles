{{- /* https://block.github.io/goose/docs/guides/config-file/#extensions-configuration */ -}}
{{- $providers := dict }}
{{- range .mcp.providers }}
  {{- $providerKey := regexReplaceAll "[^a-z0-9]+" (.name | lower) "-" }}
  {{- $provider := dict
        "name" (regexReplaceAll "[^a-z0-9]+" (.name | lower) "_")
        "display_name" .name
        "description" .description
        "enabled" .enabled
        "bundled" nil
    -}}
  {{- if eq .execution.type "stdio" }}
    {{- $provider = set $provider "type" "stdio" }}
    {{- $provider = set $provider "timeout" .execution.timeout }}
    {{- $provider = set $provider "cmd" .execution.cmd }}
    {{- $provider = set $provider "args" .execution.args }}
    {{- if (hasKey .execution "envs") }}
      {{- $envs := dict }}
      {{- range $key, $value := .execution.envs }}
        {{- if eq (kindOf $value) "map" }}
          {{- $secretValue := "" }}
          {{- if or (not (hasKey $value "type")) (eq $value.type "pass") }}
            {{- if (hasKey $value "field") }}
              {{- $secretValue = (index (passFields $value.path) $value.field) }}
            {{- else }}
              {{- $secretValue = (pass $value.path) }}
            {{- end }}
          {{- else if eq $value.type "output" }}
            {{- $secretValue = (outputList $value.cmd $value.args) }}
          {{- end }}
          {{- if and (hasKey $value "trim") $value.trim }}
            {{- $secretValue = ($secretValue | trim) }}
          {{- end }}
          {{- $envs = set $envs $key $secretValue }}
        {{- else }}
          {{- $envs = set $envs $key $value }}
        {{- end }}
      {{- end }}
      {{- if gt (len $envs) 0 }}
        {{- $provider = set $provider "envs" $envs }}
      {{- end }}
    {{- end }}
  {{- end }}
  {{- $providers = set $providers $providerKey $provider }}
{{- end }}
{{- if gt (len $providers) 0 }}
{{- toYaml $providers | nindent 2 }}
{{- end }}
