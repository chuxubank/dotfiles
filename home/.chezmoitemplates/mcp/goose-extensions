{{- /* https://block.github.io/goose/docs/guides/config-file/#extensions-configuration */ -}}
{{- range .mcp.providers }}
  {{ regexReplaceAll "[^a-z0-9]+" (.name | lower) "-" }}:
    enabled: {{ .enabled }}
    type: {{ .execution.type }}
    name: {{ regexReplaceAll "[^a-z0-9]+" (.name | lower) "_" }}
    description: {{ .description }}
    {{- if eq .execution.type "stdio" }}
    cmd: {{ .execution.cmd }}
    args:
      {{- range .execution.args }}
    - {{ . | quote }}
      {{- end }}
	{{- else if or (eq .execution.type "http") (eq .execution.type "sse") }}
	uri: {{ .execution.uri }}
    {{- end }}
    {{- if (hasKey .execution "envs") }}
    envs:
      {{- $envs := includeTemplate "mcp/envs" .execution.envs | fromJson | toYaml -}}
    {{- end }}
    timeout: {{ .execution.timeout }}
    bundled: null
    display_name: {{ .name }}
{{- end }}