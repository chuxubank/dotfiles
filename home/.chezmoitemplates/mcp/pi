{{- /* mcp/pi — mcp.providers as Pi's built-in ~/.pi/agent/mcp.json.
       Pi accepts stdio and streamable HTTP, but not legacy SSE. Keep disabled
       providers as enabled: false so /mcp can enable them later. Project MCP
       entries with the same name take precedence over these global entries.
*/ -}}
{{- $servers := dict -}}
{{- $all := includeTemplate "mcp/servers" (merge (dict "tool" "pi") $) | fromJson -}}
{{- range $s := $all }}
  {{- /* Pi rejects SSE; do not mislabel an /sse endpoint as HTTP. */ -}}
  {{- if eq $s.type "sse" }}
    {{- continue -}}
  {{- end }}
  {{- $server := dict "enabled" $s.enabled -}}

  {{- if eq $s.type "stdio" }}
    {{- $_ := set $server "command" $s.cmd -}}
    {{- if gt (len $s.args) 0 }}
      {{- $_ := set $server "args" $s.args -}}
    {{- end }}
    {{- if gt (len $s.envs) 0 }}
      {{- $_ := set $server "env" $s.envs -}}
    {{- end }}
  {{- else if eq $s.type "http" }}
    {{- $_ := set $server "url" $s.uri -}}
    {{- if hasKey $s "headers" }}
      {{- $_ := set $server "headers" $s.headers -}}
    {{- end }}
  {{- else }}
    {{- continue -}}
  {{- end }}

  {{- /* mcp.yaml carries seconds; Pi's per-request timeout is seconds. */ -}}
  {{- if gt $s.tool_timeout 0 }}
    {{- $_ := set $server "timeout" $s.tool_timeout -}}
  {{- else if gt $s.timeout 0 }}
    {{- $_ := set $server "timeout" $s.timeout -}}
  {{- end }}

  {{- $_ := set $servers $s.name $server -}}
{{- end -}}
{{- toJson (dict "mcpServers" $servers) -}}
