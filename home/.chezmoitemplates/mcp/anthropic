{{- /* https://code.claude.com/docs/en/mcp#user-scope */ -}}
{{- $servers := dict -}}
{{- $all := includeTemplate "mcp/servers" (merge (dict "tool" (default "claude-code" $.tool)) $) | fromJson -}}
{{- range $s := $all }}
  {{- if not $s.enabled }}{{ continue }}{{ end -}}
  {{- $server := dict -}}

  {{- if eq $s.type "stdio" }}
    {{- $_ := set $server "type" "stdio" -}}
    {{- $_ := set $server "command" $s.cmd -}}
    {{- if $s.args }}
      {{- $_ := set $server "args" $s.args -}}
    {{- end }}
  {{- else if or (eq $s.type "http") (eq $s.type "sse") }}
    {{- $_ := set $server "url" $s.uri -}}
    {{- $_ := set $server "type" $s.type -}}
    {{- if hasKey $s "headers" }}
      {{- $_ := set $server "headers" $s.headers -}}
    {{- end }}
  {{- else }}
    {{- continue -}}
  {{- end }}

  {{- if gt (len $s.envs) 0 }}
    {{- $_ := set $server "env" $s.envs -}}
  {{- end }}

  {{- $_ := set $servers $s.name $server -}}
{{- end -}}
{{- toJson $servers -}}
