{{- /* https://code.claude.com/docs/en/mcp#user-scope */ -}}
{{- $servers := dict -}}
{{- range $provider := .mcp.providers }}
  {{- $enabled := includeTemplate "mcp/when" (dict "provider" $provider "hosttype" $.hosttype "tool" (default "cc" $.tool)) | fromJson -}}
  {{- if not $enabled }}{{ continue }}{{ end -}}
  {{- $exec := $provider.execution -}}
  {{- $server := dict -}}

  {{- if eq $exec.type "stdio" }}
    {{- $_ := set $server "type" "stdio" -}}
    {{- $_ := set $server "command" $exec.cmd -}}
    {{- if hasKey $exec "args" }}
      {{- $_ := set $server "args" $exec.args -}}
    {{- end }}
  {{- else if or (eq $exec.type "http") (eq $exec.type "sse") }}
    {{- $_ := set $server "url" $exec.uri -}}
	{{- $_ := set $server "type" $exec.type -}}
    {{- if hasKey $exec "headers" }}
      {{- $_ := set $server "headers" $exec.headers -}}
    {{- end }}
  {{- else }}
    {{- /* Skip unsupported execution type */ -}}
    {{- continue -}}
  {{- end }}

  {{- if hasKey $exec "envs" }}
    {{- $envs := includeTemplate "mcp/envs" $exec.envs | fromJson -}}
    {{- if gt (len $envs) 0 }}
      {{- $_ := set $server "env" $envs -}}
    {{- end }}
  {{- end }}

  {{- $serverName := regexReplaceAll "[^A-Za-z0-9_-]+" ($provider.name | lower) "-" -}}
  {{- $_ := set $servers $serverName $server -}}
{{- end -}}
{{- toJson $servers -}}
