{{- /* Determine whether a provider is enabled based on `when.enabled` or `when.disabled`.
       Input:  dict "provider" $provider "hosttype" $hosttype "tool" $tool
       Output: JSON boolean */ -}}
{{- $ht := includeTemplate "when/check" (dict "item" .provider "key" "hosttype" "value" .hosttype) | fromJson -}}
{{- $t := includeTemplate "when/check" (dict "item" .provider "key" "tool" "value" .tool) | fromJson -}}
{{- toJson (and $ht $t) -}}
