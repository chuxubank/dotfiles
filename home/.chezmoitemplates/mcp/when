{{- /* Determine whether a provider is enabled based on `when.enabled` / `when.disabled`. */ -}}
{{- $contextOk := includeTemplate "when/context" (merge (dict "item" .provider) .) | fromJson -}}
{{- $toolOk := includeTemplate "when/check" (dict "item" .provider "key" "tool" "value" .tool) | fromJson -}}
{{- toJson (and $contextOk $toolOk) -}}
