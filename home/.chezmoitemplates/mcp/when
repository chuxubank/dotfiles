{{- /* Determine whether a provider is enabled.
       `when.*.tool` is the consuming agent. `owner` is the tools.yaml switch. */ -}}
{{- $when := includeTemplate "when/evaluate" (dict
      "item" .provider
      "values" (dict
        "device_type" .device_type
        "host_env" .host_env
        "os" .chezmoi.os
        "roles" .roles
        "mem_gb" (dig "mem_gb" 0 .)
        "disk_gb" (dig "disk_gb" 0 .)
        "tool" .tool)
      "os_version" (dig "os_version" "" .)) | fromJson -}}
{{- $owned := includeTemplate "tool/item-enabled" (merge (dict "item" .provider) .) | fromJson -}}
{{- toJson (and $when $owned) -}}
