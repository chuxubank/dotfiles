{{- $envs := dict -}}
{{- $data := . -}}
{{- range $envKey := sortAlpha (keys $data) }}
  {{- $envValue := index $data $envKey -}}
  {{- if eq (kindOf $envValue) "map" }}
    {{- $secret := "" -}}
    {{- if or (not (hasKey $envValue "type")) (eq $envValue.type "pass") }}
        {{- $secret = (includeTemplate "safe/pass" (dict "path" $envValue.path "field" (index $envValue "field") "host_env" $.host_env)) -}}
    {{- else if eq $envValue.type "output" }}
      {{- $secret = (outputList $envValue.cmd $envValue.args) -}}
    {{- end }}
    {{- if and (hasKey $envValue "trim") $envValue.trim }}
      {{- $secret = ($secret | trim) -}}
    {{- end }}
    {{- $_ := set $envs $envKey $secret -}}
  {{- else }}
    {{- $_ := set $envs $envKey $envValue -}}
  {{- end }}
{{- end }}
{{- toJson $envs -}}