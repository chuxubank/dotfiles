{{- /* mcp/envs — Resolve a provider's env map into concrete values.
       Input: dict "envs" <env-map> "host_env" <host-env>
       host_env is context (used for the CI check in safe/pass), NOT an env var,
       so it is passed as a sibling key and never emitted into the output. */ -}}
{{- $envs := dict -}}
{{- $data := .envs -}}
{{- $hostEnv := .host_env -}}
{{- range $envKey := sortAlpha (keys $data) }}
  {{- $envValue := index $data $envKey -}}
  {{- if eq (kindOf $envValue) "map" }}
    {{- $secret := "" -}}
    {{- if or (not (hasKey $envValue "type")) (eq $envValue.type "pass") }}
        {{- $secret = (includeTemplate "safe/pass" (dict "path" $envValue.path "field" (index $envValue "field") "host_env" $hostEnv)) -}}
    {{- else if eq $envValue.type "output" }}
      {{- $secret = (outputList $envValue.cmd $envValue.args) -}}
    {{- end }}
    {{- if and (hasKey $envValue "trim") $envValue.trim }}
      {{- $secret = ($secret | trim) -}}
    {{- end }}
    {{- $_ := set $envs $envKey $secret -}}
  {{- else }}
    {{- $_ := set $envs $envKey $envValue -}}
  {{- end }}
{{- end }}
{{- toJson $envs -}}