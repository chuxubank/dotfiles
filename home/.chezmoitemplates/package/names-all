{{- /* package/names-all — Unique package names on a path, ignoring when/owner
       and ensure. Optional .prefix is prepended (same as package/select).
       Used as the tombstone universe for open-world managers: names that
       are declared but not currently enabled should be removed. */ -}}
{{- $list := .ctx -}}
{{- range (prepend .path "packages") -}}{{- $list = index $list . -}}{{- end -}}
{{- $prefix := dig "prefix" "" . -}}
{{- $names := list -}}
{{- range $package := $list -}}
  {{- $name := $package -}}
  {{- if eq (kindOf $package) "map" -}}
    {{- $name = index $package "name" -}}
  {{- end -}}
  {{- if $name -}}
    {{- $names = append $names (printf "%s%s" $prefix $name) -}}
  {{- end -}}
{{- end -}}
{{- $names | uniq | toJson -}}
