{{- /* package/select — Enabled package names. Optional .prefix is prepended. */ -}}
{{- $selected := list -}}
{{- $prefix := dig "prefix" "" . -}}
{{- $items := includeTemplate "package/items" . | fromJson -}}
{{- range $package := $items -}}
{{- $name := $package -}}
{{- if eq (kindOf $package) "map" -}}
{{- $name = $package.name -}}
{{- end -}}
{{- $selected = append $selected (printf "%s%s" $prefix $name) -}}
{{- end -}}
{{- $selected | toJson -}}
