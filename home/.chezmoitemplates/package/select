{{- $selected := list -}}
{{- $items := includeTemplate "package/items" . | fromJson -}}
{{- range $package := $items -}}
{{- if eq (kindOf $package) "map" -}}
{{- $selected = append $selected $package.name -}}
{{- else -}}
{{- $selected = append $selected $package -}}
{{- end -}}
{{- end -}}
{{- $selected | toJson -}}
