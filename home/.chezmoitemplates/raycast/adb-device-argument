{{- /* raycast/adb-device-argument — Render a Raycast ADB device argument.
       Input: dict "argument" <argument-number>
              ["usbOnly" <bool>] — exclude wireless serials containing ":"
*/ -}}
{{- $devices := includeTemplate "raycast/adb-devices" (dict "usbOnly" (default false (index . "usbOnly"))) | fromJson -}}
{{- includeTemplate "raycast/device-argument" (dict
      "argument" .argument
      "devices" $devices
      "emptyPlaceholder" "Serial (no devices at apply time)"
    ) -}}
