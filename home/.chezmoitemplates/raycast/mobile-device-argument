{{- /* Render a Raycast argument for available mobile devices.
       Input: "argument" <number>
              ["platforms" <list>] — any of android, ios
              ["types" <list>] — any of simulator, usb, wifi
*/ -}}
{{- $platforms := default (list "android" "ios") (index . "platforms") -}}
{{- $types := default (list "simulator" "usb" "wifi") (index . "types") -}}
{{- $helper := joinPath .chezmoi.sourceDir "bin/executable_mobile-device-list" -}}
{{- $devices := output "zsh" "-f" $helper
      "--platforms" (join "," $platforms)
      "--types" (join "," $types)
      "--format" "json" | fromJson -}}
{{- $platformNames := dict "android" "Android" "ios" "iOS" -}}
{{- if $devices -}}
# @raycast.argument{{ .argument }} { "type": "dropdown", "placeholder": "Device", "optional": true, "data": [{{ range $index, $device := $devices }}{{ if $index }}, {{ end }}{"title": {{ printf "%s: %s" (index $platformNames $device.platform) $device.title | toJson }}, "value": {{ printf "%s:%s" $device.kind $device.id | toJson }}}{{ end }}] }
{{- else -}}
# @raycast.argument{{ .argument }} { "type": "text", "placeholder": "Device type and identifier", "optional": true }
{{- end }}
