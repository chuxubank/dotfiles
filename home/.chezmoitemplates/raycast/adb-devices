{{- /* raycast/adb-devices — Return available ADB devices as JSON.
       Input: ["types" <list>] — any of simulator, usb, wifi
              ["titlePrefix" <text>]
              ["valuePrefix" <text>]
*/ -}}
{{- $types := default (list "simulator" "usb" "wifi") (index . "types") -}}
{{- $titlePrefix := default "" (index . "titlePrefix") -}}
{{- $valuePrefix := default "" (index . "valuePrefix") -}}
{{- $devices := list -}}
{{- $helper := joinPath .chezmoi.sourceDir "bin/executable_mobile-device-list" -}}
{{- $output := output "zsh" "-f" $helper "--platforms" "android" "--types" (join "," $types) "--format" "json" | fromJson -}}
{{- range $device := $output -}}
  {{- $devices = append $devices (dict
        "title" (printf "%s%s" $titlePrefix $device.title)
        "value" (printf "%s%s" $valuePrefix $device.id)
      ) -}}
  {{- end -}}
{{- $devices | toJson -}}
