{{- /* raycast/ios-devices — Return available iOS devices as JSON.
       Input: ["titlePrefix" <text>]
*/ -}}
{{- $titlePrefix := default "" (index . "titlePrefix") -}}
{{- $devices := list -}}
{{- if lookPath "xcrun" -}}
  {{- $simulatorOutput := output "xcrun" "simctl" "list" "devices" "booted" "--json" | fromJson -}}
  {{- range $runtime, $runtimeDevices := $simulatorOutput.devices -}}
    {{- if contains ".iOS-" $runtime -}}
      {{- range $device := $runtimeDevices -}}
        {{- if and $device.isAvailable (eq $device.state "Booted") -}}
          {{- $devices = append $devices (dict
                "title" (printf "%s%s (Simulator)" $titlePrefix $device.name)
                "value" (printf "simulator:%s" $device.udid)
              ) -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}

  {{- $physicalJSON := output "sh" "-c" `json_file=$(mktemp); trap 'rm -f "$json_file"' EXIT; if xcrun devicectl list devices --quiet --json-output "$json_file" >/dev/null 2>&1; then cat "$json_file"; else printf '{"result":{"devices":[]}}'; fi` -}}
  {{- $physicalOutput := $physicalJSON | fromJson -}}
  {{- range $device := $physicalOutput.result.devices -}}
    {{- if and
          (eq $device.hardwareProperties.platform "iOS")
          (eq $device.hardwareProperties.reality "physical")
          (eq $device.connectionProperties.tunnelState "connected")
    -}}
      {{- $transport := "USB" -}}
      {{- $kind := "device-usb" -}}
      {{- if eq $device.connectionProperties.transportType "localNetwork" -}}
        {{- $transport = "Network" -}}
        {{- $kind = "device-network" -}}
      {{- end -}}
      {{- $devices = append $devices (dict
            "title" (printf "%s%s (%s, %s)" $titlePrefix $device.deviceProperties.name $device.hardwareProperties.marketingName $transport)
            "value" (printf "%s:%s" $kind $device.hardwareProperties.udid)
          ) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $devices | toJson -}}
