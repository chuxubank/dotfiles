{{- $taps := includeTemplate "package/items" (dict "ctx" . "path" (list "darwin" "taps")) | fromJson -}}
{{ range $tap := $taps -}}
{{ if eq (kindOf $tap) "map" -}}
tap {{ $tap.name | quote }}
{{ else -}}
tap {{ $tap | quote }}
{{ end -}}
{{ end -}}
{{- $brews := includeTemplate "package/items" (dict "ctx" . "path" (list "darwin" "brews")) | fromJson -}}
{{ range $brew := $brews -}}
{{ if eq (kindOf $brew) "map" -}}
brew {{ $brew.name | quote }}
{{- range $key, $value := $brew -}}
{{- if eq $key "link" }}, link: {{ $value }}{{ end -}}
{{- if eq $key "restart_service" }}, restart_service: {{ $value }}{{ end -}}
{{- if eq $key "args" }}, args: {{ $value | toJson }}{{ end -}}
{{- end }}
{{ else -}}
brew {{ $brew | quote }}
{{ end -}}
{{ end -}}
{{- $casks := includeTemplate "package/items" (dict "ctx" . "path" (list "darwin" "casks")) | fromJson -}}
{{ range $cask := $casks -}}
{{ if eq (kindOf $cask) "map" -}}
cask {{ $cask.name | quote }}
{{- range $key, $value := $cask -}}
{{- if eq $key "args" }}, args: {{ $value | toJson }}{{ end -}}
{{- end }}
{{ else -}}
cask {{ $cask | quote }}
{{ end -}}
{{ end -}}
{{- $masApps := includeTemplate "package/items" (dict "ctx" . "path" (list "darwin" "mas")) | fromJson -}}
{{ range $app := $masApps -}}
mas {{ $app.name | quote }}, id: {{ $app.id }}
{{ end -}}
