{{ range .packages.darwin.taps -}}
{{ if eq (kindOf .) "map" -}}
{{- $enabled := true -}}
{{- if hasKey . "when" -}}
  {{- $hostEnvOk := includeTemplate "when/check" (dict "item" . "key" "host_env" "value" $.host_env) | fromJson -}}
  {{- $deviceTypeOk := includeTemplate "when/check" (dict "item" . "key" "device_type" "value" $.device_type) | fromJson -}}
  {{- $rolesOk := includeTemplate "when/check" (dict "item" . "key" "roles" "value" $.roles) | fromJson -}}
  {{- $enabled = and $hostEnvOk $deviceTypeOk $rolesOk -}}
{{- end -}}
{{ if $enabled -}}
tap {{ .name | quote }}
{{ end -}}
{{ else -}}
tap {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range .packages.darwin.brews -}}
{{ if eq (kindOf .) "map" -}}
{{- $enabled := true -}}
{{- if hasKey . "when" -}}
  {{- $hostEnvOk := includeTemplate "when/check" (dict "item" . "key" "host_env" "value" $.host_env) | fromJson -}}
  {{- $deviceTypeOk := includeTemplate "when/check" (dict "item" . "key" "device_type" "value" $.device_type) | fromJson -}}
  {{- $rolesOk := includeTemplate "when/check" (dict "item" . "key" "roles" "value" $.roles) | fromJson -}}
  {{- $enabled = and $hostEnvOk $deviceTypeOk $rolesOk -}}
{{- end -}}
{{ if $enabled -}}
brew {{ .name | quote }}
{{- range $key, $value := . -}}
{{- if eq $key "link" }}, link: {{ $value }}{{ end -}}
{{- if eq $key "restart_service" }}, restart_service: {{ $value }}{{ end -}}
{{- if eq $key "args" }}, args: {{ $value | toJson }}{{ end -}}
{{ end }}
{{ end -}}
{{ else -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
