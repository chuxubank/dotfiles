{{ range .packages.darwin.taps -}}
{{ if eq (kindOf .) "map" -}}
{{- $enabled := true -}}
{{- if hasKey . "when" -}}
  {{- $enabled = includeTemplate "when/context" (merge (dict "item" .) $) | fromJson -}}
{{- end -}}
{{ if $enabled -}}
tap {{ .name | quote }}
{{ end -}}
{{ else -}}
tap {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range .packages.darwin.brews -}}
{{ if eq (kindOf .) "map" -}}
{{- $enabled := true -}}
{{- if hasKey . "when" -}}
  {{- $enabled = includeTemplate "when/context" (merge (dict "item" .) $) | fromJson -}}
{{- end -}}
{{ if $enabled -}}
brew {{ .name | quote }}
{{- range $key, $value := . -}}
{{- if eq $key "link" }}, link: {{ $value }}{{ end -}}
{{- if eq $key "restart_service" }}, restart_service: {{ $value }}{{ end -}}
{{- if eq $key "args" }}, args: {{ $value | toJson }}{{ end -}}
{{ end }}
{{ end -}}
{{ else -}}
brew {{ . | quote }}
{{ end -}}
{{ end -}}
