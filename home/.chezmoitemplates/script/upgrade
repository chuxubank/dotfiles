# Check the selected executable, not just whether the formula is installed:
# a standalone copy can shadow Homebrew's symlink on PATH.
is_homebrew_binary() {
  local binary cellar
  binary=$(command -v "$1") || return 1
  command -v brew >/dev/null || return 1
  cellar=$(brew --cellar 2>/dev/null) || return 1
  [[ -n $cellar && ${binary:A} == "${cellar:A}/"* ]]
}

# Report a failed upgrade and keep going. A non-zero run_onchange script is
# retried on every apply and blocks every later script. The week stamp in
# each upgrade script runs it again when the week changes.
run_upgrade() {
  local label=$1
  shift
  echo "Upgrade $label"
  if ! "$@"; then
    print -u2 -- "Could not upgrade $label"
  fi
}

# Toolchain self-upgrades can fail because the install method refuses them
# or the download endpoint returns 403.
run_upgrade_optional() {
  local label=$1
  shift
  echo "Upgrade $label"
  if ! "$@"; then
    print -u2 -- "Could not upgrade $label; continuing"
  fi
}

finish_upgrades() {
  return 0
}
