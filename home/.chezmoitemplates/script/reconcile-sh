{{- /* script/reconcile-sh — POSIX helpers for open-world package managers
       (apt, pacman, termux). Brew already owns cleanup via brew bundle.

       Removals are the union of:
         - names in the last apply state that are no longer desired
           (a line was deleted from source)
         - names declared in source but not currently enabled
           (`when` failed, tool off, or `ensure = "absent"`)

         stale_managed STATE_FILE
           Desired names on stdin. Prints previous state names not desired.

         not_in_list KEEP
           Names on stdin that do not appear in KEEP (newline-separated).

         write_managed_state STATE_FILE
           Writes stdin (desired names) to STATE_FILE. */ -}}
stale_managed() {
	_state=$1
	_desired=$(cat)
	if [ ! -f "$_state" ]; then
		return 0
	fi
	while IFS= read -r _pkg || [ -n "$_pkg" ]; do
		[ -z "$_pkg" ] && continue
		if printf '%s\n' "$_desired" | grep -Fxq "$_pkg"; then
			continue
		fi
		printf '%s\n' "$_pkg"
	done <"$_state"
}

not_in_list() {
	_keep=$1
	while IFS= read -r _pkg || [ -n "$_pkg" ]; do
		[ -z "$_pkg" ] && continue
		if printf '%s\n' "$_keep" | grep -Fxq "$_pkg"; then
			continue
		fi
		printf '%s\n' "$_pkg"
	done
}

write_managed_state() {
	_state=$1
	_dir=$(dirname "$_state")
	mkdir -p "$_dir"
	cat >"$_state"
}

