{{- /* script/rust-env — export CARGO_HOME, RUSTUP_HOME, and cargo bin PATH
       from environment.static. Forward slashes so sh/zsh on Windows/MSYS2
       do not treat backslashes as escapes. */ -}}
{{- $cargoHome := "" -}}
{{- $rustupHome := "" -}}
{{- $cargoBin := "" -}}
{{- range $tool := .environment.static -}}
{{- if eq $tool.tool "rust" -}}
{{- $cargoHome = includeTemplate "environment/value" (dict "ctx" $ "item" $tool.variables.CARGO_HOME) -}}
{{- $rustupHome = includeTemplate "environment/value" (dict "ctx" $ "item" $tool.variables.RUSTUP_HOME) -}}
{{- range $p := $tool.path -}}
{{- $cargoBin = includeTemplate "environment/value" (dict "ctx" $ "item" $p) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if or (eq $cargoHome "") (eq $rustupHome "") (eq $cargoBin "") -}}
{{- fail "rust CARGO_HOME, RUSTUP_HOME, or cargo bin path missing from environment.static" -}}
{{- end -}}
export CARGO_HOME={{ $cargoHome | replace "\\" "/" | quote }}
export RUSTUP_HOME={{ $rustupHome | replace "\\" "/" | quote }}
export PATH={{ $cargoBin | replace "\\" "/" | quote }}:$PATH
