{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM provider policy (not the complete model catalog schema)",
  "type": "object",
  "properties": {
    "llm": {
      "type": "object",
      "properties": {
        "default_providers": { "$ref": "#/$defs/providerRefs" },
        "default_provider_sets": { "$ref": "#/$defs/providerSets" },
        "compaction": { "$ref": "#/$defs/compaction" },
        "model_floors": { "$ref": "#/$defs/modelFloors" },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "api_types": { "$ref": "#/$defs/protocols" } }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/tool" },
          "patternProperties": {
            "^(pi|omp|hermes|opencode)$": {
              "allOf": [
                { "$ref": "#/$defs/tool" },
                { "properties": { "providers": { "$ref": "#/$defs/providers" } } }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "modelFloors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stem", "min"],
        "properties": {
          "stem": { "type": "string", "minLength": 1 },
          "min": { "type": "string", "pattern": "^[1-9](\\.[0-9])?$" },
          "seps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": [".", "-"] }
          }
        }
      }
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thresholds"],
      "properties": {
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["match"],
            "properties": {
              "match": { "type": "string", "pattern": "^\\*\\*/(\\$\\{[a-z][a-z0-9_]*\\}|[A-Za-z0-9][A-Za-z0-9._-]*)\\*$" },
              "percent": { "type": "integer", "minimum": 1, "maximum": 99 },
              "reserve_tokens": { "type": "integer", "minimum": 1 }
            },
            "oneOf": [
              { "required": ["percent"], "not": { "required": ["reserve_tokens"] } },
              { "required": ["reserve_tokens"], "not": { "required": ["percent"] } }
            ]
          }
        }
      }
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["openai-completions", "openai-responses", "anthropic-messages", "google-generative-ai", "ollama", "opencode"] }
    },
    "tool": {
      "type": "object",
      "properties": {
        "providers": { "$ref": "#/$defs/providerRefs" },
        "provider_sets": { "$ref": "#/$defs/providerSets" },
        "supported_provider_types": { "$ref": "#/$defs/protocols" },
        "exclude_providers": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "providerSets": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "providerRefs": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": { "provider": { "type": "string" } }
          }
        }
      ]
    },
    "providers": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string", "not": { "const": "openrouter" } }
        },
        {
          "type": "object",
          "propertyNames": { "not": { "const": "openrouter" } },
          "additionalProperties": {
            "type": "object",
            "properties": { "provider": { "type": "string", "not": { "const": "openrouter" } } }
          }
        }
      ]
    }
  }
}
